{
  "name": "aifoundation-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --bun ./node_modules/.bin/astro dev",
    "start": "bun --bun ./node_modules/.bin/astro dev",
    "build": "bun run scripts/sync-model-retirement.mjs && bun run scripts/generate-llms-txt.mjs && bun --bun ./node_modules/.bin/astro build",
    "llms": "bun run scripts/sync-model-retirement.mjs && bun run scripts/generate-llms-txt.mjs",
    "datasheet": "bun run scripts/fetch-model-parameters.mjs",
    "preview": "bun --bun ./node_modules/.bin/astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/starlight": "^0.38.2",
    "astro": "^6.0.1",
    "flag-icons": "^7.5.0",
    "sharp": "^0.34.2",
    "starlight-versions": "^0.8.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
