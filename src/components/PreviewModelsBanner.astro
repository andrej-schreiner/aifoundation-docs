---
// Site-wide announcement bars — currently the API transition notice (linking
// to /api-transition) above d3 joining the Test / preview catalog as the
// recommended decision model, with image input on /decisions.
// It replaced the DiffusionGemma 26B A4B preview bar, which replaced the
// GLM 5.3 Flash / Qwen 3.8 27B FP8 production bar. Rendered from
// Footer.astro so it appears on every page (there are no splash pages, so the
// Footer override is truly global).
//
// Named generically (it was QwenPreviewBanner) because the copy is swapped
// whenever the preview catalog changes. Bars stack in the order of the
// `bars` array below; each one is dismissed on its own. It replaced the GA bar (Mistral Small 4 / Gemma 4), which in turn
// replaced GlmBanner.
//
// Kept deliberately compact: a slim single-line bar rendered in the content
// flow above the page title (portaled into <main> by the script below), so it
// never covers content and scrolls away with the page.
//
// Dismiss semantics are unchanged: this site navigates via full page loads, so
// the closed state lives in sessionStorage (survives navigation between docs
// pages). A hard reload clears it (detected via PerformanceNavigationTiming
// "reload"), and a new tab starts a fresh session — so the announcement
// returns. Each bar has its own storage key, and the key changes with each
// announcement, so visitors who dismissed the previous one still see this one.

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';
const close = isDE ? 'Ankündigung schließen' : 'Dismiss announcement';

const bars = isDE
  ? [
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Hinweis',
        msg: 'Wir nehmen einige <b>Änderungen an der API</b> vor. Prüfen Sie, was sich ändert und was Sie tun müssen.',
        cta: 'Zur API-Umstellung',
        href: `${prefix}/api-transition`,
      },
      {
        key: 'd3PreviewBannerDismissed',
        badge: 'Neu',
        msg: '<b>d3</b> ist jetzt als Preview verfügbar — das empfohlene Modell für Decisions, jetzt auch mit Bildern. Kostenlos testbar.',
        cta: 'Preview testen',
        href: `${prefix}/plans/test`,
      },
    ]
  : [
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Notice',
        msg: 'We are making a few <b>API changes</b>. See what changes and what you need to do.',
        cta: 'View API changes',
        href: `${prefix}/api-transition`,
      },
      {
        key: 'd3PreviewBannerDismissed',
        badge: 'New',
        msg: '<b>d3</b> is now in preview — the recommended model for decisions, now with image input. Free to try.',
        cta: 'Try the preview',
        href: `${prefix}/plans/test`,
      },
    ];
---

{bars.map((b) => (
  <div class="qp-bar" data-key={b.key} role="region" aria-label={close} hidden>
    <span class="qp-badge">{b.badge}</span>
    <p class="qp-msg" set:html={b.msg}></p>
    <a class="qp-cta" href={b.href}>{b.cta}</a>
    <button type="button" class="qp-close" aria-label={close}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
))}

<style>
  .qp-bar {
    /* In-flow (not fixed): the bar occupies real layout space above the page
       title, so it can never cover content, and it scrolls away with the
       page. See the portal logic in the script below. */
    position: relative;
    z-index: 1;

    display: flex;
    align-items: center;
    gap: 0.625rem;
    /* Left-aligned like the rest of the content column (margin:auto centering
       was a relic of the old fixed centered pill). */
    width: min(46rem, 100%);
    margin: 0 0 0.25rem;
    padding: 0.5rem 0.75rem;

    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-accent);
    border-radius: 10px;
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
    font-size: var(--sl-text-xs);
    line-height: 1.35;

    animation: gaSlideIn 0.32s cubic-bezier(0.2, 0.9, 0.25, 1.1);
  }
  .qp-bar[hidden] {
    display: none;
  }

  .qp-badge {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .qp-msg {
    flex: 1 1 auto;
    margin: 0;
    color: var(--sl-color-text);
  }
  .qp-msg :global(b) {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .qp-cta {
    flex-shrink: 0;
    padding: 0.3125rem 0.75rem;
    border-radius: 7px;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .qp-cta:hover,
  .qp-cta:focus-visible {
    background: var(--sl-color-accent-high);
  }

  .qp-close {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    transition: background 0.15s;
  }
  .qp-close:hover,
  .qp-close:focus-visible {
    background: var(--sl-color-gray-5);
  }
  .qp-close svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .qp-bar :focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* On narrow viewports drop the badge and let the message + CTA wrap. */
  @media (max-width: 30rem) {
    .qp-bar {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .qp-badge {
      display: none;
    }
    .qp-msg {
      flex-basis: 100%;
      order: 1;
    }
    .qp-cta {
      order: 2;
    }
    .qp-close {
      order: 3;
      margin-left: auto;
    }
  }

  @keyframes gaSlideIn {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qp-bar {
      animation: none;
    }
  }
</style>

<script>
  // Dismiss-semantics rationale: see the component frontmatter.
  let reloadHandled = false;

  function isDismissed(key: string) {
    try {
      return sessionStorage.getItem(key) === '1';
    } catch {
      return false;
    }
  }

  // Clear the dismissals on a hard reload so the announcements return on refresh.
  function clearOnReload(keys: string[]) {
    if (reloadHandled) return;
    reloadHandled = true;
    const nav = performance.getEntriesByType('navigation')[0] as
      | PerformanceNavigationTiming
      | undefined;
    const isReload = nav ? nav.type === 'reload' : (performance as any).navigation?.type === 1;
    if (isReload) {
      try {
        keys.forEach((key) => sessionStorage.removeItem(key));
      } catch {}
    }
  }

  function dismiss(bar: HTMLElement) {
    try {
      sessionStorage.setItem(bar.dataset.key!, '1');
    } catch {}
    bar.remove();
  }

  function initPreviewModelsBanner() {
    const all = Array.from(document.querySelectorAll<HTMLElement>('.qp-bar[data-key]'));
    clearOnReload(all.map((bar) => bar.dataset.key!));

    const bars = all.filter((bar) => {
      if (isDismissed(bar.dataset.key!)) {
        bar.remove();
        return false;
      }
      return true;
    });
    if (!bars.length) return;

    // Portal into the title panel, above the <h1>, so the bars sit in the
    // content flow — they occupy real space (nothing is ever covered) and
    // scroll away with the page. Inside the panel (rather than above it) the
    // panel's own padding stays above the bars instead of stacking into the
    // bar-to-title gap.
    // Target the .sl-container INSIDE the panel (not the panel itself): the
    // container carries Starlight's max-width + centering, so the bars get the
    // exact same left edge as the <h1> at every viewport width.
    const host =
      document.querySelector('main .content-panel .sl-container') ||
      document.querySelector('main .content-panel') ||
      document.querySelector('main');
    if (host && bars[0].parentElement !== host) {
      host.prepend(...bars);
    }

    for (const bar of bars) {
      bar.hidden = false;
      bar.querySelector('.qp-close')?.addEventListener('click', () => dismiss(bar));
    }

    // Escape dismisses the topmost visible bar.
    if (!(window as any).__previewModelsBannerEscBound) {
      (window as any).__previewModelsBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const el = document.querySelector<HTMLElement>('.qp-bar[data-key]:not([hidden])');
        if (el) dismiss(el);
      });
    }
  }

  document.addEventListener('astro:page-load', initPreviewModelsBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreviewModelsBanner);
  } else {
    initPreviewModelsBanner();
  }
</script>
