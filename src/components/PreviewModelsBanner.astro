---
// Site-wide announcement bars — currently the API transition notice (linking
// to /api-transition) above the two OCR preview models, LightOnOCR-3-4B and
// PaddleOCR-VL-1.6 (linking to /guides/ocr).
// It replaced the Qwen3 Embedding 8B bar, which replaced the d3 preview bar,
// which replaced the DiffusionGemma 26B A4B
// preview bar, which replaced the
// GLM 5.3 Flash / Qwen 3.8 27B FP8 production bar. Rendered from
// Footer.astro so it appears on every page (there are no splash pages, so the
// Footer override is truly global).
//
// Named generically (it was QwenPreviewBanner) because the copy is swapped
// whenever the preview catalog changes. The announcements share one box, a
// row each (tag, text, link) in the order of the `bars` array below, with
// one close control for the box. It replaced the GA bar (Mistral Small 4 / Gemma 4), which in turn
// replaced GlmBanner.
//
// Kept deliberately compact: one box in its own row above the content sheet,
// outside it (portaled into .qp-stack by the script below; the row and the
// box's alignment with the content column are in layout.css), so it never
// covers content and scrolls away with the page.
//
// Dismiss semantics are unchanged: this site navigates via full page loads, so
// the closed state lives in sessionStorage (survives navigation between docs
// pages). A hard reload clears it (detected via PerformanceNavigationTiming
// "reload"), and a new tab starts a fresh session — so the announcement
// returns. Each announcement has its own storage key (closing the box stores
// the keys of the rows it shows), and the key changes with each announcement,
// so visitors who dismissed the previous one still see this one.

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';
const label = isDE ? 'Ankündigungen' : 'Announcements';
const close = isDE ? 'Ankündigungen schließen' : 'Dismiss announcements';

const bars = isDE
  ? [
      {
        key: 'glm53DeepseekLaunchDismissed',
        badge: 'Neu',
        msg: '<b>GLM 5.3</b> (T-Cloud) und <b>DeepSeek 4.1 Flash</b> (T-Cloud, Vorschau) ab 2.\u00a0Nov.',
        cta: 'Modelle ansehen',
        href: `${prefix}/models/llms`,
      },
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Hinweis',
        msg: 'Wir nehmen einige <b>Änderungen an der API</b> vor. Prüfen Sie, was sich ändert und was Sie tun müssen.',
        cta: 'Zur API-Umstellung',
        href: `${prefix}/api-transition`,
      },
    ]
  : [
      {
        key: 'glm53DeepseekLaunchDismissed',
        badge: 'New',
        msg: '<b>GLM 5.3</b> (T-Cloud) and <b>DeepSeek 4.1 Flash</b> (T-Cloud, preview) from 2\u00a0Nov',
        cta: 'View models',
        href: `${prefix}/models/llms`,
      },
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Notice',
        msg: 'We are making a few <b>API changes</b>. See what changes and what you need to do.',
        cta: 'View API changes',
        href: `${prefix}/api-transition`,
      },
    ];
import Button from './Button.astro';
import Tag from './Tag.astro';
import Icon from './Icon.astro';
---

{bars.length > 0 && (
  <div class="qp-box" role="region" aria-label={label} hidden>
    <ul class="qp-rows">
      {bars.map((b) => (
        <li class="qp-bar" data-key={b.key}>
          <Tag color="magenta" size="small" class="qp-badge">{b.badge}</Tag>
          <p class="qp-msg" set:html={b.msg}></p>
          <a class="qp-cta" href={b.href}>{b.cta}</a>
        </li>
      ))}
    </ul>
    <Button variant="ghost" size="small" iconOnly class="qp-close" ariaLabel={close}>
      <Icon name="action-close" size={16} />
    </Button>
  </div>
)}

<style>
  /* One box for every announcement: a row each, the close control at the
     end of the first row. The rows share the box's columns (subgrid), so
     the texts start at one line after tags of different widths. */
  .qp-box {
    /* In-flow (not fixed): the box occupies real layout space above the page
       title, so it can never cover content, and it scrolls away with the
       page. See the portal logic in the script below. */
    position: relative;
    z-index: 1;
    box-sizing: border-box;

    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content max-content;
    align-items: start;
    column-gap: var(--aifs-notice-gap);
    margin: 0;
    padding: var(--aifs-notice-padding-y) var(--aifs-notice-padding-x);

    background: var(--aifs-color-surface-chrome);
    color: var(--aifs-color-text-body);
    border: var(--aifs-border-width-standard) solid var(--aifs-color-border-subtle);
    border-inline-start: var(--aifs-border-width-indicator) solid var(--aifs-color-action-background);
    border-radius: var(--aifs-notice-radius);
    box-shadow: none;
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);

    animation: gaSlideIn 0.32s cubic-bezier(0.2, 0.9, 0.25, 1.1);
  }

  .qp-box[hidden] {
    display: none;
  }

  .qp-rows {
    display: grid;
    grid-column: 1 / 4;
    grid-template-columns: subgrid;
    row-gap: var(--aifs-notice-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .qp-bar {
    display: grid;
    grid-column: 1 / 4;
    grid-template-columns: subgrid;
    align-items: center;
    /* The row is as tall as the close control, so one-line rows read
       centred beside it. */
    min-height: var(--aifs-button-min-height-small);
    margin: 0;
  }

  .qp-bar + .qp-bar {
    margin-top: 0;
  }

  /* Drawn by the Tag component (magenta, small). */
  .qp-bar :global(.qp-badge) {
    justify-self: start;
  }

  .qp-msg {
    min-width: 0;
    margin: 0;
    color: var(--aifs-color-text-body);
  }

  .qp-msg :global(b) {
    color: var(--aifs-color-brand-text);
    font-weight: 600;
  }

  .qp-cta {
    color: var(--aifs-color-link-standard);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: var(--aifs-radius-indicator);
    white-space: nowrap;
  }

  .qp-cta:hover,
  .qp-cta:focus-visible {
    color: var(--aifs-color-text-body);
  }

  /* Drawn by the Button component (ghost, small, icon only). */
  .qp-box :global(.qp-close) {
    grid-column: 4;
    grid-row: 1;
    border-radius: var(--aifs-notice-close-radius);
  }

  .qp-box :focus-visible {
    outline: var(--aifs-button-focus-width) solid var(--aifs-color-focus);
    outline-offset: var(--aifs-button-focus-width);
  }

  /* Narrow boxes: the link goes under its text; the close control keeps
     the end of the first row. */
  @container qpstack (max-width: 40rem) {
    .qp-box {
      grid-template-columns: max-content minmax(0, 1fr) max-content;
      padding: var(--aifs-notice-padding-y-compact) var(--aifs-notice-padding-x-compact);
    }

    .qp-rows {
      grid-column: 1 / 3;
    }

    .qp-bar {
      grid-column: 1 / 3;
      grid-template-rows: auto auto;
      row-gap: var(--aifs-notice-row-gap-compact);
      align-items: start;
      padding-block: var(--aifs-notice-padding-y-compact);
    }

    .qp-bar :global(.qp-badge) {
      grid-row: 1 / 3;
    }

    .qp-msg,
    .qp-cta {
      grid-column: 2;
      justify-self: start;
    }

    .qp-box :global(.qp-close) {
      grid-column: 3;
    }
  }

  @keyframes gaSlideIn {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qp-box {
      animation: none;
    }
  }
</style>

<script>
  // Dismiss-semantics rationale: see the component frontmatter.
  let reloadHandled = false;

  function isDismissed(key: string) {
    try {
      return sessionStorage.getItem(key) === '1';
    } catch {
      return false;
    }
  }

  // Clear the dismissals on a hard reload so the announcements return on refresh.
  function clearOnReload(keys: string[]) {
    if (reloadHandled) return;
    reloadHandled = true;
    const nav = performance.getEntriesByType('navigation')[0] as
      | PerformanceNavigationTiming
      | undefined;
    const isReload = nav ? nav.type === 'reload' : (performance as any).navigation?.type === 1;
    if (isReload) {
      try {
        keys.forEach((key) => sessionStorage.removeItem(key));
      } catch {}
    }
  }

  // Closing the box dismisses every announcement it shows.
  function dismiss(box: HTMLElement) {
    try {
      box.querySelectorAll<HTMLElement>('.qp-bar[data-key]').forEach((bar) => sessionStorage.setItem(bar.dataset.key!, '1'));
    } catch {}
    const stack = box.parentElement;
    box.remove();
    // The box gone: drop the row, so its spacing goes too.
    if (stack?.classList.contains('qp-stack')) stack.remove();
  }

  function initPreviewModelsBanner() {
    const box = document.querySelector<HTMLElement>('.qp-box');
    if (!box) return;
    const all = Array.from(box.querySelectorAll<HTMLElement>('.qp-bar[data-key]'));
    clearOnReload(all.map((bar) => bar.dataset.key!));

    const bars = all.filter((bar) => {
      if (isDismissed(bar.dataset.key!)) {
        bar.remove();
        return false;
      }
      return true;
    });
    if (!bars.length) {
      box.remove();
      return;
    }

    // Portal to just above the sheet, the row around the table of contents
    // and the content: the announcements are about the site, not the page,
    // so they sit on the frame, lined up with the content column
    // (layout.css). They stay in flow, take real space, and scroll away with
    // the page.
    let host = document.querySelector<HTMLElement>('.qp-stack');
    const sheet = document.querySelector('.main-pane')?.parentElement;
    if (!host) {
      host = document.createElement('div');
      host.className = 'qp-stack';
      sheet?.before(host);
    } else if (sheet && host.nextElementSibling !== sheet) {
      sheet.before(host);
    }
    if (box.parentElement !== host) host.append(box);

    box.hidden = false;
    if (box.dataset.bound !== '1') {
      box.dataset.bound = '1';
      box.querySelector('.qp-close')?.addEventListener('click', () => dismiss(box));
    }

    // Escape closes the box only while focus is inside it: elsewhere the
    // key belongs to whatever is open (a dialog, search, a filter menu).
    if (!(window as any).__previewModelsBannerEscBound) {
      (window as any).__previewModelsBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || e.defaultPrevented) return;
        const el = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('.qp-box:not([hidden])');
        if (el) dismiss(el);
      });
    }
  }

  document.addEventListener('astro:page-load', initPreviewModelsBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreviewModelsBanner);
  } else {
    initPreviewModelsBanner();
  }
</script>
