---
// Site-wide announcement banners — currently NVIDIA Nemotron 3.5 Embedding 8B
// and GLM 5.3 live on the paid plans together with the DeepSeek V4.1 Flash
// preview (New models) first, then the API transition notice (API changes,
// linking to /api-transition). Two banners at most: telekom main's separate
// Nemotron, GLM 5.3 and DeepSeek bars are merged into the first, which lists
// them one per line.
// It replaced the GLM 5.3 / DeepSeek bar, which replaced the GLM 5.3 / DeepSeek launch bar, which replaced the Qwen3 Embedding 8B bar, which replaced the d3 preview bar,
// which replaced the DiffusionGemma 26B A4B
// preview bar, which replaced the
// GLM 5.3 Flash / Qwen 3.8 27B FP8 production bar. Rendered from
// Footer.astro so it appears on every page (there are no splash pages, so the
// Footer override is truly global).
//
// Named generically (it was QwenPreviewBanner) because the copy is swapped
// whenever the preview catalog changes. Each announcement is its own banner
// (icon, text, link, close button) in the order of the `bars` array below.
// They are a lighter take on Scale's inline notification, in the style of
// the asides: a Telekom icon in the informational colour, the text in the
// body colour, no accent line, no tag. New models: a soft informational
// tint, a bold lead, a short list (`items`, one line per model or group)
// and a closing line with the link. Notice: lower emphasis, the sheet
// colour with a subtle outline, one line of text and its link. Not Scale's
// notification banner (a full-colour strip): GAPS.md row 20.
//
// Placed at the top of the content column, on the sheet (portaled there by
// the script below; the spacing is in layout.css), so the banners have the
// column's edges and width at every window width, never cover content and
// scroll away with the page.
//
// Dismiss semantics: this site navigates via full page loads, so a closed
// banner is remembered in sessionStorage (survives navigation between docs
// pages). A hard reload clears it (detected via PerformanceNavigationTiming
// "reload"), and a new tab starts a fresh session, so the banner returns.
// Each banner has its own close button and storage key, and the key changes
// with each announcement (or redesign), so visitors who dismissed the
// previous one still see this one. After a close, focus moves to the
// remaining banner's close button, or to the page title when none is left.

interface Bar {
  key: string;
  kind: 'new' | 'notice';
  icon: string;
  label: string;
  close: string;
  lead?: string;
  items?: string[];
  msg: string;
  cta: string;
  href: string;
}

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';

const bars: Bar[] = isDE
  ? [
      {
        key: 'newModelsNemotronGlm53DeepseekDismissed',
        kind: 'new',
        icon: 'content-news',
        label: 'Neue Modelle',
        close: 'Hinweis zu neuen Modellen schließen',
        lead: 'Neue Modelle',
        items: [
          '<b>NVIDIA Nemotron 3.5 Embedding 8B</b>: mehrsprachige Embeddings mit 32K Kontextfenster, in allen kostenpflichtigen Tarifen',
          '<b>GLM 5.3</b> von Z.ai: für Coding und agentische Aufgaben, in allen kostenpflichtigen Tarifen',
          '<b>DeepSeek V4.1 Flash</b>: neu in der Vorschau und kostenlos testbar',
        ],
        msg: 'Alle gehostet in Deutschland (<span class="nowrap">T-Cloud</span>).',
        cta: 'Modelle ansehen',
        href: `${prefix}/models`,
      },
      {
        key: 'apiTransitionNoticeDismissed',
        kind: 'notice',
        icon: 'alert-information',
        label: 'API-Änderungen',
        close: 'Hinweis zur API-Umstellung schließen',
        msg: 'Wir nehmen einige <b>Änderungen an der API</b> vor. Prüfen Sie, was sich ändert und was Sie tun müssen.',
        cta: 'Zur API-Umstellung',
        href: `${prefix}/api-transition`,
      },
    ]
  : [
      {
        key: 'newModelsNemotronGlm53DeepseekDismissed',
        kind: 'new',
        icon: 'content-news',
        label: 'New models',
        close: 'Dismiss new models announcement',
        lead: 'New models',
        items: [
          '<b>NVIDIA Nemotron 3.5 Embedding 8B</b>: multilingual embeddings with a 32K context window, on all paid plans',
          '<b>GLM 5.3</b> from Z.ai: for coding and agentic tasks, on all paid plans',
          '<b>DeepSeek V4.1 Flash</b>: new in preview and free to try',
        ],
        msg: 'All hosted in Germany (<span class="nowrap">T-Cloud</span>).',
        cta: 'View models',
        href: `${prefix}/models`,
      },
      {
        key: 'apiTransitionNoticeDismissed',
        kind: 'notice',
        icon: 'alert-information',
        label: 'API changes',
        close: 'Dismiss API changes notice',
        msg: 'We are making a few <b>API changes</b>. See what changes and what you need to do.',
        cta: 'View API changes',
        href: `${prefix}/api-transition`,
      },
    ];
import Button from './Button.astro';
import Icon from './Icon.astro';
---

{bars.map((b) => (
  <div class={`qp-bar qp-bar--${b.kind}`} data-key={b.key} data-pagefind-ignore role="region" aria-label={b.label} hidden>
    <span class="qp-icon"><Icon name={b.icon} size={20} /></span>
    <div class="qp-body">
      {b.lead && <p class="qp-lead">{b.lead}</p>}
      {b.items && (
        <ul class="qp-list">
          {b.items.map((item) => <li set:html={item} />)}
        </ul>
      )}
      <p class="qp-msg">
        <span set:html={b.msg} />{' '}<a class="qp-cta" href={b.href}>{b.cta}</a>
      </p>
    </div>
    <Button variant="ghost" size="small" iconOnly class="qp-close" ariaLabel={b.close}>
      <Icon name="action-close" size={16} />
    </Button>
  </div>
))}

<style>
  /* One banner per announcement: icon, text, close button. A lighter take
     on Scale's inline notification, as the asides are: no accent line, no
     shadow. New models in a soft informational tint; a notice on the sheet
     with a subtle outline, so it reads quieter. */
  .qp-bar {
    /* In-flow (not fixed): the banner occupies real layout space above the
       page title, so it can never cover content, and it scrolls away with
       the page. */
    position: relative;
    box-sizing: border-box;

    display: grid;
    grid-template-columns: var(--aifs-notice-icon-size) minmax(0, 1fr) max-content;
    align-items: start;
    column-gap: var(--aifs-notice-gap);
    margin: 0;
    padding: var(--aifs-notice-padding-y) var(--aifs-notice-padding-x);

    color: var(--aifs-color-text-body);
    border-radius: var(--aifs-notice-radius);
    box-shadow: none;
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
  }

  .qp-bar--new {
    background: color-mix(
      in srgb,
      var(--aifs-notice-new-tint) calc(var(--aifs-notice-new-tint-strength) * 100%),
      var(--aifs-layout-sheet)
    );
    border: 0;
  }

  .qp-bar--notice {
    background: var(--aifs-notice-notice-background);
    border: var(--aifs-notice-border-width) solid var(--aifs-notice-notice-border);
  }

  /* The first time it appears in a session it fades in (opacity only, no
     movement); on later pages it is simply there. */
  .qp-bar.qp-bar--enter {
    animation: qpFadeIn var(--aifs-notice-enter-duration) var(--aifs-notice-enter-easing);
  }

  .qp-bar[hidden] {
    display: none;
  }

  /* The icon on the first line of text, in the informational colour. */
  .qp-icon {
    display: flex;
    color: var(--aifs-notice-icon);
  }

  .qp-body {
    display: flex;
    flex-direction: column;
    gap: var(--aifs-notice-text-gap);
    min-width: 0;
  }

  .qp-lead,
  .qp-msg,
  .qp-list {
    margin: 0;
    /* No single word alone on the last line. */
    text-wrap: pretty;
  }

  .qp-lead {
    font-weight: var(--aifs-aside-heading-font-weight);
  }

  .qp-list {
    display: flex;
    flex-direction: column;
    gap: var(--aifs-notice-list-gap);
    padding-inline-start: var(--aifs-notice-list-indent);
    list-style: disc;
  }

  .qp-list li {
    margin: 0;
    padding: 0;
  }

  /* Model names in bold, in the text colour. */
  .qp-bar :global(b) {
    color: var(--aifs-color-text-body);
    font-weight: 600;
  }

  .qp-cta {
    color: var(--aifs-color-link-standard);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: var(--aifs-radius-indicator);
    white-space: nowrap;
  }

  .qp-cta:hover,
  .qp-cta:focus-visible {
    color: var(--aifs-color-text-body);
  }

  /* Drawn by the Button component (ghost, small, icon only); centred on the
     first line of text, so it does not make the banner taller. */
  .qp-bar :global(.qp-close) {
    margin-block: calc((var(--aifs-notice-icon-size) - var(--aifs-button-min-height-small)) / 2);
    border-radius: var(--aifs-notice-close-radius);
  }

  .qp-bar :focus-visible {
    outline: var(--aifs-button-focus-width) solid var(--aifs-color-focus);
    outline-offset: var(--aifs-button-focus-width);
  }

  @media (forced-colors: active) {
    .qp-bar {
      border: var(--aifs-notice-border-width) solid CanvasText;
    }
  }

  @keyframes qpFadeIn {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qp-bar.qp-bar--enter {
      animation: none;
    }
  }
</style>

<script>
  // Dismiss-semantics rationale: see the component frontmatter.
  let reloadHandled = false;

  function isDismissed(key: string) {
    try {
      return sessionStorage.getItem(key) === '1';
    } catch {
      return false;
    }
  }

  // Clear the dismissals on a hard reload so the banners return on refresh.
  function clearOnReload(keys: string[]) {
    if (reloadHandled) return;
    reloadHandled = true;
    const nav = performance.getEntriesByType('navigation')[0] as
      | PerformanceNavigationTiming
      | undefined;
    const isReload = nav ? nav.type === 'reload' : (performance as any).navigation?.type === 1;
    if (isReload) {
      try {
        keys.forEach((key) => sessionStorage.removeItem(key));
      } catch {}
    }
  }

  // Closing a banner dismisses that announcement only.
  function dismiss(bar: HTMLElement) {
    try {
      sessionStorage.setItem(bar.dataset.key!, '1');
    } catch {}
    const stack = bar.parentElement;
    // Focus was in the banner: it goes to the remaining banner's close
    // button, or to the page title, not to <body>, so keyboard users keep
    // their place.
    const hadFocus = bar.contains(document.activeElement);
    const next = (bar.nextElementSibling ?? bar.previousElementSibling)?.querySelector<HTMLElement>('.qp-close');
    bar.remove();
    if (hadFocus) {
      if (next) {
        next.focus();
      } else {
        const title = document.getElementById('_top') ?? document.querySelector<HTMLElement>('main h1');
        if (title) {
          if (!title.hasAttribute('tabindex')) title.setAttribute('tabindex', '-1');
          title.focus({ preventScroll: true });
        }
      }
    }
    // The last banner gone: drop the row, so its spacing goes too.
    if (stack?.classList.contains('qp-stack') && !stack.querySelector('.qp-bar')) stack.remove();
    // The title moved up: On this page re-aligns with it (astro.config.mjs).
    document.dispatchEvent(new Event('aifs:banner-dismissed'));
  }

  function initPreviewModelsBanner() {
    const all = Array.from(document.querySelectorAll<HTMLElement>('.qp-bar[data-key]'));
    if (!all.length) return;
    clearOnReload(all.map((bar) => bar.dataset.key!));

    const bars = all.filter((bar) => {
      if (isDismissed(bar.dataset.key!)) {
        bar.remove();
        return false;
      }
      return true;
    });
    if (!bars.length) return;

    // Portal to the top of the content column, before the title: the
    // banners are about the site, not the page, but they sit on the sheet
    // with the column's edges (layout.css). They stay in flow, take real
    // space, and scroll away with the page.
    let host = document.querySelector<HTMLElement>('.qp-stack');
    const main = document.querySelector<HTMLElement>('.main-pane > main') ?? document.querySelector<HTMLElement>('main');
    const firstPanel = main?.querySelector(':scope > .content-panel');
    if (!host) {
      host = document.createElement('div');
      host.className = 'qp-stack';
    }
    if (firstPanel && host.nextElementSibling !== firstPanel) firstPanel.before(host);
    else if (!firstPanel && main && host.parentElement !== main) main.prepend(host);

    // Fade in only the first time in a session.
    let seen = false;
    try {
      seen = sessionStorage.getItem('aifsAnnouncementsSeen') === '1';
      sessionStorage.setItem('aifsAnnouncementsSeen', '1');
    } catch {}
    bars.forEach((bar) => {
      if (bar.parentElement !== host) host!.append(bar);
      bar.classList.toggle('qp-bar--enter', !seen);
      bar.hidden = false;
      if (bar.dataset.bound !== '1') {
        bar.dataset.bound = '1';
        bar.querySelector('.qp-close')?.addEventListener('click', () => dismiss(bar));
      }
    });

    // Escape closes a banner only while focus is inside it: elsewhere the
    // key belongs to whatever is open (a dialog, search, a filter menu).
    if (!(window as any).__previewModelsBannerEscBound) {
      (window as any).__previewModelsBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || e.defaultPrevented) return;
        const el = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('.qp-bar:not([hidden])');
        if (el) dismiss(el);
      });
    }
  }

  document.addEventListener('astro:page-load', initPreviewModelsBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreviewModelsBanner);
  } else {
    initPreviewModelsBanner();
  }
</script>
