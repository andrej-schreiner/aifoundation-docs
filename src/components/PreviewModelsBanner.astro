---
// Site-wide model announcement bar — currently GLM 5.3 Flash and Qwen 3.8
// 27B FP8 moving from the Test / preview catalog to production. Rendered from
// Footer.astro so it appears on every page (there are no splash pages, so the
// Footer override is truly global).
//
// Named generically (it was QwenPreviewBanner) because the copy is swapped
// whenever the preview catalog changes: one announcement at a time, never
// stacked. It replaced the GA bar (Mistral Small 4 / Gemma 4), which in turn
// replaced GlmBanner.
//
// Kept deliberately compact: a slim single-line bar rendered in the content
// flow above the page title (portaled into <main> by the script below), so it
// never covers content and scrolls away with the page.
//
// Dismiss semantics are unchanged: this site navigates via full page loads, so
// the closed state lives in sessionStorage (survives navigation between docs
// pages). A hard reload clears it (detected via PerformanceNavigationTiming
// "reload"), and a new tab starts a fresh session — so the announcement
// returns. The storage key changes with each announcement, so visitors who
// dismissed the previous one still see this one.

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const plansHref = isDE ? '/de/plans' : '/plans';

const t = isDE
  ? {
      badge: 'Neu',
      msg: '<b>GLM 5.3 Flash</b> und <b>Qwen 3.8 27B</b> sind jetzt in Produktion, in allen kostenpflichtigen Tarifen.',
      cta: 'Zu den Tarifen',
      close: 'Ankündigung schließen',
    }
  : {
      badge: 'New',
      msg: '<b>GLM 5.3 Flash</b> and <b>Qwen 3.8 27B</b> are now in production on all paid plans.',
      cta: 'View plans',
      close: 'Dismiss announcement',
    };
---

<div class="qp-bar" id="qp-bar" role="region" aria-label={t.close} hidden>
  <span class="qp-badge">{t.badge}</span>
  <p class="qp-msg" set:html={t.msg}></p>
  <a class="qp-cta" href={plansHref}>{t.cta}</a>
  <button type="button" class="qp-close" id="qp-close" aria-label={t.close}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</div>

<style>
  .qp-bar {
    /* In-flow (not fixed): the bar occupies real layout space above the page
       title, so it can never cover content, and it scrolls away with the
       page. See the portal logic in the script below. */
    position: relative;
    z-index: 1;

    display: flex;
    align-items: center;
    gap: 0.625rem;
    /* Left-aligned like the rest of the content column (margin:auto centering
       was a relic of the old fixed centered pill). */
    width: min(46rem, 100%);
    margin: 0 0 0.25rem;
    padding: 0.5rem 0.75rem;

    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-accent);
    border-radius: 10px;
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
    font-size: var(--sl-text-xs);
    line-height: 1.35;

    animation: gaSlideIn 0.32s cubic-bezier(0.2, 0.9, 0.25, 1.1);
  }
  .qp-bar[hidden] {
    display: none;
  }

  .qp-badge {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .qp-msg {
    flex: 1 1 auto;
    margin: 0;
    color: var(--sl-color-text);
  }
  .qp-msg :global(b) {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .qp-cta {
    flex-shrink: 0;
    padding: 0.3125rem 0.75rem;
    border-radius: 7px;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .qp-cta:hover,
  .qp-cta:focus-visible {
    background: var(--sl-color-accent-high);
  }

  .qp-close {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    transition: background 0.15s;
  }
  .qp-close:hover,
  .qp-close:focus-visible {
    background: var(--sl-color-gray-5);
  }
  .qp-close svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .qp-bar :focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* On narrow viewports drop the badge and let the message + CTA wrap. */
  @media (max-width: 30rem) {
    .qp-bar {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .qp-badge {
      display: none;
    }
    .qp-msg {
      flex-basis: 100%;
      order: 1;
    }
    .qp-cta {
      order: 2;
    }
    .qp-close {
      order: 3;
      margin-left: auto;
    }
  }

  @keyframes gaSlideIn {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qp-bar {
      animation: none;
    }
  }
</style>

<script>
  // Dismiss-semantics rationale: see the component frontmatter.
  const QP_KEY = 'gaGlmQwenBannerDismissed';
  let reloadHandled = false;

  function isDismissed() {
    try {
      return sessionStorage.getItem(QP_KEY) === '1';
    } catch {
      return false;
    }
  }

  // Clear the dismissal on a hard reload so the announcement returns on refresh.
  function clearOnReload() {
    if (reloadHandled) return;
    reloadHandled = true;
    const nav = performance.getEntriesByType('navigation')[0] as
      | PerformanceNavigationTiming
      | undefined;
    const isReload = nav ? nav.type === 'reload' : (performance as any).navigation?.type === 1;
    if (isReload) {
      try {
        sessionStorage.removeItem(QP_KEY);
      } catch {}
    }
  }

  function dismiss() {
    try {
      sessionStorage.setItem(QP_KEY, '1');
    } catch {}
    document.getElementById('qp-bar')?.remove();
  }

  function initPreviewModelsBanner() {
    clearOnReload();
    const bar = document.getElementById('qp-bar');
    if (!bar) return;

    if (isDismissed()) {
      bar.remove();
      return;
    }

    // Portal into the title panel, above the <h1>, so the bar sits in the
    // content flow — it occupies real space (nothing is ever covered) and
    // scrolls away with the page. Inside the panel (rather than above it) the
    // panel's own padding stays above the bar instead of stacking into the
    // bar-to-title gap.
    // Target the .sl-container INSIDE the panel (not the panel itself): the
    // container carries Starlight's max-width + centering, so the bar gets the
    // exact same left edge as the <h1> at every viewport width.
    const host =
      document.querySelector('main .content-panel .sl-container') ||
      document.querySelector('main .content-panel') ||
      document.querySelector('main');
    if (host && bar.parentElement !== host) {
      host.prepend(bar);
    }

    bar.hidden = false;
    document.getElementById('qp-close')?.addEventListener('click', dismiss);

    if (!(window as any).__previewModelsBannerEscBound) {
      (window as any).__previewModelsBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || isDismissed()) return;
        const el = document.getElementById('qp-bar');
        if (el && !el.hidden) dismiss();
      });
    }
  }

  document.addEventListener('astro:page-load', initPreviewModelsBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreviewModelsBanner);
  } else {
    initPreviewModelsBanner();
  }
</script>

