---
// Site-wide announcement bars — currently the API transition notice (linking
// to /api-transition) above the two OCR preview models, LightOnOCR-3-4B and
// PaddleOCR-VL-1.6 (linking to /guides/ocr).
// It replaced the Qwen3 Embedding 8B bar, which replaced the d3 preview bar,
// which replaced the DiffusionGemma 26B A4B
// preview bar, which replaced the
// GLM 5.3 Flash / Qwen 3.8 27B FP8 production bar. Rendered from
// Footer.astro so it appears on every page (there are no splash pages, so the
// Footer override is truly global).
//
// Named generically (it was QwenPreviewBanner) because the copy is swapped
// whenever the preview catalog changes. Bars stack in the order of the
// `bars` array below; each one is dismissed on its own. It replaced the GA bar (Mistral Small 4 / Gemma 4), which in turn
// replaced GlmBanner.
//
// Kept deliberately compact: a slim single-line bar in its own row above the
// table of contents and the content (portaled into .qp-stack by the script
// below; styled in layout.css), so it never covers content and scrolls away
// with the page.
//
// Dismiss semantics are unchanged: this site navigates via full page loads, so
// the closed state lives in sessionStorage (survives navigation between docs
// pages). A hard reload clears it (detected via PerformanceNavigationTiming
// "reload"), and a new tab starts a fresh session — so the announcement
// returns. Each bar has its own storage key, and the key changes with each
// announcement, so visitors who dismissed the previous one still see this one.

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';
const close = isDE ? 'Ankündigung schließen' : 'Dismiss announcement';

const bars = isDE
  ? [
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Hinweis',
        msg: 'Wir nehmen einige <b>Änderungen an der API</b> vor. Prüfen Sie, was sich ändert und was Sie tun müssen.',
        cta: 'Zur API-Umstellung',
        href: `${prefix}/api-transition`,
      },
      {
        key: 'glm53DeepseekLaunchDismissed',
        badge: 'Neu',
        msg: '<b>GLM 5.3</b> (T-Cloud) und <b>DeepSeek 4.1 Flash</b> ab 2. Nov.',
        cta: 'Modelle ansehen',
        href: `${prefix}/models/llms`,
      },
    ]
  : [
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Notice',
        msg: 'We are making a few <b>API changes</b>. See what changes and what you need to do.',
        cta: 'View API changes',
        href: `${prefix}/api-transition`,
      },
      {
        key: 'glm53DeepseekLaunchDismissed',
        badge: 'New',
        msg: '<b>GLM 5.3</b> (T-Cloud) and <b>DeepSeek 4.1 Flash</b> from 2 Nov',
        cta: 'View models',
        href: `${prefix}/models/llms`,
      },
    ];
import Button from './Button.astro';
import Tag from './Tag.astro';
import Icon from './Icon.astro';
---

{bars.map((b) => (
  <div class="qp-bar" data-key={b.key} role="region" aria-label={close} hidden>
    <Tag color="magenta" size="small" class="qp-badge">{b.badge}</Tag>
    <p class="qp-msg" set:html={b.msg}></p>
    <a class="qp-cta" href={b.href}>{b.cta}</a>
    <Button variant="ghost" size="small" iconOnly class="qp-close" ariaLabel={close}>
      <Icon name="action-close" size={16} />
    </Button>
  </div>
))}

<style>
  .qp-bar {
    /* In-flow (not fixed): the bar occupies real layout space above the page
       title, so it can never cover content, and it scrolls away with the
       page. See the portal logic in the script below. */
    position: relative;
    z-index: 1;

    display: flex;
    align-items: center;
    gap: 0.625rem;
    /* Spans its row (.qp-stack in layout.css), which sets the gaps. */
    width: 100%;
    margin: 0;
    padding: 0.45rem 0.75rem;

    background: var(--aifs-color-surface-chrome);
    color: var(--aifs-color-text-body);
    border: var(--aifs-border-width-standard) solid var(--aifs-color-border-subtle);
    border-inline-start: var(--aifs-border-width-indicator) solid var(--aifs-color-action-background);
    border-radius: 8px;
    box-shadow: none;
    font-size: 0.875rem;
    line-height: 1.35;

    animation: gaSlideIn 0.32s cubic-bezier(0.2, 0.9, 0.25, 1.1);
  }
  :global(:root[data-theme='dark']) .qp-bar {
    background: var(--aifs-color-surface-chrome);
    color: var(--aifs-color-text-body);
    border-color: var(--aifs-color-border-subtle);
    border-inline-start-color: var(--aifs-color-action-background);
  }

  :global(:root[data-theme='dark']) .qp-msg :global(b) {
    color: var(--aifs-color-text-body);
  }

  :global(:root[data-theme='dark']) .qp-cta {
    color: var(--aifs-color-link-standard);
  }

  .qp-bar[hidden] {
    display: none;
  }

  /* Drawn by the Tag component (magenta, small). */
  .qp-bar :global(.qp-badge) {
    flex-shrink: 0;
  }

  .qp-msg {
    flex: 1 1 auto;
    margin: 0;
    color: var(--sl-color-text);
  }
  .qp-msg :global(b) {
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }

  .qp-cta {
    flex-shrink: 0;
    color: var(--aifs-color-link-standard);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .qp-cta:hover,
  .qp-cta:focus-visible {
    color: var(--aifs-color-text-body);
  }

  /* Drawn by the Button component (ghost, small, icon only). */
  .qp-bar :global(.qp-close) {
    flex-shrink: 0;
  }

  .qp-bar :focus-visible {
    outline: 2px solid var(--aifs-color-focus);
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* Phones: one line of text, the link, and the close control on the right. */
  @media (max-width: 40rem) {
    .qp-bar {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "badge msg close" "badge cta close";
      align-items: center;
      column-gap: 6px;
      row-gap: 2px;
      padding: 4px 6px;
    }
    .qp-bar :global(.qp-badge) {
      grid-area: badge;
      align-self: start;
    }
    .qp-msg {
      grid-area: msg;
      min-width: 0;
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
    }
    .qp-cta {
      grid-area: cta;
      justify-self: start;
    }
    .qp-bar :global(.qp-close) {
      grid-area: close;
      align-self: start;
    }
  }

  @keyframes gaSlideIn {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qp-bar {
      animation: none;
    }
  }
</style>

<script>
  // Dismiss-semantics rationale: see the component frontmatter.
  let reloadHandled = false;

  function isDismissed(key: string) {
    try {
      return sessionStorage.getItem(key) === '1';
    } catch {
      return false;
    }
  }

  // Clear the dismissals on a hard reload so the announcements return on refresh.
  function clearOnReload(keys: string[]) {
    if (reloadHandled) return;
    reloadHandled = true;
    const nav = performance.getEntriesByType('navigation')[0] as
      | PerformanceNavigationTiming
      | undefined;
    const isReload = nav ? nav.type === 'reload' : (performance as any).navigation?.type === 1;
    if (isReload) {
      try {
        keys.forEach((key) => sessionStorage.removeItem(key));
      } catch {}
    }
  }

  function dismiss(bar: HTMLElement) {
    try {
      sessionStorage.setItem(bar.dataset.key!, '1');
    } catch {}
    const stack = bar.parentElement;
    bar.remove();
    // The last bar gone: drop the row, so its spacing goes too.
    if (stack?.classList.contains('qp-stack') && !stack.querySelector('.qp-bar')) stack.remove();
  }

  function initPreviewModelsBanner() {
    const all = Array.from(document.querySelectorAll<HTMLElement>('.qp-bar[data-key]'));
    clearOnReload(all.map((bar) => bar.dataset.key!));

    const bars = all.filter((bar) => {
      if (isDismissed(bar.dataset.key!)) {
        bar.remove();
        return false;
      }
      return true;
    });
    if (!bars.length) return;

    // Portal to the top of the content sheet so the bars share its width and
    // edges. They stay in flow, take real space, and scroll away with the page.
    let host = document.querySelector<HTMLElement>('.qp-stack');
    const sheet = document.querySelector('main');
    if (!host) {
      host = document.createElement('div');
      host.className = 'qp-stack';
      sheet?.prepend(host);
    } else if (sheet && host.parentElement !== sheet) {
      sheet.prepend(host);
    }
    if (bars[0].parentElement !== host) {
      host.append(...bars);
    }

    for (const bar of bars) {
      bar.hidden = false;
      bar.querySelector('.qp-close')?.addEventListener('click', () => dismiss(bar));
    }

    // Escape dismisses the topmost visible bar.
    if (!(window as any).__previewModelsBannerEscBound) {
      (window as any).__previewModelsBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const el = document.querySelector<HTMLElement>('.qp-bar[data-key]:not([hidden])');
        if (el) dismiss(el);
      });
    }
  }

  document.addEventListener('astro:page-load', initPreviewModelsBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreviewModelsBanner);
  } else {
    initPreviewModelsBanner();
  }
</script>
