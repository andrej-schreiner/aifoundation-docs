---
// Site-wide announcement: one compact box above the page title, one row per
// announcement (Tag + a linked message + an arrow), and one close button for
// the whole box. Currently the GLM 5.3 / DeepSeek 4.1 Flash launch (linking
// to the LLM list) and the API transition notice (linking to /api-transition).
// Rendered from ArchiveBanner.astro (Starlight's Banner slot), so it appears
// on every page, as the first child of <main>.
//
// Named generically (it was QwenPreviewBanner) because the copy is swapped
// whenever the catalog changes. Each row keeps its own storage key, and the
// key changes with each announcement, so visitors who dismissed the previous
// one still see this one.
//
// In-flow, not fixed: it takes its space on the first paint and scrolls away
// with the page. .qp-stack is a panel with the title panel's insets, so the
// box shares the content column's left edge; layout.css sets the gaps.
//
// Dismiss semantics: this site navigates via full page loads, so the closed
// state lives in sessionStorage (survives navigation between docs pages). A
// hard reload clears it (detected via PerformanceNavigationTiming "reload"),
// and a new tab starts a fresh session — so the announcement returns. An
// inline head script (astro.config.mjs) turns each stored key into a
// qp-off-<key> class on <html> before the first paint; layout.css hides the
// matching row, and the whole box once every row is off.

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';
const label = isDE ? 'Ankündigungen' : 'Announcements';
const close = isDE ? 'Ankündigung schließen' : 'Dismiss announcement';

// `short` on every screen; a row with a `msg` shows that instead where the
// column has room for it on one line (see the container query).
const rows = isDE
  ? [
      {
        key: 'glm53DeepseekLaunchDismissed',
        badge: 'Neu',
        tag: 'magenta',
        msg: '<b>GLM 5.3</b> (T-Cloud) und <b>DeepSeek 4.1 Flash</b> (T-Cloud, Vorschau) ab 2.\u00a0Nov.',
        short: '<b>GLM 5.3</b>, <b>DeepSeek 4.1 Flash</b> ab 2.\u00a0Nov.',
        href: `${prefix}/models/llms`,
      },
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Hinweis',
        tag: 'standard',
        short: '<b>API-Änderungen</b>: Was ist zu tun?',
        href: `${prefix}/api-transition`,
      },
    ]
  : [
      {
        key: 'glm53DeepseekLaunchDismissed',
        badge: 'New',
        tag: 'magenta',
        msg: '<b>GLM 5.3</b> (T-Cloud) and <b>DeepSeek 4.1 Flash</b> (T-Cloud, preview) from 2\u00a0Nov',
        short: '<b>GLM 5.3</b>, <b>DeepSeek 4.1 Flash</b> from 2\u00a0Nov',
        href: `${prefix}/models/llms`,
      },
      {
        key: 'apiTransitionBannerDismissed',
        badge: 'Notice',
        tag: 'standard',
        short: '<b>API changes</b>: what to do',
        href: `${prefix}/api-transition`,
      },
    ];
import Button from './Button.astro';
import Tag from './Tag.astro';
import Icon from './Icon.astro';
---

<div class="qp-stack" data-pagefind-ignore>
  <div class="qp-box" role="region" aria-label={label}>
    <ul class="qp-rows">
      {rows.map((r) => (
        <li class="qp-row" data-key={r.key}>
          <a class="qp-link" href={r.href}>
            <Tag color={r.tag as 'standard' | 'magenta'} size="small" class="qp-badge">{r.badge}</Tag>
            <span class="qp-text">
              {/* No whitespace between the parts: the one no-break space keeps
                  the arrow on the last word's line. */}
              {r.msg && <span class="qp-msg" set:html={r.msg} />}<span class:list={['qp-short', r.msg && 'qp-short--alt']} set:html={r.short} />{'\u00a0'}<span class="qp-arrow" aria-hidden="true">{'\u2192'}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <Button variant="ghost" size="small" iconOnly class="qp-close" ariaLabel={close}>
      <Icon name="action-close" size={16} />
    </Button>
  </div>
</div>

<style>
  /* One box for all rows: the card border and radius, no fill of its own,
     as wide as its text (never wider than the column). */
  .qp-box {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    padding: 4px 4px 4px 12px;
    border: var(--aifs-border-width-standard) solid var(--aifs-color-border-subtle);
    border-radius: var(--aifs-radius-card);
    color: var(--aifs-color-text-body);
    font-size: var(--aifs-text-small-font-size);
    line-height: 20px;
  }

  .qp-rows {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Tag and text in two columns: a wrapped line starts under the text, and the
     20px tag lines up with the first 20px line. */
  .qp-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: 8px;
    padding-block: 4px;
    color: inherit;
    text-decoration: none;
  }

  .qp-link :global(.qp-badge) {
    margin: 0;
  }

  .qp-text {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .qp-text :global(b) {
    font-weight: 700;
  }

  /* Inline, so it can't break away from the text. */
  .qp-arrow {
    position: relative;
    left: 0;
    color: var(--aifs-color-link-standard);
    font-weight: 700;
    transition: left 0.15s ease;
  }

  .qp-link:hover .qp-text :is(.qp-msg, .qp-short),
  .qp-link:focus-visible .qp-text :is(.qp-msg, .qp-short) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .qp-link:hover .qp-arrow {
    left: 2px;
  }

  .qp-link:focus-visible {
    outline: 2px solid var(--aifs-color-focus);
    outline-offset: 2px;
    border-radius: var(--aifs-radius-control);
  }

  /* Drawn by the Button component (ghost, small, icon only), centred on the
     rows. */
  .qp-box :global(.qp-close) {
    flex-shrink: 0;
  }

  .qp-short--alt {
    display: none;
  }

  /* The long message where it fits on one line (every column on the sheet);
     a narrower column (phones) gets the short one. */
  .qp-stack {
    container: qp-stack / inline-size;
  }

  @container qp-stack (max-width: 38.74rem) {
    .qp-msg {
      display: none;
    }
    .qp-short--alt {
      display: inline;
    }
  }

  /* Phones: 40px rows and close button to tap. */
  @media (max-width: 40rem) {
    .qp-box {
      align-items: flex-start;
    }
    .qp-link {
      min-height: 40px;
      box-sizing: border-box;
      align-content: center;
    }
    .qp-box :global(.qp-close) {
      min-width: 40px;
      min-height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qp-arrow {
      transition: none;
    }
  }
</style>

<script>
  // Closes every row: stores each key and sets its qp-off-<key> class, which
  // hides the box (layout.css).
  function dismiss() {
    const root = document.documentElement;
    document.querySelectorAll<HTMLElement>('.qp-row[data-key]').forEach((row) => {
      const key = row.dataset.key;
      if (!key) return;
      try {
        sessionStorage.setItem(key, '1');
      } catch {}
      root.classList.add('qp-off-' + key);
    });
  }

  function initPreviewModelsBanner() {
    document.querySelectorAll<HTMLElement>('.qp-box').forEach((box) => {
      if (box.dataset.qpBound === '1') return;
      box.dataset.qpBound = '1';
      box.querySelector('.qp-close')?.addEventListener('click', dismiss);
    });
    if (!(window as any).__previewModelsBannerEscBound) {
      (window as any).__previewModelsBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const el = document.querySelector<HTMLElement>('.qp-stack');
        if (el && getComputedStyle(el).display !== 'none') dismiss();
      });
    }
  }

  document.addEventListener('astro:page-load', initPreviewModelsBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreviewModelsBanner);
  } else {
    initPreviewModelsBanner();
  }
</script>
