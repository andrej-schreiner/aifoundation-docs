---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import Button from './Button.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const home = isDE ? '/de/' : '/';
const cta = isDE ? 'API-Key' : 'Get API key';
const ctaAria = isDE
	? 'API-Key generieren (öffnet in neuem Tab)'
	: 'Get API key (opens in a new tab)';
const showSearch =
	config.pagefind || config.components?.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="ts-header">
	<a class="ts-brand" href={home} aria-label="AI Foundation Services">
		<span class="ts-mark">
			<img src="/img/favicon_180x180.png" width="28" height="28" alt="" />
		</span>
		<span class="ts-word">
			<span class="ts-word-full">AI Foundation Services</span>
			<span class="ts-word-short">AIFS</span>
		</span>
	</a>
	<div class="ts-search">{showSearch && <Search />}</div>
	<div class="ts-tools">
		<ThemeSelect />
		<LanguageSelect />
		<Button class="ts-cta" href="https://apikey.llmhub.t-systems.net/login" target="_blank" rel="noopener noreferrer" ariaLabel={ctaAria}>
			{cta}
		</Button>
	</div>
</div>

<style>
	.ts-header {
		display: flex;
		align-items: center;
		gap: var(--aifs-header-gap);
		height: 100%;
		min-width: 0;
	}

	/* The magenta T on the header background, the site name beside it in the
	   text colour. No plate: the T is the only magenta here besides the
	   Get API key button. */
	.ts-brand {
		display: flex;
		align-items: center;
		gap: var(--aifs-header-gap);
		flex: 0 0 auto;
		min-width: max-content;
		color: var(--aifs-color-text-body);
		text-decoration: none;
		font-family: var(--aifs-font-body);
	}

	.ts-mark {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
	}

	/* The file is a magenta T on transparency, shown as it is. */
	.ts-mark img {
		width: var(--aifs-header-mark-size);
		height: var(--aifs-header-mark-size);
		object-fit: contain;
	}

	.ts-word {
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.1;
		white-space: nowrap;
	}

	.ts-word-short {
		display: none;
	}

	.ts-search {
		flex: 1 1 auto;
		min-width: 0;
	}

	.ts-tools {
		display: flex;
		align-items: center;
		gap: var(--aifs-header-tools-gap);
		flex: 0 0 auto;
	}

	/* Wide screens: three columns, the logo and the tools in equal flexible
	   ones, so the search sits in the middle of the header (exactly from
	   about 1440px). Neither side shrinks below its content; when the tools
	   need more than half of the room, the search moves towards the logo by
	   the difference. Below 72rem the sides don't both fit beside a centred
	   field, so the header stays a row with the search filling the gap. */
	@media (min-width: 72rem) {
		.ts-header {
			display: grid;
			grid-template-columns:
				minmax(max-content, 1fr)
				minmax(0, var(--aifs-header-search-width))
				minmax(max-content, 1fr);
		}

		/* The search field fills its column, wider than Starlight's 22rem. */
		.ts-search :global(site-search button) {
			width: 100%;
			max-width: none;
		}

		.ts-tools {
			justify-self: end;
		}
	}

	@media (max-width: 49.99rem) {
		.ts-header {
			gap: 8px;
		}

		.ts-tools > :global(*:not(.ts-cta)) {
			display: none !important;
		}
	}

	@media (max-width: 71.99rem) {
		.ts-word-full {
			display: none;
		}

		.ts-word-short {
			display: inline;
		}
	}
</style>

<script>
	// starlight-versions labels the current docs "Latest" in every locale.
	function localizeVersionLabel() {
		if (!document.documentElement.lang.startsWith('de')) return;
		document.querySelectorAll('starlight-version-select option').forEach((option) => {
			if (option.textContent?.trim() === 'Latest') option.textContent = 'Aktuell';
		});
	}
	localizeVersionLabel();
	document.addEventListener('astro:page-load', localizeVersionLabel);
</script>
