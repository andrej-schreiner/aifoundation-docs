---
// Site part, not for reuse. Starlight's Header slot (astro.config.mjs): the
// menu button (on pages with a sidebar), logo (the T, the site name and under it the subline "Technical documentation",
// hidden on phones below 31rem), search, version, theme and language
// selects, and the API key button (in English "API key" below 22.5rem, as
// short as the German "API-Key").
// The menu button sits at the start of the header, before the logo, at every
// width. Below 50rem it opens the site navigation over the page (Starlight's
// phone menu); from 50rem it shows and hides the sidebar, which starts
// shown; a hidden sidebar stays hidden for the session. It replaces
// Starlight's own menu button, which sits at the end of the header and only
// on phones (hidden in redesign.css).
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import Button from './Button.astro';
import VersionSelect from './VersionSelect.astro';
import Icon from './Icon.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
// From 50 to 72rem the search and the version, theme and language selects
// move into one panel under a More button, so the site name keeps its room. Phones have their own
// menu (MobileMenuFooter) and keep the search icon.
const more = isDE ? 'Mehr' : 'More';
const menu = Astro.locals.t('menuButton.accessibleLabel');
const hasSidebar = Astro.locals.starlightRoute.hasSidebar;
const home = isDE ? '/de/' : '/';
const subline = isDE ? 'Technische Dokumentation' : 'Technical documentation';
const cta = isDE ? 'API-Key' : 'Get API key';
// Below 22.5rem "Get API key" does not fit beside "AIFS" and the search
// button; the aria-label keeps the full name.
const ctaShort = isDE ? 'API-Key' : 'API key';
const ctaAria = isDE
	? 'API-Key generieren (öffnet in neuem Tab)'
	: 'Get API key (opens in a new tab)';
const showSearch =
	config.pagefind || config.components?.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="ts-header">
	<div class="ts-start">
		{
			hasSidebar && (
				<>
					<script is:inline>
						try {
							if (sessionStorage.getItem('aifsNavHidden') === '1')
								document.documentElement.setAttribute('data-nav-hidden', '');
						} catch (e) {}
					</script>
					<Button
						variant="ghost"
						iconOnly
						ariaLabel={menu}
						class="ts-menu-toggle"
						aria-expanded="false"
						aria-controls="starlight__sidebar"
					>
						<Icon name="action-menu" size={24} class="ts-menu-open" />
						<Icon name="action-close" size={24} class="ts-menu-close" />
					</Button>
				</>
			)
		}
		<a class="ts-brand" href={home} aria-label={`AI Foundation Services, ${subline}`}>
			<span class="ts-mark">
				<img src="/img/favicon_180x180.png" width="28" height="28" alt="" />
			</span>
			<span class="ts-word">
				<span class="ts-word-title">
					<span class="ts-word-full">AI Foundation Services</span>
					<span class="ts-word-short">AIFS</span>
				</span>
				<span class="ts-word-sub">{subline}</span>
			</span>
		</a>
	</div>
	<div class="ts-search" data-search-home>{showSearch && <Search />}</div>
	<div class="ts-tools">
		<Button variant="ghost" class="ts-settings-toggle" aria-expanded="false" aria-controls="ts-settings">
			<Icon name="action-more" size={20} />
			{more}
			<Icon name="navigation-collapse-down" size={16} class="ts-settings-caret" />
		</Button>
		<div class="ts-settings" id="ts-settings">
			<div class="ts-settings__search" data-search-menu></div>
			<VersionSelect />
			<ThemeSelect />
			<LanguageSelect />
		</div>
		<Button class="ts-cta" href="https://apikey.llmhub.t-systems.net/login" target="_blank" rel="noopener noreferrer" ariaLabel={ctaAria}>
			<span class="ts-cta-full">{cta}</span>
			<span class="ts-cta-short">{ctaShort}</span>
		</Button>
	</div>
</div>

<style>
	.ts-header {
		display: flex;
		align-items: center;
		gap: var(--aifs-header-gap);
		height: 100%;
		min-width: 0;
	}

	/* The menu button and the logo, at the start of the header. */
	.ts-start {
		display: flex;
		align-items: center;
		gap: var(--aifs-header-gap);
		flex: 0 1 auto;
		min-width: 0;
	}

	/* The close icon shows only while the phone menu is open. */
	.ts-start :global(.ts-menu-close) {
		display: none;
	}

	@media (max-width: 49.99rem) {
		:global([data-mobile-menu-expanded]) .ts-start :global(.ts-menu-open) {
			display: none;
		}

		:global([data-mobile-menu-expanded]) .ts-start :global(.ts-menu-close) {
			display: inline-block;
		}
	}

	/* The magenta T on the header background, the site name beside it in the
	   text colour. No plate: the T is the only magenta here besides the
	   Get API key button. */
	.ts-brand {
		display: flex;
		align-items: center;
		gap: var(--aifs-header-gap);
		flex: 0 1 auto;
		min-width: 0;
		color: var(--aifs-color-text-body);
		text-decoration: none;
		font-family: var(--aifs-font-body);
	}

	.ts-mark {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
	}

	/* The file is a magenta T on transparency, shown as it is. */
	.ts-mark img {
		width: var(--aifs-header-mark-size);
		height: var(--aifs-header-mark-size);
		object-fit: contain;
	}

	/* The site name, and under it the subline: smaller, regular, muted. */
	.ts-word {
		display: flex;
		flex-direction: column;
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.1;
		white-space: nowrap;
	}

	.ts-word-sub {
		font-size: var(--aifs-text-small-font-size);
		font-weight: var(--aifs-text-small-font-weight);
		line-height: var(--aifs-text-small-line-height);
		color: var(--aifs-color-text-muted);
	}

	.ts-word-short,
	.ts-cta-short {
		display: none;
	}

	.ts-search {
		flex: 1 1 auto;
		min-width: 0;
	}

	.ts-tools {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--aifs-header-tools-gap);
		flex: 0 0 auto;
	}

	/* Wide screens: the selects sit in the row, as before; the panel's box
	   drops away. */
	.ts-settings {
		display: contents;
	}

	.ts-tools :global(.ts-settings-toggle) {
		display: none;
	}

	/* Below 72rem: one More button; the selects open in a panel under
	   it, drawn like a filter field's menu. */
	@media (max-width: 71.99rem) {
		.ts-tools :global(.ts-settings-toggle) {
			display: inline-flex;
		}

		.ts-tools :global(.ts-settings-caret) {
			transition-property: rotate;
			transition-duration: var(--aifs-select-transition-duration);
			transition-timing-function: var(--aifs-select-transition-easing);
		}

		.ts-tools :global(.ts-settings-toggle[aria-expanded='true'] .ts-settings-caret) {
			rotate: 180deg;
		}

		.ts-settings {
			position: absolute;
			top: calc(100% + var(--aifs-header-settings-offset));
			right: 0;
			z-index: 40;
			display: flex;
			flex-direction: column;
			gap: var(--aifs-header-settings-row-gap);
			padding: var(--aifs-header-settings-padding);
			border: var(--aifs-select-border-width) solid var(--aifs-select-border);
			border-radius: var(--aifs-select-radius);
			background: var(--aifs-layout-sheet);
			/* TODO(token-gap): Telekom shadow tokens are not converted yet (GAPS.md row 10). */
			box-shadow: 0 8px 24px rgb(0 0 0 / 0.16);
		}

		.ts-settings:not([data-open]) {
			display: none;
		}

		/* The search field spans the panel, as wide as the selects. */
		.ts-settings__search :global(button[data-open-modal]) {
			width: 100%;
			max-width: none;
		}

		.ts-settings__search:empty {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ts-tools :global(.ts-settings-caret) {
			transition: none;
		}
	}

	/* Wide screens: three columns, the logo and the tools in equal flexible
	   ones, so the search sits in the middle of the header (exactly from
	   about 1440px). Neither side shrinks below its content; when the tools
	   need more than half of the room, the search moves towards the logo by
	   the difference. Below 72rem the sides don't both fit beside a centred
	   field, so the header stays a row with the search filling the gap. */
	@media (min-width: 72rem) {
		.ts-header {
			display: grid;
			grid-template-columns:
				minmax(max-content, 1fr)
				minmax(0, var(--aifs-header-search-width))
				minmax(max-content, 1fr);
		}

		/* The search field fills its column, wider than Starlight's 22rem. */
		.ts-search :global(site-search > button[data-open-modal]) {
			width: 100%;
			max-width: none;
		}

		.ts-tools {
			justify-self: end;
		}
	}

	@media (max-width: 49.99rem) {
		.ts-header,
		.ts-start {
			gap: 8px;
		}

		.ts-tools > :global(*:not(.ts-cta)) {
			display: none !important;
		}
	}

	/* Phones below 31rem: beside the T, the search and the button there is
	   room for the short name only, so the subline goes. */
	@media (max-width: 30.99rem) {
		.ts-word-sub {
			display: none;
		}
	}

	@media (max-width: 40rem) {
		.ts-word-full {
			display: none;
		}

		.ts-word-short {
			display: inline;
		}
	}

	/* Narrow phones, below 22.5rem (360px): the short button label, so
	   "AIFS", the search button and the button keep their gaps. */
	@media (max-width: 22.49rem) {
		.ts-cta-full {
			display: none;
		}

		.ts-cta-short {
			display: inline;
		}
	}
</style>

<script is:inline>
	document.querySelectorAll('site-search button[data-open-modal]').forEach((btn) => {
		const text = (btn.innerText || btn.textContent || '').replace(/\s+/g, ' ').trim();
		if (text) btn.setAttribute('aria-label', text);
	});
</script>

<script>
	// From 50 to 72rem the search button lives in the menu panel; elsewhere
	// in its <site-search>. Only the button moves: Starlight keeps references
	// to it and the dialog, so both keep working, and the dialog stays out of
	// the hidden panel, where it could not be seen when ⌘K opens it.
	const menuWidth = window.matchMedia('(min-width: 50rem) and (max-width: 71.99rem)');
	function placeSearch() {
		const search = document.querySelector('site-search');
		const button = document.querySelector('button[data-open-modal]');
		const slot = menuWidth.matches ? document.querySelector('[data-search-menu]') : search;
		if (button && slot && button.parentElement !== slot) slot.prepend(button);
	}
	placeSearch();
	menuWidth.addEventListener('change', placeSearch);
	document.addEventListener('astro:page-load', placeSearch);

	// The More button (50 to 72rem) shows and hides the panel with the search
	// and the version, theme and language selects. Escape and a click
	// outside close it.
	function initSettings() {
		const toggle = document.querySelector<HTMLButtonElement>('.ts-settings-toggle');
		const panel = document.getElementById('ts-settings');
		if (!toggle || !panel || toggle.dataset.bound) return;
		toggle.dataset.bound = 'true';

		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			panel.toggleAttribute('data-open', open);
		};

		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
			if (open) panel.querySelector<HTMLElement>('button[data-open-modal], select')?.focus();
		});

		panel.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			e.preventDefault();
			setOpen(false);
			toggle.focus();
		});

		document.addEventListener('click', (e) => {
			const target = e.target as Node;
			if (!toggle.contains(target) && !panel.contains(target)) setOpen(false);
		});
	}
	initSettings();
	document.addEventListener('astro:page-load', initSettings);

	// The menu button at the start of the header. Below 50rem it opens and
	// closes the phone menu: Starlight's data-mobile-menu-expanded on <body>
	// (which also stops the page scrolling) shows the sidebar pane over the
	// page (layout.css). From 50rem it hides and shows the sidebar
	// (data-nav-hidden on <html>, kept in sessionStorage; an inline script
	// above sets it before the sidebar is drawn). aria-expanded says whether
	// the navigation is shown at the current width.
	function initMenu() {
		const toggle = document.querySelector<HTMLButtonElement>('.ts-menu-toggle');
		if (!toggle || toggle.dataset.bound) return;
		toggle.dataset.bound = 'true';
		const wide = window.matchMedia('(min-width: 50rem)');
		const root = document.documentElement;

		const sync = () => {
			const shown = wide.matches
				? !root.hasAttribute('data-nav-hidden')
				: document.body.hasAttribute('data-mobile-menu-expanded');
			toggle.setAttribute('aria-expanded', String(shown));
		};
		const setPhoneMenu = (open: boolean) => {
			document.body.toggleAttribute('data-mobile-menu-expanded', open);
			sync();
		};

		toggle.addEventListener('click', () => {
			if (wide.matches) {
				const hide = !root.hasAttribute('data-nav-hidden');
				root.toggleAttribute('data-nav-hidden', hide);
				try {
					if (hide) sessionStorage.setItem('aifsNavHidden', '1');
					else sessionStorage.removeItem('aifsNavHidden');
				} catch {}
				sync();
			} else {
				setPhoneMenu(!document.body.hasAttribute('data-mobile-menu-expanded'));
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape' || wide.matches) return;
			if (!document.body.hasAttribute('data-mobile-menu-expanded')) return;
			setPhoneMenu(false);
			toggle.focus();
		});

		// Growing past 50rem closes the phone menu: the sidebar is in the page.
		wide.addEventListener('change', () => setPhoneMenu(false));
		sync();
	}
	initMenu();
	document.addEventListener('astro:page-load', initMenu);
</script>
