---
// A plan's tag: fixed colour and fixed wording per plan, the same on every
// page. Used in the plans table, the rate plan cards and the Plans column of
// the models table. Mirrors Scale's scale-tag (standard type) with one
// colour per plan; styles live in src/styles/tag.css.
//
// `plan` takes the plan's name as the data spells it ("Essential",
// "Standard 1000"): the first word picks the colour. A plan without its own
// entry (the retired Basic and Standard plans) shows its full name in the
// standard colour. Test reads "Preview" ("Vorschau" on German pages).
import { planTags, planTagKey } from '../shared/lib/planTags';

interface Props {
	/** The plan's name or key: essential, professional, agentic, enterprise, test, or a retired plan's name. */
	plan: string;
	size?: 'default' | 'small';
	/** Links the tag to the plan's page. */
	href?: string;
}

const { plan, size = 'default', href } = Astro.props;
const isDE = Astro.url.pathname === '/de' || Astro.url.pathname.startsWith('/de/');
const key = planTagKey(plan);
const entry = planTags[key];
const label = entry ? (isDE && entry.labelDE) || entry.label : plan;
const classes = ['aifs-tag', entry && `aifs-tag--plan-${key}`, size === 'small' && 'aifs-tag--small'];
---

{
	href ? (
		<a class:list={classes} href={href}>
			{label}
		</a>
	) : (
		<span class:list={classes}>{label}</span>
	)
}
