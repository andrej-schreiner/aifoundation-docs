---
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const label = isDE ? 'API-Key generieren' : 'Get API Key';
const ariaLabel = isDE
  ? 'API-Key generieren (öffnet in neuem Tab)'
  : 'Get API Key (opens in new tab)';

// GLM-5.2 "now in production" note shown alongside the Get API Key CTA. GLM 5.2
// graduated from the free preview to the paid plans, so the pill now points at
// the plans page instead of the preview access-request form.
const plansHref = isDE ? '/de/plans' : '/plans';
const previewLabel = isDE ? 'GLM 5.2 jetzt in Produktion' : 'GLM 5.2 now in production';
const previewAriaLabel = isDE
  ? 'GLM 5.2 ist jetzt in Produktion – zu den Tarifen'
  : 'GLM 5.2 is now in production – view plans';
---

<Default {...Astro.props}><slot /></Default>

<a
  class="header-preview"
  href={plansHref}
  aria-label={previewAriaLabel}
>
  <span class="header-preview-dot" aria-hidden="true"></span>
  <span class="header-preview-name">{previewLabel}</span>
</a>

<a
  class="header-cta"
  href="https://apikey.llmhub.t-systems.net/login"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
>
  <span class="header-cta-label">{label}</span>
  <span class="header-cta-icon" aria-hidden="true">&#8599;</span>
</a>

<style>
  /* GLM-5.2 preview note — a lighter, outlined pill that sits to the left of
     the solid Get API Key CTA. Reads as a related-but-secondary announcement.
     Hidden on narrower viewports so it never crowds the CTA (see the media
     query below); the GlmBanner toast still covers mobile. */
  .header-preview {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    margin-inline-end: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-xs);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .header-preview:hover {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .header-preview:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .header-preview-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 0 var(--sl-color-accent);
    animation: header-preview-pulse 1.9s ease-out infinite;
  }
  .header-preview:hover .header-preview-dot {
    background: var(--sl-color-white);
    box-shadow: none;
    animation: none;
  }

  .header-preview-name {
    font-weight: 600;
  }

  @keyframes header-preview-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(226, 0, 116, 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.4rem rgba(226, 0, 116, 0);
    }
  }

  /* Below ~62rem the header gets tight; drop the note and keep only the CTA. */
  @media (max-width: 62rem) {
    .header-preview {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-preview-dot {
      animation: none;
    }
  }

  /* Desktop pill. Naturally hidden below md (~50rem) because Starlight wraps
     SocialIcons in a .right-group with `sl-hidden md:sl-flex` — see
     MobileApiKeyLink.astro for the mobile counterpart. */
  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .header-cta:hover {
    background: var(--sl-color-accent-high);
  }

  .header-cta:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .header-cta-icon {
    font-size: 0.9em;
  }
</style>
