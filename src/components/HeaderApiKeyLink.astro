---
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const label = isDE ? 'API-Key generieren' : 'Get API Key';
const ariaLabel = isDE
  ? 'API-Key generieren (öffnet in neuem Tab)'
  : 'Get API Key (opens in new tab)';
---

<Default {...Astro.props}><slot /></Default>

<a
  class="header-cta"
  href="https://apikey.llmhub.t-systems.net/login"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
>
  <span class="header-cta-label">{label}</span>
  <span class="header-cta-icon" aria-hidden="true">&#8599;</span>
</a>

<style>
  /* Desktop pill. Naturally hidden below md (~50rem) because Starlight wraps
     SocialIcons in a .right-group with `sl-hidden md:sl-flex` — see
     MobileApiKeyLink.astro for the mobile counterpart. */
  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--aifs-radius-button, 24px);
    border: 1px solid #e20074;
    background: #e20074;
    /* White on #e20074 is 4.68:1. Starlight's --sl-color-white is dark in light mode. */
    color: #ffffff;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .header-cta:hover {
    /* t-systems.com inverts: white fill, magenta text. #e20074 on white is 4.68:1. */
    background: #ffffff;
    color: #e20074;
  }

  .header-cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .header-cta-icon {
    font-size: 0.9em;
  }
</style>
