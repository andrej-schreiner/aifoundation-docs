---
// Site part, not for reuse. Starlight's Banner slot (astro.config.mjs): on archived
// pages (every version in starlightVersions), a bar that links to the current docs;
// elsewhere the page's own banner.
import versionsConfig from 'virtual:starlight-versions-config';
import PreviewModelsBanner from './PreviewModelsBanner.astro';

const { banner } = Astro.locals.starlightRoute.entry.data;
const path = Astro.url.pathname;
const isDE = path === '/de' || path.startsWith('/de/');
const versionSlug = path.replace(/^\/de(?=\/|$)/, '').split('/')[1];
const archived = versionsConfig.versions.find((version) => version.slug === versionSlug);
const label = archived ? (archived.label ?? archived.slug) : '';
const home = isDE ? '/de/' : '/';
---

{
	archived && (
		<div class="sl-banner" data-pagefind-ignore>
			{isDE ? (
				<>
					Archivierte Fassung ({label}). Die aktuelle Dokumentation ist die{' '}
					<a href={home}>Startseite</a>.
				</>
			) : (
				<>
					Archived snapshot ({label}). For current documentation, start at the{' '}
					<a href={home}>home page</a>.
				</>
			)}
		</div>
	)
}
<PreviewModelsBanner />
{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}

<style>
	.sl-banner {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
		color: var(--sl-color-banner-text, var(--sl-color-text-invert));
		line-height: var(--sl-line-height-headings);
		text-align: center;
		text-wrap: balance;
	}
	.sl-banner :global(a) {
		color: inherit;
	}
</style>
