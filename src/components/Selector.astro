---
// Dropdown select with Scale's API (scale-dropdown-select) on a native
// <select>: label inside the field, optional helper text, invalid and
// disabled states, plus a ghost variant without border. Options go in the
// slot as <option> elements. Styles live in src/styles/select.css.
import Icon from './Icon.astro';

interface Props {
  id: string;
  /** Shown inside the field, above the value. Always give one: it is the select's accessible name. */
  label?: string;
  /** Keeps the label for screen readers but not on screen (Scale's hideLabelVisually). */
  hideLabel?: boolean;
  variant?: 'standard' | 'ghost';
  /** A Telekom icon on the left (Icon names, such as `content-language`). Decoration: the label names the select. */
  icon?: string;
  /** Text under the field; with `invalid`, it says what is wrong. */
  helperText?: string;
  invalid?: boolean;
  disabled?: boolean;
  name?: string;
}

const { id, label, hideLabel = false, variant = 'standard', icon, helperText, invalid = false, disabled = false, name } = Astro.props;
const hasLabel = Boolean(label?.trim());
const showLabel = hasLabel && !hideLabel;
const helperId = helperText ? `${id}-helper` : undefined;
---

<div
  class:list={[
    'aifs-select',
    `aifs-select--${variant}`,
    { 'aifs-select--labelled': showLabel, 'aifs-select--with-icon': Boolean(icon), 'aifs-select--invalid': invalid },
  ]}
>
  <span class="aifs-select__field">
    {icon && (
      <span class="aifs-select__lead-icon" aria-hidden="true">
        <Icon name={icon} size={20} />
      </span>
    )}
    {/* Only the label text is the <label>: wrapping the whole field would put the
        options and the helper text into the select's accessible name. */}
    {hasLabel && <label class:list={['aifs-select__label', { 'sr-only': !showLabel }]} for={id}>{label}</label>}
    <select
      class="aifs-select__control"
      id={id}
      name={name}
      disabled={disabled}
      aria-invalid={invalid ? 'true' : undefined}
      aria-describedby={helperId}
    >
      <slot />
    </select>
    <span class="aifs-select__icon" aria-hidden="true">
      <Icon name="navigation-collapse-down" size={20} />
    </span>
  </span>
  {helperText && <span class="aifs-select__helper" id={helperId}>{helperText}</span>}
</div>
