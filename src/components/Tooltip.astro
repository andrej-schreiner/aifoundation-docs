---
import { keepWholeParts } from '../shared/lib/displayFormat';

// Hover and focus tooltip, styled as Scale's scale-tooltip. Styles live in
// src/styles/tooltip.css, shared with Button's successTooltip and the model
// table's rows.
interface Props {
  text: string;
  /** Widest the tooltip may get; it also never leaves its container. */
  maxWidth?: string;
  /**
   * `top` (centred above), `bottom` (centred below, for a table header, whose
   * scroll container would cut off a tooltip above) or `right-center`
   * (beside, for a table row).
   */
  position?: 'top' | 'bottom' | 'right-center';
  /**
   * `false` when the slot is already focusable (a button, a link): the
   * trigger then adds no tab stop of its own, and the slot's focus still
   * shows the tooltip.
   */
  focusable?: boolean;
}

const { text, maxWidth = '20rem', position = 'top', focusable = true } = Astro.props;
// Unique id per instance so the tooltip content can be linked to its trigger
// via `aria-describedby`, exposing the text to screen readers.
const tipId = Math.random().toString(36).slice(2, 10);
---

<span class="ui-tooltip" style={`--aifs-tooltip-max-width: ${maxWidth};`}>
  <span class="ui-tooltip__trigger" tabindex={focusable ? 0 : undefined} aria-describedby={`ui-tooltip-${tipId}`}>
    <slot />
  </span>
  <span
    class:list={[
      'aifs-tooltip',
      'ui-tooltip__content',
      { 'aifs-tooltip--right': position === 'right-center', 'aifs-tooltip--bottom': position === 'bottom' },
    ]}
    id={`ui-tooltip-${tipId}`}
    role="tooltip">
    {/* "T-Cloud" in a .nowrap span, so it never breaks at its hyphen. */}
    {keepWholeParts(text).map((part) => (part.whole ? <span class="nowrap">{part.text}</span> : part.text))}
  </span>
</span>

<script>
  // WCAG 1.4.13: Escape hides the tooltip under the pointer or focus until
  // the pointer leaves or focus moves on. Delegated, so it also covers the
  // tooltips the model table builds in a script.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll('.ui-tooltip:hover, .ui-tooltip:focus-within').forEach((tip) => {
      tip.classList.add('ui-tooltip--dismissed');
    });
  });
  // Only when the pointer or focus really leaves the tooltip, not when it
  // moves between elements inside it.
  const reset = (event: MouseEvent | FocusEvent) => {
    const tip = (event.target as Element | null)?.closest?.('.ui-tooltip');
    if (tip && !tip.contains(event.relatedTarget as Node | null)) {
      tip.classList.remove('ui-tooltip--dismissed');
    }
  };
  document.addEventListener('mouseout', reset);
  document.addEventListener('focusout', reset);

  // Keep a tooltip inside the content area (main, else the window): measure
  // it once shown and shift it along its axis, as floating-ui's shift does in
  // Scale. Placements beside the trigger are left alone.
  const GUTTER = 8;
  const place = (event: MouseEvent | FocusEvent) => {
    const tip = (event.target as Element | null)?.closest?.('.ui-tooltip');
    const box = tip?.querySelector<HTMLElement>(':scope > .aifs-tooltip:not(.aifs-tooltip--right)');
    // Only on entering, not on moving between elements inside it.
    if (!tip || !box || tip.contains(event.relatedTarget as Node | null)) return;
    box.style.setProperty('--aifs-tooltip-shift', '0px');
    requestAnimationFrame(() => {
      const r = box.getBoundingClientRect();
      if (!r.width) return;
      // The nearest scroll container (a table's) would cut it off, so that
      // comes first; otherwise the content area.
      let scroller: Element | null = tip.parentElement;
      while (scroller && scroller !== document.body && getComputedStyle(scroller).overflowX === 'visible') {
        scroller = scroller.parentElement;
      }
      const area = (scroller && scroller !== document.body ? scroller : tip.closest('main'))?.getBoundingClientRect();
      const min = Math.max(area?.left ?? 0, 0) + GUTTER;
      const max = Math.min(area?.right ?? innerWidth, innerWidth) - GUTTER;
      const shift = r.left < min ? min - r.left : r.right > max ? max - r.right : 0;
      box.style.setProperty('--aifs-tooltip-shift', `${Math.round(shift)}px`);
    });
  };
  document.addEventListener('mouseover', place);
  document.addEventListener('focusin', place);
</script>
