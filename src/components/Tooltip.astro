---
interface Props {
  text: string;
  maxWidth?: string;
  position?: 'top' | 'right-center';
}

const { text, maxWidth = '24rem', position = 'top' } = Astro.props;
// Unique id per instance so the tooltip content can be linked to its trigger
// via `aria-describedby`, exposing the text to screen readers.
const tipId = Math.random().toString(36).slice(2, 10);
---

<span class={`ui-tooltip ui-tooltip--${position}`} style={`--ui-tooltip-max-width: ${maxWidth};`}>
  <span class="ui-tooltip__trigger" tabindex="0" aria-describedby={`ui-tooltip-${tipId}`}>
    <slot />
  </span>
  <span class="ui-tooltip__content" id={`ui-tooltip-${tipId}`} role="tooltip">
    {text}
  </span>
</span>

<style>
  .ui-tooltip {
    position: relative;
    display: inline-flex;
    justify-content: center;
    vertical-align: middle;
    outline: none;
  }

  .ui-tooltip__trigger {
    display: inline-flex;
  }

  .ui-tooltip__content {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.85rem);
    transform: translateX(-50%) translateY(0.35rem);
    width: max-content;
    max-width: min(var(--ui-tooltip-max-width), calc(100vw - 2rem));
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--aifs-color-tooltip-background);
    color: var(--aifs-color-tooltip-text);
    font-size: 0.95rem;
    line-height: 1.35;
    white-space: normal;
    text-align: left;
    /* TODO(token-gap): Telekom shadow tokens are not converted yet. */
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.26);
    /* Hidden via display:none (not visibility) so the max-content box doesn't
       contribute invisible horizontal overflow to the page. allow-discrete +
       @starting-style keep the fade; older engines just show/hide instantly. */
    display: none;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      display 160ms allow-discrete;
    z-index: 30;
  }

  .ui-tooltip__content::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.45rem;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--aifs-color-tooltip-background);
    transform: translateX(-50%) rotate(45deg);
    border-radius: 0.1rem;
  }

  .ui-tooltip:hover .ui-tooltip__content,
  .ui-tooltip__trigger:focus-visible ~ .ui-tooltip__content,
  .ui-tooltip:focus-within .ui-tooltip__content {
    display: block;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @starting-style {
    .ui-tooltip:hover .ui-tooltip__content,
    .ui-tooltip__trigger:focus-visible ~ .ui-tooltip__content,
    .ui-tooltip:focus-within .ui-tooltip__content {
      opacity: 0;
      transform: translateX(-50%) translateY(0.35rem);
    }
  }

  .ui-tooltip__trigger:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .ui-tooltip--right-center .ui-tooltip__content {
    left: calc(100% + 0.85rem);
    top: 50%;
    bottom: auto;
    transform: translateY(-50%) translateX(-0.35rem);
  }

  .ui-tooltip--right-center .ui-tooltip__content::after {
    left: -0.45rem;
    top: 50%;
    bottom: auto;
    transform: translateY(-50%) rotate(45deg);
  }

  .ui-tooltip--right-center:hover .ui-tooltip__content,
  .ui-tooltip--right-center .ui-tooltip__trigger:focus-visible ~ .ui-tooltip__content,
  .ui-tooltip--right-center:focus-within .ui-tooltip__content {
    transform: translateY(-50%) translateX(0);
  }

  @starting-style {
    .ui-tooltip--right-center:hover .ui-tooltip__content,
    .ui-tooltip--right-center .ui-tooltip__trigger:focus-visible ~ .ui-tooltip__content,
    .ui-tooltip--right-center:focus-within .ui-tooltip__content {
      opacity: 0;
      transform: translateY(-50%) translateX(-0.35rem);
    }
  }

  @media (max-width: 900px) {
    .ui-tooltip__content {
      font-size: 0.9rem;
      padding: 0.65rem 0.85rem;
    }
  }
</style>
