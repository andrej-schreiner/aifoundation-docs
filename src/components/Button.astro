---
// Button with Scale's API (scale-button): variant, size, icon only, link or
// button. Styles live in src/styles/button.css.
//
// Success state: put what the button shows after it worked (for a copy
// button, a tick) into the `success` slot, then set data-state="success" on
// the button from a script, and remove it again after a moment. Announce the
// result in a live region too: the swap alone is only visual.
// successTooltip adds a Scale-style tooltip that shows during that state,
// such as "Copied: GLM-5.3"; it is hidden from screen readers, which hear
// the live region instead.
import type { HTMLAttributes } from 'astro/types';

type Props = {
	variant?: 'primary' | 'secondary' | 'ghost';
	/** Scale's sizes: large (44px, the default) and small (32px). */
	size?: 'large' | 'small';
	/** Only an icon in the slot: the label must then come from ariaLabel. */
	iconOnly?: boolean;
	/** Renders a link instead of a button. */
	href?: string;
	disabled?: boolean;
	type?: 'button' | 'submit' | 'reset';
	ariaLabel?: string;
	/** Tooltip shown while data-state="success" is set. */
	successTooltip?: string;
	/** `top` (centred) or `top-end` (end edges aligned, for a button in a corner). */
	tooltipPlacement?: 'top' | 'top-end';
	class?: string;
} & Omit<HTMLAttributes<'button'> & HTMLAttributes<'a'>, 'type' | 'class' | 'disabled'>;

const {
	variant = 'primary',
	size = 'large',
	iconOnly = false,
	href,
	disabled = false,
	type = 'button',
	ariaLabel,
	successTooltip,
	tooltipPlacement = 'top',
	class: className,
	...rest
} = Astro.props;

const classes = [
	'aifs-button',
	`aifs-button--${variant}`,
	size === 'small' && 'aifs-button--small',
	iconOnly && 'aifs-button--icon-only',
	className,
];

const hasSuccess = Astro.slots.has('success');
---

{
	href ? (
		// A disabled link has no href, so it cannot be followed or focused by Tab.
		<a
			class:list={classes}
			href={disabled ? undefined : href}
			aria-disabled={disabled ? 'true' : undefined}
			aria-label={ariaLabel}
			role={disabled ? 'link' : undefined}
			{...rest}
		>
			<slot />
		</a>
	) : (
		<button class:list={classes} type={type} disabled={disabled} aria-label={ariaLabel} {...rest}>
			{hasSuccess ? (
				<>
					<span class="aifs-button__content">
						<slot />
					</span>
					<span class="aifs-button__success">
						<slot name="success" />
					</span>
				</>
			) : (
				<slot />
			)}
			{successTooltip && (
				<span class:list={['aifs-tooltip', tooltipPlacement === 'top-end' && 'aifs-tooltip--top-end']} aria-hidden="true">
					{successTooltip}
				</span>
			)}
		</button>
	)
}
