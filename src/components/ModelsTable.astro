---
import Selector from './Selector.astro';
import TextField from './TextField.astro';

import 'flag-icons/css/flag-icons.min.css';

interface Props {
  plansData: any[];
  effectiveIndex: number;
  locked: boolean;
  translations: Record<string, string> & { modelsSubtitleList?: string[] };
  modelBrandIcons: Record<string, string>;
  hostTooltips: Record<string, string>;
  tierTooltips: Record<string, string>;
  creatorTooltips: Record<string, string>;
  testModelsSectionTitle?: string;
  legacy?: boolean;
}

const {
  plansData,
  effectiveIndex,
  locked,
  translations,
  modelBrandIcons,
  hostTooltips,
  tierTooltips,
  creatorTooltips,
  testModelsSectionTitle,
  legacy = false,
} = Astro.props;

const sortableHeaders = [
  { key: 'modelHost', label: translations.thModelHost },
  { key: 'cloudProvider', label: translations.thCloudProvider },
  ...(legacy ? [] : [{ key: 'modelTier', label: translations.thModelTier }]),
  { key: 'creator', label: translations.thCreator },
  { key: 'displayName', label: translations.thModelName },
  { key: 'inputPrice', label: translations.thInputPrice, unit: 'M Tokens' },
  { key: 'outputPrice', label: translations.thOutputPrice, unit: 'M Tokens' },
  { key: 'serverLocation', label: translations.thServerLocation },
  { key: 'rpm', label: translations.thRPMLimit, unit: translations.thRPMUnitShort },
  { key: 'tpm', label: translations.thTPM, unit: translations.thTPMUnit },
  ...(legacy ? [] : [{ key: 'contextWindow', label: translations.thContextWindow, unit: translations.thContextWindowUnit }]),
];

const totalColumnCount = sortableHeaders.length + (legacy ? 0 : 1);

// Price filter buckets are static (don't depend on plan), so we can SSR them.
const priceBuckets = [
  { value: '0-2', label: translations.priceUnder2 },
  { value: '2-5', label: translations.price2to5 },
  { value: '5+', label: translations.priceOver5 },
];
---

<section
  class="models-section models-table-section"
  data-plans={JSON.stringify(plansData)}
  data-brand-icons={JSON.stringify(modelBrandIcons)}
  data-host-tooltips={JSON.stringify(hostTooltips)}
  data-tier-tooltips={JSON.stringify(tierTooltips)}
  data-creator-tooltips={JSON.stringify(creatorTooltips)}
  data-initial-index={effectiveIndex}
  data-locked={locked ? 'true' : 'false'}
  data-legacy={legacy ? 'true' : 'false'}
  data-total-columns={totalColumnCount}
  data-t={JSON.stringify(translations)}>
  <h2>{testModelsSectionTitle || translations.modelsTitle}</h2>
  <p class="par-description">
    {!testModelsSectionTitle && translations.modelsSubtitle}
  </p>
  <div>
    {
      testModelsSectionTitle &&
        translations.modelsSubtitleList &&
        translations.modelsSubtitleList.map((item) => (
          <div
            class="par-description"
            style={`margin-top: 0;${item[0] === '\n' ? 'margin-top: 1em;font-weight: bold;' : ''}`}>
            {item}
          </div>
        ))
    }
  </div>

  <div class="models-controls">
    {
      !locked && (
        <Selector id="plan-selector" label={translations.labelRatePlan}>
          {plansData
            .filter((plan: any) => plan.isFilterAvailable)
            .map((plan: any, index: number) => (
              <option value={index} selected={index === effectiveIndex}>
                {plan.label}
              </option>
            ))}
        </Selector>
      )
    }
    <TextField id="model-search" label={translations.labelSearch} placeholder={translations.placeholderSearch} />
  </div>

  {
    legacy ? (
      <div class="models-controls">
        {/* Legacy plans page keeps its native-select filters. */}
        <Selector id="location-filter" label={translations.labelServerLocation}>
          <option value="">{translations.optionAll}</option>
        </Selector>
        <Selector id="cloud-filter" label={translations.labelCloud}>
          <option value="">{translations.optionAll}</option>
        </Selector>
        <Selector id="input-price-filter" label={translations.labelInputPriceRange || translations.thInputPrice}>
          <option value="">{translations.optionAll}</option>
          <option value="0-2">{translations.priceUnder2}</option>
          <option value="2-5">{translations.price2to5}</option>
          <option value="5+">{translations.priceOver5}</option>
        </Selector>
        <Selector id="output-price-filter" label={translations.labelOutputPriceRange || translations.thOutputPrice}>
          <option value="">{translations.optionAll}</option>
          <option value="0-2">{translations.priceUnder2}</option>
          <option value="2-5">{translations.price2to5}</option>
          <option value="5+">{translations.priceOver5}</option>
        </Selector>
      </div>
    ) : (
      <div class="plans-filterbar" role="group" aria-label={translations.modelsTitle}>
        <details class="plans-filter" data-filter="location">
          <summary aria-label={translations.labelServerLocation}>
            <span class="plans-filter__label">{translations.labelServerLocation}</span>
            <span class="plans-filter__count" data-count />
          </summary>
          <div class="plans-filter__menu" data-options>
            {/* Options populated by client script — depend on selected plan. */}
          </div>
        </details>

        <details class="plans-filter" data-filter="cloud">
          <summary aria-label={translations.labelCloud}>
            <span class="plans-filter__label">{translations.labelCloud}</span>
            <span class="plans-filter__count" data-count />
          </summary>
          <div class="plans-filter__menu" data-options />
        </details>

        <details class="plans-filter" data-filter="tier">
          <summary aria-label={translations.labelModelTier || translations.thModelTier}>
            <span class="plans-filter__label">{translations.labelModelTier || translations.thModelTier}</span>
            <span class="plans-filter__count" data-count />
          </summary>
          <div class="plans-filter__menu" data-options />
        </details>

        <details class="plans-filter" data-filter="inputPrice">
          <summary aria-label={translations.labelInputPriceRange || translations.thInputPrice}>
            <span class="plans-filter__label">{translations.labelInputPriceRange || translations.thInputPrice}</span>
            <span class="plans-filter__count" data-count />
          </summary>
          <div class="plans-filter__menu">
            {priceBuckets.map((b) => (
              <label class="plans-filter__option">
                <input type="checkbox" value={b.value} checked />
                <span>{b.label}</span>
              </label>
            ))}
          </div>
        </details>

        <details class="plans-filter" data-filter="outputPrice">
          <summary aria-label={translations.labelOutputPriceRange || translations.thOutputPrice}>
            <span class="plans-filter__label">{translations.labelOutputPriceRange || translations.thOutputPrice}</span>
            <span class="plans-filter__count" data-count />
          </summary>
          <div class="plans-filter__menu">
            {priceBuckets.map((b) => (
              <label class="plans-filter__option">
                <input type="checkbox" value={b.value} checked />
                <span>{b.label}</span>
              </label>
            ))}
          </div>
        </details>

        <button type="button" class="plans-filter-reset" data-reset aria-label="Reset all filters">
          {translations.labelResetFilters || 'Reset filters'}
        </button>
      </div>
    )
  }

  {
    !legacy && (
      <div class="plans-filter-status" aria-live="polite">
        <span data-status-text>
          {translations.showingPrefix || 'Showing'} <span data-visible-count>0</span>{' '}
          {translations.ofPrefix || 'of'} <span data-total-count>0</span>{' '}
          {translations.modelsLabel || 'models'}
        </span>
      </div>
    )
  }

  <div class="table-wrapper">
    <table class="plans-table" id="models-table">
      <thead>
        <tr>
          {
            sortableHeaders.map((header) => (
              <th data-sort={header.key}>
                <span class="sort-header">
                  <svg class="sort-icon" viewBox="0 0 7 5" fill="none" aria-hidden="true">
                    <path d="M3.46411 4.5L8.97647e-06 -1.75695e-07L6.92821 4.29987e-07L3.46411 4.5Z" />
                  </svg>
                  <span>
                    {header.label}
                    {header.unit && <div class="plans-table__small-text">{header.unit}</div>}
                  </span>
                </span>
              </th>
            ))
          }
          {!legacy && <th>{translations.thLinks}</th>}
        </tr>
      </thead>
      <tbody id="models-tbody">
        <!-- Populated by client-side script -->
      </tbody>
    </table>
  </div>
  <small>* EU/EEA includes countries with an adequacy decision by the EU Commission.</small>
</section>

<script>
  import { isPriceInRange } from '../shared/lib/priceRangeHelper';

  type FilterState = Map<string, Set<string>>;

  function initModelsTable(section: HTMLElement) {
    const plansData = JSON.parse(section.dataset.plans || '[]');
    const brandIcons = JSON.parse(section.dataset.brandIcons || '{}');
    const hostTooltips = JSON.parse(section.dataset.hostTooltips || '{}');
    const tierTooltips = JSON.parse(section.dataset.tierTooltips || '{}');
    const creatorTooltips = JSON.parse(section.dataset.creatorTooltips || '{}');
    const translations = JSON.parse(section.dataset.t || '{}');
    let currentIndex = parseInt(section.dataset.initialIndex || '0', 10);
    const locked = section.dataset.locked === 'true';
    const legacy = section.dataset.legacy === 'true';
    const totalColumns = parseInt(section.dataset.totalColumns || '12', 10);

    const selector = section.querySelector<HTMLSelectElement>('#plan-selector');
    const searchInput = section.querySelector<HTMLInputElement>('#model-search');
    // Legacy native-select filters (only rendered when legacy === true)
    const locationFilter = section.querySelector<HTMLSelectElement>('select#location-filter');
    const cloudFilter = section.querySelector<HTMLSelectElement>('select#cloud-filter');
    const inputPriceFilter = section.querySelector<HTMLSelectElement>('select#input-price-filter');
    const outputPriceFilter = section.querySelector<HTMLSelectElement>('select#output-price-filter');
    const tbody = section.querySelector<HTMLTableSectionElement>('#models-tbody');
    const table = section.querySelector<HTMLTableElement>('#models-table');
    const tableWrapper = section.querySelector<HTMLElement>('.table-wrapper');
    const visibleCountEl = section.querySelector<HTMLElement>('[data-visible-count]');
    const totalCountEl = section.querySelector<HTMLElement>('[data-total-count]');
    const maxHeightRowThreshold = 12;

    // Default sort: cloudProvider with custom rank (Telekom > Azure > GCP),
    // ascending — i.e. Telekom rows at the top. Replaces the old
    // Telekom-only filter default.
    let sortKey = 'cloudProvider';
    let sortAsc = true;
    let searchTerm = '';

    // --- Legacy path: keep the old native-select filter UI ---

    function populateLegacyFilterDropdowns() {
      const plan = plansData[currentIndex];
      if (!plan) return;

      const locations = new Set<string>();
      const clouds = new Set<string>();
      for (const model of plan.models) {
        if (model.serverLocation) locations.add(model.serverLocation);
        if (model.cloudProvider) clouds.add(model.cloudProvider);
      }

      if (locationFilter) {
        const current = locationFilter.value;
        locationFilter.innerHTML = `<option value="">${translations.optionAll || 'All'}</option>`;
        [...locations].sort().forEach((location) => {
          const option = document.createElement('option');
          option.value = location;
          option.textContent = location;
          if (location === current) option.selected = true;
          locationFilter.appendChild(option);
        });
      }

      if (cloudFilter) {
        const current = cloudFilter.value;
        cloudFilter.innerHTML = `<option value="">${translations.optionAll || 'All'}</option>`;
        [...clouds].sort().forEach((cloud) => {
          const option = document.createElement('option');
          option.value = cloud;
          option.textContent = cloud;
          if (cloud === current) option.selected = true;
          cloudFilter.appendChild(option);
        });
      }
    }

    // --- Multi-select path: <details>+checkbox chips ---

    // Filter id -> { checked: Set<string>, wasAllChecked: boolean }; preserved
    // across plan changes so user selections survive plan switches. We track
    // "was all checked" separately because if the user never narrowed a
    // filter, switching to a plan with new values shouldn't accidentally
    // exclude those new values (no constraint → still no constraint).
    interface PrevFilter {
      checked: Set<string>;
      wasAllChecked: boolean;
    }
    const filterStatePrev = new Map<string, PrevFilter>();

    function getPlanFilterValues(): Record<string, string[]> {
      const plan = plansData[currentIndex];
      if (!plan) return { location: [], cloud: [], tier: [] };
      const locations = new Set<string>();
      const clouds = new Set<string>();
      const tiers = new Set<string>();
      for (const model of plan.models) {
        if (model.serverLocation) locations.add(model.serverLocation);
        if (model.cloudProvider) clouds.add(model.cloudProvider);
        if (model.modelTier) tiers.add(model.modelTier);
      }
      return {
        location: [...locations].sort(),
        cloud: ['Telekom', 'Azure', 'GCP', 'Other'].filter((c) => clouds.has(c)).concat(
          [...clouds].filter((c) => !['Telekom', 'Azure', 'GCP', 'Other'].includes(c)).sort(),
        ),
        tier: [...tiers].sort(),
      };
    }

    function renderFilterOptions(filterId: string, values: string[], labelFn: (v: string) => string) {
      const details = section.querySelector<HTMLElement>(`.plans-filter[data-filter="${filterId}"]`);
      if (!details) return;
      const menu = details.querySelector<HTMLElement>('[data-options]');
      if (!menu) return;

      // Decide which values should be checked:
      //  - If we previously had no constraint (all checked), keep no constraint.
      //  - If we have a narrowed prev state with overlap, preserve it.
      //  - Otherwise: default to all-checked (no constraint). Telekom-first
      //    positioning is achieved via the default sort (sortKey =
      //    'cloudProvider') rather than a filter.
      const prev = filterStatePrev.get(filterId);
      let checkedFn: (v: string) => boolean;
      if (prev?.wasAllChecked) {
        checkedFn = () => true;
      } else if (prev && values.some((v) => prev.checked.has(v))) {
        checkedFn = (v) => prev.checked.has(v);
      } else {
        checkedFn = () => true;
      }

      // If after applying checkedFn nothing is checked, fall back to
      // all-checked so we don't start in a zero-row state.
      if (!values.some((v) => checkedFn(v))) {
        checkedFn = () => true;
      }

      menu.innerHTML = values
        .map(
          (v) => `
            <label class="plans-filter__option">
              <input type="checkbox" value="${escapeHtml(v)}"${checkedFn(v) ? ' checked' : ''} />
              <span>${escapeHtml(labelFn(v))}</span>
            </label>
          `,
        )
        .join('');
    }

    function rebuildDynamicFilters() {
      const { location, cloud, tier } = getPlanFilterValues();
      renderFilterOptions('location', location, (v) => v);
      renderFilterOptions('cloud', cloud, (v) => v);
      renderFilterOptions('tier', tier, (v) => v.charAt(0).toUpperCase() + v.slice(1));
    }

    function readFilterState(): FilterState {
      const state: FilterState = new Map();
      section.querySelectorAll<HTMLElement>('.plans-filter').forEach((details) => {
        const id = details.dataset.filter;
        if (!id) return;
        const checked = new Set<string>();
        details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => {
          if (input.checked) checked.add(input.value);
        });
        state.set(id, checked);
      });
      return state;
    }

    function persistFilterState() {
      section.querySelectorAll<HTMLElement>('.plans-filter').forEach((details) => {
        const id = details.dataset.filter;
        if (!id) return;
        const all = details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
        const checked = new Set<string>();
        all.forEach((input) => {
          if (input.checked) checked.add(input.value);
        });
        filterStatePrev.set(id, {
          checked,
          wasAllChecked: all.length > 0 && checked.size === all.length,
        });
      });
    }

    // Locale read from <html lang> (set by Starlight per page) so the
    // aria-label uses the same language as the visible chip label.
    const isDE = document.documentElement.lang === 'de';

    function updateChipCounts() {
      section.querySelectorAll<HTMLElement>('.plans-filter').forEach((details) => {
        const all = details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
        const checked = details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked');
        const countEl = details.querySelector<HTMLElement>('[data-count]');
        const isAll = all.length === 0 || checked.length === all.length;
        if (countEl) {
          countEl.textContent = isAll ? '' : `(${checked.length}/${all.length})`;
        }
        details.classList.toggle('plans-filter--active', all.length > 0 && !isAll);

        // Mirror the visible (N/M) into a screen-reader-friendly aria-label
        // on the <summary> so AT users hear "Cloud filter, 1 of 3 selected"
        // (or the German equivalent) instead of "Cloud, 1, 3". When no chip
        // is active we fall back to the plain label set in SSR.
        const summary = details.querySelector<HTMLElement>('summary');
        const labelEl = details.querySelector<HTMLElement>('.plans-filter__label');
        if (summary && labelEl) {
          const label = (labelEl.textContent || '').trim();
          if (isAll) {
            // Restore the static SSR label (which is just the filter name).
            summary.setAttribute('aria-label', label);
          } else {
            summary.setAttribute(
              'aria-label',
              isDE
                ? `Filter ${label}, ${checked.length} von ${all.length} ausgewählt`
                : `${label} filter, ${checked.length} of ${all.length} selected`,
            );
          }
        }
      });
    }

    function resetAllFilters() {
      section.querySelectorAll<HTMLElement>('.plans-filter').forEach((details) => {
        details
          .querySelectorAll<HTMLInputElement>('input[type="checkbox"]')
          .forEach((input) => {
            input.checked = true;
          });
      });
      persistFilterState();
      render();
    }

    function applyPriceFilter(models: any[], filterValue: string, getPrice: (model: any) => number | null | undefined) {
      if (!filterValue) return models;

      if (filterValue === '0-2') {
        return models.filter((model) => isPriceInRange(getPrice(model), 0, 2));
      }

      if (filterValue === '2-5') {
        return models.filter((model) => isPriceInRange(getPrice(model), 2, 5));
      }

      if (filterValue === '5+') {
        return models.filter((model) => isPriceInRange(getPrice(model), 5));
      }

      return models;
    }

    function priceBucketFor(price: number | null | undefined): string | null {
      if (price == null) return null;
      if (isPriceInRange(price, 0, 2)) return '0-2';
      if (isPriceInRange(price, 2, 5)) return '2-5';
      if (isPriceInRange(price, 5)) return '5+';
      return null;
    }

    function passesMultiSelect(value: string, checked: Set<string>): boolean {
      // Defensive: empty checked set means "no constraint". Auto-revert
      // normally prevents this state, but treat as pass-all just in case.
      if (checked.size === 0) return true;
      return checked.has(value);
    }

    function getModels() {
      const plan = plansData[currentIndex];
      if (!plan) return [];
      let models = [...plan.models];

      if (searchTerm) {
        const term = searchTerm.toLowerCase();
        models = models.filter(
          (model) =>
            model.displayName.toLowerCase().includes(term) ||
            model.subName.toLowerCase().includes(term) ||
            model.modelHost.toLowerCase().includes(term) ||
            model.cloudProvider.toLowerCase().includes(term) ||
            model.modelTier.toLowerCase().includes(term) ||
            model.creator.toLowerCase().includes(term) ||
            model.serverLocation.toLowerCase().includes(term),
        );
      }

      if (legacy) {
        if (locationFilter && locationFilter.value) {
          models = models.filter((model) => model.serverLocation === locationFilter.value);
        }
        if (cloudFilter && cloudFilter.value) {
          models = models.filter((model) => model.cloudProvider === cloudFilter.value);
        }
        if (inputPriceFilter) {
          models = applyPriceFilter(models, inputPriceFilter.value, (model) => model.inputPrice);
        }
        if (outputPriceFilter) {
          models = applyPriceFilter(models, outputPriceFilter.value, (model) => model.outputPrice);
        }
      } else {
        const state = readFilterState();
        const locationChecked = state.get('location');
        const cloudChecked = state.get('cloud');
        const tierChecked = state.get('tier');
        const inputPriceChecked = state.get('inputPrice');
        const outputPriceChecked = state.get('outputPrice');

        if (locationChecked && locationChecked.size > 0) {
          models = models.filter((model) => passesMultiSelect(model.serverLocation, locationChecked));
        }
        if (cloudChecked && cloudChecked.size > 0) {
          models = models.filter((model) => passesMultiSelect(model.cloudProvider, cloudChecked));
        }
        if (tierChecked && tierChecked.size > 0) {
          models = models.filter((model) => passesMultiSelect(model.modelTier, tierChecked));
        }
        if (inputPriceChecked && inputPriceChecked.size > 0) {
          models = models.filter((model) => {
            const bucket = priceBucketFor(model.inputPrice);
            // A row with no price (null) passes — we can't bucket it. This
            // matches the legacy behavior where the price filter only excluded
            // rows whose price fell outside the selected range.
            if (!bucket) return true;
            return inputPriceChecked.has(bucket);
          });
        }
        if (outputPriceChecked && outputPriceChecked.size > 0) {
          models = models.filter((model) => {
            const bucket = priceBucketFor(model.outputPrice);
            if (!bucket) return true;
            return outputPriceChecked.has(bucket);
          });
        }
      }

      if (sortKey) {
        models.sort((left, right) => {
          // Cloud column uses a fixed priority order (Telekom > Azure > GCP >
          // others) instead of alphabetical, so "sort by cloud" produces the
          // product's flagship ordering rather than A → Z. Secondary sort by
          // displayName keeps ties stable and readable.
          if (sortKey === 'cloudProvider') {
            const RANK: Record<string, number> = { Telekom: 0, Azure: 1, GCP: 2 };
            const lr = RANK[normalizeCloudProvider(left.cloudProvider)] ?? 99;
            const rr = RANK[normalizeCloudProvider(right.cloudProvider)] ?? 99;
            if (lr !== rr) return sortAsc ? lr - rr : rr - lr;
            const lname = (left.displayName || '').toLowerCase();
            const rname = (right.displayName || '').toLowerCase();
            if (lname < rname) return -1;
            if (lname > rname) return 1;
            return 0;
          }
          let leftValue = left[sortKey];
          let rightValue = right[sortKey];
          if (typeof leftValue === 'number' && typeof rightValue === 'number') {
            return sortAsc ? leftValue - rightValue : rightValue - leftValue;
          }
          leftValue = String(leftValue).toLowerCase();
          rightValue = String(rightValue).toLowerCase();
          if (leftValue < rightValue) return sortAsc ? -1 : 1;
          if (leftValue > rightValue) return sortAsc ? 1 : -1;
          return 0;
        });
      }

      return models;
    }

    function formatNumber(value: number | null | undefined) {
      return value != null ? value.toLocaleString('en-US') : '-';
    }

    function formatPrice(value: number | null | undefined) {
      return value != null ? value.toFixed(2) : '-';
    }

    function capitalize(value: string = '') {
      return value.charAt(0).toUpperCase() + value.slice(1);
    }

    function escapeHtml(value: string | number) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getCloudProviderTagClass(value: string) {
      return normalizeCloudProvider(value) === 'Telekom' ? 'tag-tcloud' : 'tag-external-cloud';
    }

    function normalizeCloudProvider(value: string) {
      return value === 'Open Telekom Cloud' || value === 'OTC' ? 'Telekom' : value;
    }

    function getCloudProviderFullName(value: string) {
      const normalized = normalizeCloudProvider(value);
      if (normalized === 'Telekom') return 'T-Cloud Public';
      if (normalized === 'Azure') return 'Microsoft Azure';
      if (normalized === 'GCP') return 'Google Cloud Platform';
      return normalized;
    }

    function render() {
      if (!tbody) return;
      const plan = plansData[currentIndex];
      const totalRows = plan ? plan.models.length : 0;
      const models = getModels();
      tbody.innerHTML = '';

      for (const model of models) {
        const row = document.createElement('tr');
        if (model.isSubRow) row.classList.add('sub-row');

        const modelTier = capitalize(model.modelTier);

        const hostClass = model.modelHost?.toLowerCase() === 't-cloud' ? 'tag-tcloud' : 'tag-cloud';
        const tierClass = modelTier.toLowerCase() === 'premium' ? 'tag-premium' : 'tag-tier';
        const cloudProvider = normalizeCloudProvider(model.cloudProvider);
        const cloudProviderFullName = getCloudProviderFullName(model.cloudProvider);
        const cloudProviderClass = getCloudProviderTagClass(model.cloudProvider);
        const hostTooltip = hostTooltips[model.modelHost] || '';
        const tierTooltip = tierTooltips[modelTier] || '';
        const creatorIcon = brandIcons[model.creator] || '';
        const creatorTooltip = creatorTooltips[model.creator] || creatorTooltips['Other'] || model.creator;
        row.innerHTML = `
          <td>${hostTooltip ? `<span class="ui-tooltip ui-tooltip--right-center" style="--ui-tooltip-max-width: 26rem;"><span class="ui-tooltip__trigger"><span class="plans-tag ${hostClass}">${escapeHtml(model.modelHost)}</span></span><span class="ui-tooltip__content" role="tooltip">${escapeHtml(hostTooltip)}</span></span>` : `<span class="plans-tag ${hostClass}">${escapeHtml(model.modelHost)}</span>`}</td>
          <td><span class="ui-tooltip ui-tooltip--right-center" style="--ui-tooltip-max-width: 24rem;"><span class="ui-tooltip__trigger"><button type="button" class="plans-tag ${cloudProviderClass} mt-cloud-tag-btn" data-cloud="${escapeHtml(model.cloudProvider)}" title="${escapeHtml(cloudProviderFullName)} — click to toggle in filter" aria-label="Toggle ${escapeHtml(cloudProvider)} cloud in the filter">${escapeHtml(cloudProvider)}</button></span><span class="ui-tooltip__content" role="tooltip">${escapeHtml(cloudProviderFullName)}</span></span></td>
          ${legacy ? '' : `<td>${tierTooltip ? `<span class="ui-tooltip ui-tooltip--right-center" style="--ui-tooltip-max-width: 24rem;"><span class="ui-tooltip__trigger"><button type="button" class="plans-tag ${tierClass} mt-tier-tag-btn" data-tier="${escapeHtml(model.modelTier)}" title="${escapeHtml(tierTooltip || modelTier)} — click to toggle in filter" aria-label="Toggle ${escapeHtml(modelTier)} tier in the filter">${escapeHtml(modelTier)}</button></span><span class="ui-tooltip__content" role="tooltip">${escapeHtml(tierTooltip)}</span></span>` : `<button type="button" class="plans-tag ${tierClass} mt-tier-tag-btn" data-tier="${escapeHtml(model.modelTier)}" title="${escapeHtml(tierTooltip || modelTier)} — click to toggle in filter" aria-label="Toggle ${escapeHtml(modelTier)} tier in the filter">${escapeHtml(modelTier)}</button>`}</td>`}
          <td>
            <span class="ui-tooltip ui-tooltip--right-center" style="--ui-tooltip-max-width: 24rem;">
              <span class="ui-tooltip__trigger" tabindex="0">
                <span class="creator-brand ${creatorIcon ? 'creator-brand--icon' : 'creator-brand--text'}" aria-label="${escapeHtml(model.creator)}">
                  ${creatorIcon ? `<img class="creator-brand__icon" src="${escapeHtml(creatorIcon)}" alt="${escapeHtml(model.creator)}" />` : `<span class="creator-brand__label">${escapeHtml(model.creator)}</span>`}
                </span>
              </span>
              <span class="ui-tooltip__content" role="tooltip">${escapeHtml(creatorTooltip)}</span>
            </span>
          </td>
          <td>
            <div>
            <strong>${escapeHtml(model.displayName)}</strong>
            </div>
          </td>
          <td><strong>&euro; ${formatPrice(model.inputPrice)}</strong></td>
          <td><strong>&euro; ${formatPrice(model.outputPrice)}</strong></td>
          <td><div class="loc-wrapper">${model.locationCode ? `<span class="fi fi-${escapeHtml(model.locationCode)}"></span> ` : ''}${escapeHtml(model.serverLocation)}</div></td>
          <td>${formatNumber(model.rpm)}</td>
          <td>${formatNumber(model.tpm)}</td>
          ${legacy ? '' : `<td>${model.contextWindow != null ? formatNumber(model.contextWindow) : '-'}</td>`}
          ${legacy ? '' : `<td>
            <span class="model-links">
              ${model.termsOfUseUrl ? `<a href="${escapeHtml(model.termsOfUseUrl)}" class="model-links__item" target="_blank" rel="noreferrer noopener">${translations.linkTermsOfUse || 'Terms of Use'}<svg class="model-links__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3H21V10"/><path d="M21 3L10 14"/><path d="M11 5H6C4.89543 5 4 5.89543 4 7V18C4 19.1046 4.89543 20 6 20H17C18.1046 20 19 19.1046 19 18V13"/></svg></a>` : ''}
              ${model.dataProtectionUrl ? `<a href="${escapeHtml(model.dataProtectionUrl)}" class="model-links__item" target="_blank" rel="noreferrer noopener">${translations.linkDataProtection || 'Data Protection'}<svg class="model-links__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3H21V10"/><path d="M21 3L10 14"/><path d="M11 5H6C4.89543 5 4 5.89543 4 7V18C4 19.1046 4.89543 20 6 20H17C18.1046 20 19 19.1046 19 18V13"/></svg></a>` : ''}
              ${!model.termsOfUseUrl && !model.dataProtectionUrl ? '<span class="model-links__empty">-</span>' : ''}
            </span>
          </td>`}
        `;
        tbody.appendChild(row);
      }

      if (models.length === 0) {
        const row = document.createElement('tr');
        row.innerHTML = `<td colspan="${totalColumns}" style="text-align:center;padding:1rem;">${translations.noModels || 'No models found.'}</td>`;
        tbody.appendChild(row);
      }

      if (tableWrapper) {
        tableWrapper.classList.toggle('table-wrapper--auto-height', models.length < maxHeightRowThreshold);
      }

      if (table) {
        table.querySelectorAll<HTMLElement>('th[data-sort]').forEach((header: HTMLElement) => {
          const icon = header.querySelector<SVGElement>('.sort-icon');
          if (!icon) return;
          const key = header.dataset.sort || '';
          const isActive = key === sortKey;
          header.classList.toggle('sort-active', isActive);
          icon.classList.toggle('sort-icon--active', isActive);
          icon.classList.toggle('sort-icon--asc', isActive && sortAsc);
          icon.classList.toggle('sort-icon--desc', isActive && !sortAsc);
        });
      }

      if (!legacy) {
        if (visibleCountEl) visibleCountEl.textContent = String(models.length);
        if (totalCountEl) totalCountEl.textContent = String(totalRows);
        updateChipCounts();
      }
    }

    if (selector && !locked) {
      selector.addEventListener('change', () => {
        currentIndex = parseInt(selector.value, 10);
        if (legacy) {
          populateLegacyFilterDropdowns();
        } else {
          // Preserve user's checkbox state across plan changes, then rebuild
          // the option list for the new plan's available values.
          persistFilterState();
          rebuildDynamicFilters();
        }
        render();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchTerm = searchInput.value;
        render();
      });
    }

    if (legacy) {
      if (locationFilter) locationFilter.addEventListener('change', render);
      if (cloudFilter) cloudFilter.addEventListener('change', render);
      if (inputPriceFilter) inputPriceFilter.addEventListener('change', render);
      if (outputPriceFilter) outputPriceFilter.addEventListener('change', render);
    } else {
      // One delegated listener for every checkbox in the filter bar. Handles
      // the apply call AND the auto-revert (uncheck-last → re-check-all).
      section.addEventListener('change', (evt) => {
        const target = evt.target as HTMLElement | null;
        if (!(target instanceof HTMLInputElement) || target.type !== 'checkbox') return;
        const details = target.closest('.plans-filter') as HTMLElement | null;
        if (!details) return;
        const all = details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
        const anyChecked = Array.from(all).some((input) => input.checked);
        if (!anyChecked) {
          all.forEach((input) => {
            input.checked = true;
          });
        }
        render();
      });

      // Reset button removes ALL filters (every checkbox checked).
      const resetBtn = section.querySelector<HTMLButtonElement>('[data-reset]');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => resetAllFilters());
      }

      // Close open chips when clicking outside the filter bar.
      document.addEventListener('click', (evt) => {
        const target = evt.target as Node | null;
        section.querySelectorAll<HTMLDetailsElement>('details.plans-filter[open]').forEach((d) => {
          if (target && !d.contains(target)) d.open = false;
        });
      });
    }

    if (table) {
      table.querySelectorAll<HTMLElement>('th[data-sort]').forEach((header: HTMLElement) => {
        header.addEventListener('click', () => {
          const key = header.dataset.sort || '';
          if (sortKey === key) {
            sortAsc = !sortAsc;
          } else {
            sortKey = key;
            sortAsc = true;
          }
          render();
        });
      });
    }

    // Click-to-toggle on cloud / tier tags in rows. Multi-select semantics
    // (matches the comparison page): clicking a tag toggles its value in the
    // corresponding filter. Dispatches a synthetic 'change' event so the
    // existing listener handles apply + auto-revert in one place.
    section.addEventListener('click', (evt) => {
      const target = evt.target as HTMLElement | null;
      const cloudBtn = target?.closest('.mt-cloud-tag-btn') as HTMLElement | null;
      if (cloudBtn) {
        const value = cloudBtn.dataset.cloud ?? '';
        if (legacy) {
          if (cloudFilter) {
            // Legacy keeps the single-select narrow behavior.
            cloudFilter.value = cloudFilter.value === value ? '' : value;
            cloudFilter.dispatchEvent(new Event('change', { bubbles: true }));
          }
        } else {
          const checkbox = section.querySelector<HTMLInputElement>(
            `.plans-filter[data-filter="cloud"] input[type="checkbox"][value="${value}"]`,
          );
          if (checkbox) {
            checkbox.checked = !checkbox.checked;
            checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
        return;
      }
      const tierBtn = target?.closest('.mt-tier-tag-btn') as HTMLElement | null;
      if (tierBtn && !legacy) {
        const value = tierBtn.dataset.tier ?? '';
        const checkbox = section.querySelector<HTMLInputElement>(
          `.plans-filter[data-filter="tier"] input[type="checkbox"][value="${value}"]`,
        );
        if (checkbox) {
          checkbox.checked = !checkbox.checked;
          checkbox.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    });

    if (legacy) {
      populateLegacyFilterDropdowns();
    } else {
      rebuildDynamicFilters();
    }
    render();
  }

  function initAllModelsTables() {
    document
      .querySelectorAll<HTMLElement>('.models-table-section')
      .forEach((section: HTMLElement) => initModelsTable(section));
  }

  document.addEventListener('astro:page-load', initAllModelsTables);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllModelsTables);
  } else {
    initAllModelsTables();
  }
</script>

