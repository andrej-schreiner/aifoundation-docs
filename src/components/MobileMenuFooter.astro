---
// Site part, not for reuse. Starlight's MobileMenuFooter slot: version, theme
// and language selects at the bottom of the phone menu, after the SmartChat
// and Service Description links (in the header from 50rem), drawn as sidebar
// entries, with the sidebar's external-link icon (icons.css).
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import VersionSelect from './VersionSelect.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const smartchatHref = isDE ? '/de/smartchat/overview/' : '/smartchat/overview/';
const smartchatAria = isDE ? 'SmartChat (öffnet in neuem Tab)' : 'SmartChat (opens in a new tab)';
const sdLabel = isDE ? 'Leistungsbeschreibung' : 'Service Description';
const sdHref = isDE
	? '/files/Leistungsbeschreibung-LLM-Serving-Service.pdf'
	: '/files/Leistungsbeschreibung_LLM_Serving-Service_EN.pdf';
const sdAria = isDE
	? 'Leistungsbeschreibung, PDF (öffnet in neuem Tab)'
	: 'Service Description PDF (opens in a new tab)';
---

<div class="mobile-preferences">
	<a class="mobile-link" href={smartchatHref} target="_blank" rel="noopener noreferrer" aria-label={smartchatAria}>SmartChat</a>
	<a class="mobile-link" href={sdHref} target="_blank" rel="noopener noreferrer" aria-label={sdAria}>{sdLabel}</a>
	<VersionSelect />
	<ThemeSelect />
	<LanguageSelect />
</div>

<style>
	.mobile-preferences {
		display: grid;
		grid-template-columns: 1fr;
		align-items: stretch;
		gap: 8px;
		margin-top: auto;
		padding: 12px 16px calc(16px + 4.75rem);
		border-top: 1px solid var(--aifs-layout-divider);
		background: var(--aifs-color-surface-page);
	}

	/* The entries' text lines up with the selects' edges. */
	.mobile-link {
		margin-inline-start: calc(-1 * var(--aifs-sidebar-nav-padding-start));
	}

	.mobile-preferences :global(label) {
		display: inline-flex;
		align-items: center;
		margin: 0;
		background: transparent;
		color: var(--aifs-color-text-body);
	}

	.mobile-preferences :global(select) {
		width: auto !important;
		max-width: 100%;
		height: 40px;
		margin: 0;
		padding-block: 0;
		border: 1px solid var(--aifs-color-border-subtle);
		border-radius: var(--aifs-radius-control);
		background: var(--aifs-color-surface-chrome);
		color: var(--aifs-color-text-body);
	}
</style>
