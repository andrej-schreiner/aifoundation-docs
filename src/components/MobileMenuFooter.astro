---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<div class="mobile-preferences">
	<ThemeSelect />
	<LanguageSelect />
</div>

<style>
	.mobile-preferences {
		display: grid;
		grid-template-columns: 1fr;
		align-items: stretch;
		gap: 8px;
		margin-top: auto;
		padding: 12px 16px calc(16px + 4.75rem);
		border-top: 1px solid var(--aifs-layout-divider);
		background: var(--aifs-color-surface-page);
	}

	.mobile-preferences :global(label) {
		display: inline-flex;
		align-items: center;
		margin: 0;
		background: transparent;
		color: var(--aifs-color-text-body);
	}

	.mobile-preferences :global(select) {
		width: auto !important;
		max-width: 100%;
		height: 40px;
		margin: 0;
		padding-block: 0;
		border: 1px solid var(--aifs-color-border-subtle);
		border-radius: var(--aifs-radius-control);
		background: var(--aifs-color-surface-chrome);
		color: var(--aifs-color-text-body);
	}
</style>
