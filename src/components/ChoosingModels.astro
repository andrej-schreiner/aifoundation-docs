---
// The "Choosing a model" table: one row per use case with the recommended model,
// an alternative, where it runs and its context. Page component, not for reuse.
import { CHOICE_ROWS, modelFact } from '../shared/lib/choosingModels';
import { creatorNameFor } from '../shared/lib/logos';
import { withWrapPoints } from '../plugins/wrap-points.mjs';
import Logo from './Logo.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';

const t = isDE
  ? {
      useCase: 'Anwendungsfall',
      recommended: 'Empfohlen',
      alternative: 'Alternative',
      where: 'Wo es läuft',
      context: 'Kontext',
      notes: 'Hinweise',
      unpublished: 'Nicht angegeben',
      preview: 'Vorschau',
      migrate: 'Umstieg von GPT, Claude oder Gemini?',
      deprecations: 'Abkündigungen',
    }
  : {
      useCase: 'Use case',
      recommended: 'Recommended',
      alternative: 'Alternative',
      where: 'Where it runs',
      context: 'Context',
      notes: 'Notes',
      unpublished: 'Not published',
      preview: 'Preview',
      migrate: 'Migrating from GPT, Claude, or Gemini?',
      deprecations: 'Deprecations',
    };

function place(hosting: string): string {
  if (!isDE) return hosting;
  return hosting
    .replaceAll('T-Cloud Germany\u00a0(EU)', 'T-Cloud Deutschland\u00a0(EU)')
    .replaceAll('Azure Sweden Central', 'Azure Schweden Mitte')
    .replaceAll('Azure France Central', 'Azure Frankreich Mitte')
    .replaceAll('Azure (worldwide)', 'Azure (Weltweit)')
    .replaceAll('GCP (worldwide)', 'GCP (Weltweit)');
}

function contextLabel(value: string): string {
  return value || '—';
}

// `code` wraps only at its wrap points (withWrapPoints), never mid-word.
function richHtml(text: string): string {
  return text
    .split(/(`[^`]+`)/)
    .map((part) =>
      part.length > 1 && part.startsWith('`') && part.endsWith('`')
        ? `<code>${withWrapPoints(part.slice(1, -1))}</code>`
        : part
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('T-Cloud', '<span class="nowrap">T-Cloud</span>'),
    )
    .join('');
}

function where(recommended: string, alternative: string | undefined): string {
  const a = place(modelFact(recommended).hosting);
  if (!alternative) return a;
  const b = place(modelFact(alternative).hosting);
  return a === b ? a : `${a} · ${b}`;
}

function contextCell(recommended: string, alternative: string | undefined): string {
  const a = modelFact(recommended).context;
  if (!alternative) return contextLabel(a);
  const b = modelFact(alternative).context;
  if (!a || !b) return contextLabel(a || b);
  return a === b ? a : `${a} · ${b}`;
}

---

<div class="choose-root">
<div class="choose-desktop">
  <div class="aifs-table-scroll">
    <table>
      <thead>
        <tr>
          <th>{t.useCase}</th>
          <th>{t.recommended}</th>
          <th>{t.alternative}</th>
          <th>{t.where}</th>
          <th>{t.context}</th>
          <th>{t.notes}</th>
        </tr>
      </thead>
      <tbody>
        {CHOICE_ROWS.map((row) => {
          const recommended = modelFact(row.recommended);
          const alternative = row.alternative ? modelFact(row.alternative) : undefined;
          return (
            <tr>
              <td>{isDE ? row.useCase.de : row.useCase.en}</td>
              <td>
                <span class="choose-name">
                  <Logo name={creatorNameFor(recommended.id, recommended.name)} size="small" decorative />
                  <span>{recommended.name}{recommended.preview ? ` (${t.preview})` : ''}</span>
                </span>
              </td>
              <td>
                {alternative ? `${alternative.name}${alternative.preview ? ` (${t.preview})` : ''}` : '—'}
              </td>
              <td>{where(row.recommended, row.alternative)}</td>
              <td>{contextCell(row.recommended, row.alternative)}</td>
              <td><span set:html={richHtml(isDE ? row.notes.de : row.notes.en)} /></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<ul class="choose-cards">
  {CHOICE_ROWS.map((row) => {
    const recommended = modelFact(row.recommended);
    const alternative = row.alternative ? modelFact(row.alternative) : undefined;
    return (
      <li class="choose-card">
        <p class="choose-card__case">{isDE ? row.useCase.de : row.useCase.en}</p>
        <p class="choose-card__rec">
          <span class="choose-k">{t.recommended}</span>
          <span class="choose-name">
            <Logo name={creatorNameFor(recommended.id, recommended.name)} size="small" decorative />
            <span>{recommended.name}{recommended.preview ? ` (${t.preview})` : ''}</span>
          </span>
        </p>
        <p>
          <span class="choose-k">{t.alternative}</span>
          {alternative ? `${alternative.name}${alternative.preview ? ` (${t.preview})` : ''}` : '—'}
        </p>
        <p>
          <span class="choose-k">{t.where}</span>
          {where(row.recommended, row.alternative)}
        </p>
        <p>
          <span class="choose-k">{t.context}</span>
          {contextCell(row.recommended, row.alternative)}
        </p>
        <p>
          <span class="choose-k">{t.notes}</span>
          <span set:html={richHtml(isDE ? row.notes.de : row.notes.en)} />
        </p>
      </li>
    );
  })}
</ul>
</div>

<h2>{t.migrate}</h2>

<p>
  {isDE
    ? 'Ein Modell, das den Katalog verlässt, steht mit Datum und Ersatz unter '
    : 'A model that is leaving the catalog is listed with its date and replacement on '}
  <a href={`${prefix}/models/deprecations`}>{t.deprecations}</a>.
</p>

<style>
  .choose-desktop,
  .choose-cards {
    margin-top: 1rem;
  }

  .choose-desktop {
    width: 100%;
    max-width: none;
  }

  .choose-desktop :global(.aifs-table-scroll) {
    width: 100%;
    max-width: 100%;
    overflow-x: visible;
  }

  /* Auto layout: each column is at least as wide as its longest word, so
     words wrap only at spaces; the notes column takes the remaining width. */
  .choose-desktop table {
    width: 100%;
    table-layout: auto;
    min-width: 0;
  }

  .choose-desktop :global(th),
  .choose-desktop :global(td) {
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: manual;
    -webkit-hyphens: manual;
  }

  .choose-desktop th:nth-child(6),
  .choose-desktop td:nth-child(6) { width: 36%; }

  .choose-cards {
    display: none;
    list-style: none;
    margin-top: 1rem;
    padding: 0;
    gap: 8px;
  }

  .choose-name {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 4px;
    max-width: 100%;
  }

  .choose-name > span:last-child {
    min-width: 0;
  }

  .choose-card {
    background: var(--aifs-color-surface-chrome);
    border: 1px solid var(--aifs-color-border-subtle);
    border-radius: var(--aifs-table-radius, 8px);
    padding: 10px 12px;
  }

  .choose-card p {
    margin: 0 0 6px;
  }

  .choose-card p:last-child {
    margin-bottom: 0;
  }

  .choose-card__case {
    font-weight: 700;
  }

  .choose-card__rec .choose-name {
    align-items: center;
  }

  .choose-k {
    display: block;
    font-size: 0.75rem;
    color: var(--aifs-color-text-muted, var(--sl-color-gray-3));
  }

  .choose-root {
    container-type: inline-size;
    container-name: choose;
  }

  /* Cards below 49rem of content width: the table's narrowest layout (longest
     word per column, EN and DE) needs about 48.75rem, set by DE ("T-Cloud
     Deutschland (EU)" keeps "Deutschland (EU)" whole). Wide desktops show the
     table. */
  @container choose (max-width: 49rem) {
    .choose-desktop {
      display: none;
    }

    .choose-cards {
      display: grid;
    }
  }
</style>
