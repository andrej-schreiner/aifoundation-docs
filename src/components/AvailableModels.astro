---
// Model cards in a grid: one card per catalog model with its logo, name, hosting
// and a copy button for the model ID. Used on the home page and Models overview.
import Flag from './Flag.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import pricingData from './PlansPageFeatures/PlansData/PlansModelData/v1.20.2/all-pricing--2026-04-24.json';
import { compareCatalogName } from '../shared/lib/modelCatalogOrder';
import { creatorNameFor } from '../shared/lib/logos';
import { isHiddenModel } from '../shared/lib/hiddenModels';
import { isRetiringModel } from '../shared/lib/choosingModels';
import { hostingUnconfirmed, isNewModel } from '../shared/lib/launchModels';
import { FEATURED_MODEL_IDS, isPreviewOnly, modelPrices } from '../shared/lib/modelCards';
import { formatEuro } from '../shared/lib/displayFormat';

// Locale detection (mirrors PlansPage.astro pattern)
interface Props {
  showHeading?: boolean;
  /** Render only the first `limit` cards, without the Show more toggle. */
  limit?: number;
  /** Only the featured cards, in their own order, no "Show more": the full catalog follows on the page. */
  featured?: boolean;
  /** Per-1M token prices on each card (the overview); no copy button. */
  pricing?: boolean;
}
const { showHeading = true, limit, featured = false, pricing = false } = Astro.props;
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const t = {
  cloud: isDE ? 'Cloud' : 'Cloud',
  serverLocation: isDE ? 'Serverstandort' : 'Server location',
  dataProcessing: isDE ? 'Datenverarbeitung' : 'Data processing',
  showMoreTemplate: isDE ? '{count} weitere anzeigen' : 'Show more ({count} more)',
  showLess: isDE ? 'Weniger anzeigen' : 'Show less',
  sectionHeading: isDE ? 'Verfügbare Modelle' : 'Available models',
  preview: isDE ? 'Vorschau' : 'Preview',
  newTag: isDE ? 'Neu' : 'New',
  premium: 'Premium',
  cached: isDE ? 'Gecacht/1M' : 'Cached/1M',
  input: isDE ? 'Eingabe/1M' : 'Input/1M',
  output: isDE ? 'Ausgabe/1M' : 'Output/1M',
  free: isDE ? 'Kostenlos in der Vorschau' : 'Free in preview',
  // A11y / tooltips — localized copy-button strings so screen readers in DE
  // announce in German.
  copyTitleTemplate: isDE ? 'Modell-ID kopieren: {id}' : 'Copy model ID: {id}',
  copyAriaTemplate: isDE ? 'Modell-ID {id} kopieren' : 'Copy model ID {id}',
  copiedAriaTemplate: isDE ? 'Kopiert: {id}' : 'Copied: {id}',
  modelsCountAriaTemplate: isDE ? '{count} Modelle insgesamt' : '{count} models total',
};

// Models not present in the pricing JSON but that should still appear on the
// featured grid. Keep this list current: entries for retired models (see
// /models/retired) render dead cards. Empty is fine.
const EXTRA_MODELS: Array<{
  modelId: string;
  name: string;
  provider: string;
  hosted: string;
  countryCode: string;
  dataProcessing: string;
  dataProcessingCode: string;
}> = [];

// Per-model cloud label overrides, keyed by exactModelName. Use when a model's
// cloud should read differently from what parseRegion() derives from its region
// prefix (e.g. otc → "T-Cloud"), without changing the mapping for every otc model.
// Empty is fine — every model in the catalog currently reads correctly from its
// deployment region.
const CLOUD_OVERRIDES: Record<string, string> = {};

// Map country names to ISO 3166-1 alpha-2 codes for flag icons
const COUNTRY_TO_CODE: Record<string, string> = {
  germany: 'de',
  sweden: 'se',
  france: 'fr',
  europe: 'eu',
  us: 'us',
  // Not a flag — `.fi-globe` is defined in src/styles/custom.css.
  worldwide: 'globe',
};

function getCountryCode(countryName: string): string {
  return COUNTRY_TO_CODE[countryName.toLowerCase()] ?? '';
}

function parseRegion(region: string): {
  provider: string;
  hosted: string;
  countryCode: string;
  dataProcessing: string;
  dataProcessingCode: string;
} {
  if (!region) {
    return { provider: '', hosted: '', countryCode: '', dataProcessing: '', dataProcessingCode: '' };
  }
  const parts = region.split('-');
  const raw = parts[0].toLowerCase();
  const PROVIDER_MAP: Record<string, string> = { otc: 'T-Cloud', azure: 'Azure', gcp: 'GCP' };
  const provider = PROVIDER_MAP[raw] ?? raw.charAt(0).toUpperCase() + raw.slice(1);

  let country = parts[1] ?? '';
  const isWorldwide = country.toLowerCase() === 'worldwide';
  country = country.charAt(0).toUpperCase() + country.slice(1).toLowerCase();
  const regionDe: Record<string, string> = {
    Germany: 'Deutschland',
    Sweden: 'Schweden',
    France: 'Frankreich',
    Europe: 'Europa',
    Worldwide: 'Weltweit',
    Us: 'USA',
  };
  if (isDE && regionDe[country]) country = regionDe[country];
  // A worldwide region resolves to the globe glyph rather than a country flag.
  const countryCode = getCountryCode(country);
  // T-Cloud data stays in Germany, within the EU.
  if (raw === 'otc') country = isDE ? 'Deutschland\u00a0(EU)' : 'Germany\u00a0(EU)';

  // A `worldwide` region means the third-party provider may run the model —
  // and process the data — outside the EU/EEA. See /reference/enterprise-trust.
  const dataProcessing = raw === 'otc'
    ? country
    : isWorldwide
      ? (isDE ? 'Weltweit' : 'Worldwide')
      : 'EU';
  // Only worldwide processing carries a glyph; Germany and EU stay text-only.
  const dataProcessingCode = isWorldwide ? 'globe' : '';
  return { provider, hosted: country, countryCode, dataProcessing, dataProcessingCode };
}

// Pull from the Agentic and Test plans so preview-only models (e.g. Gemma 4) are included.
// Tag Test-plan models so they can be marked as preview downstream.
const exposedPlans = [pricingData[pricingData.length - 2], pricingData[pricingData.length - 1]];
const configs = exposedPlans.flatMap((p) =>
  p.modelQuotaConfigs.map((c) => ({ ...c, isPreview: p.packageName === 'Test' })),
);

interface ModelCard {
  modelId: string;
  name: string;
  creator: string;
  provider: string;
  hosted: string;
  countryCode: string;
  dataProcessing: string;
  dataProcessingCode: string;
  preview?: boolean;
  premium?: boolean;
  showHosting?: boolean;
}

// Build model cards from pricing data (filtering out offline models)
const pricingModels: ModelCard[] = configs
  .filter((c: { exactModelName: string }) => !isHiddenModel(c.exactModelName) && !isRetiringModel(c.exactModelName))
  .map((c: { exactModelName: string; displayModelName: string; deploymentRegion: string; modelTier?: string; isPreview: boolean }) => {
    const { provider, hosted, countryCode, dataProcessing, dataProcessingCode } = parseRegion(
      c.deploymentRegion,
    );
    const creator = creatorNameFor(c.exactModelName, c.displayModelName);
    return {
      modelId: c.exactModelName,
      name: c.displayModelName,
      creator,
      provider: CLOUD_OVERRIDES[c.exactModelName] ?? provider,
      hosted,
      countryCode,
      dataProcessing,
      dataProcessingCode,
      preview: c.isPreview,
      premium: (c.modelTier ?? '').toLowerCase() === 'premium',
      showHosting: !hostingUnconfirmed(c.exactModelName) && Boolean(c.deploymentRegion),
    };
  });

// Combine with extra models
const allModels: ModelCard[] = [...pricingModels, ...EXTRA_MODELS];

// Deduplicate by name (extras override pricing if same name)
const modelMap = new Map<string, ModelCard>();
for (const m of allModels) {
  modelMap.set(m.name, m);
}

// Same order as the plans table default. See modelCatalogOrder.ts.
const sortedModels = [...modelMap.values()].sort((a, b) => compareCatalogName(a.name, b.name));

const INITIAL_COUNT = 6;
// Featured: the explicit order from modelCards.ts (same as the overview), not the catalog sort.
const featuredModels = FEATURED_MODEL_IDS.map((id) => sortedModels.find((m) => m.modelId === id)).filter(
  (m): m is ModelCard => Boolean(m),
);
const cardModels = featured ? featuredModels : limit ? sortedModels.slice(0, limit) : sortedModels;
---

<div class="available-models">
  {showHeading && (
    <h2 class="models-heading">
      {t.sectionHeading}{' '}
      <span class="models-count" aria-label={t.modelsCountAriaTemplate.replace('{count}', String(sortedModels.length))}>
        ({sortedModels.length})
      </span>
    </h2>
  )}
  <span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
  <div class="models-grid" id={limit ? undefined : 'models-grid'}>
    {
      cardModels.map((model, index) => (
        <article class:list={['model-card', { 'model-card--hidden': index >= INITIAL_COUNT, 'model-card--priced': pricing }]} data-index={index}>
          <div class="model-card__head">
            <Logo name={model.creator} size="large" />
            <h3 class="model-card__name">
              {model.name}
              {isNewModel(model.modelId) && <Tag size="small" color="magenta">{t.newTag}</Tag>}
              {model.preview && <Tag size="small">{t.preview}</Tag>}
              {pricing && model.premium && <Tag size="small">{t.premium}</Tag>}
            </h3>
            {!pricing && (
              <Button
                variant="ghost"
                size="small"
                iconOnly
                class="model-card__copy"
                data-model-id={model.modelId}
                data-copied-label={t.copiedAriaTemplate.replace('{id}', model.modelId)}
                title={t.copyTitleTemplate.replace('{id}', model.modelId)}
                ariaLabel={t.copyAriaTemplate.replace('{id}', model.modelId)}
                successTooltip={t.copiedAriaTemplate.replace('{id}', model.modelId)}
                tooltipPlacement="top-end">
                <Icon name="action-copy-paste" size={16} />
                <Icon slot="success" name="action-checkmark" size={16} />
              </Button>
            )}
          </div>
          {model.showHosting !== false && model.provider && (
            <dl class="model-card__rows">
              <div class="model-card__row">
                <dt>{t.cloud}</dt>
                <dd><Tag size="small" color={model.provider === 'T-Cloud' ? 'magenta' : 'standard'}>{model.provider}</Tag></dd>
              </div>
              <div class="model-card__row">
                <dt>{t.serverLocation}</dt>
                <dd class="model-card__place">
                  {model.countryCode && <Flag code={model.countryCode} size={20} decorative />}
                  <span>{model.hosted}</span>
                </dd>
              </div>
              {model.hosted.trim().toLowerCase() !== model.dataProcessing.trim().toLowerCase() && (
                <div class="model-card__row">
                  <dt>{t.dataProcessing}</dt>
                  <dd class="model-card__place">
                    {model.dataProcessingCode && <Flag code={model.dataProcessingCode} size={20} decorative />}
                    <span>{model.dataProcessing}</span>
                  </dd>
                </div>
              )}
            </dl>
          )}
          {pricing && (isPreviewOnly(model.modelId) ? (
            <p class="model-card__free">{t.free}</p>
          ) : (() => {
            const p = modelPrices(model.modelId);
            const euro = (value: number | null, digits = 2) => formatEuro(value, digits, isDE ? 'de' : 'en');
            return (
              <dl class="model-card__prices">
                {p.cached != null && <div><dt>{t.cached}</dt><dd>{euro(p.cached, 4)}</dd></div>}
                {p.input != null && <div><dt>{t.input}</dt><dd>{euro(p.input)}</dd></div>}
                {p.output != null && <div><dt>{t.output}</dt><dd>{euro(p.output)}</dd></div>}
              </dl>
            );
          })())}
        </article>
      ))
    }
  </div>
  {
    cardModels.length > INITIAL_COUNT && (
      <Button
        variant="secondary"
        class="models-toggle"
        id="models-toggle"
        aria-controls="models-grid"
        aria-expanded="false"
        data-total={sortedModels.length}
        data-initial={INITIAL_COUNT}
        data-show-more-template={t.showMoreTemplate}
        data-show-less={t.showLess}>
        {t.showMoreTemplate.replace('{count}', String(sortedModels.length - INITIAL_COUNT))}
      </Button>
    )
  }
</div>

<style>
  .available-models {
    /* The grid follows its own width, not the window's, so it also fits a
       narrow column such as a design-system showcase. */
    container-type: inline-size;
    /* Spacing around it: layout.css (a section when it has its heading). */
  }

  .models-heading {
    margin: 0 0 var(--aifs-rhythm-after-heading);
    line-height: 1.2;
  }

  .models-count {
    font-size: 0.75em;
    font-weight: 400;
    color: var(--aifs-color-text-muted);
    font-variant-numeric: tabular-nums;
    vertical-align: middle;
  }

  .models-grid > .model-card {
    margin: 0;
  }

  .models-grid {
    display: grid;
    gap: var(--aifs-model-card-grid-gap);
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  /* A card needs about 17rem for its longest row (Server Location, globe,
     Worldwide), so: two columns from 34rem, three from 52rem. Container
     queries cannot read custom properties, so these are rem, not tokens. */
  @container (min-width: 34rem) {
    .models-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @container (min-width: 52rem) {
    .models-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* As on ai.t-systems.net/models: a header row (logo, name, copy), then
     label–value rows with the value at the end edge. */
  .model-card {
    /* A size container, so the copy tooltip stays inside the card. */
    container-type: inline-size;
    --aifs-tooltip-inset: var(--aifs-model-card-padding);
    display: flex;
    flex-direction: column;
    gap: var(--aifs-model-card-gap);
    padding: var(--aifs-model-card-padding);
    border: var(--aifs-model-card-border-width) solid var(--aifs-model-card-border);
    border-radius: var(--aifs-model-card-radius);
    background: var(--aifs-model-card-background);
    color: var(--aifs-model-card-value);
    text-align: start;
  }

  .model-card--hidden {
    display: none;
  }

  .model-card__head {
    display: flex;
    align-items: center;
    gap: var(--aifs-model-card-logo-gap);
  }

  .model-card__name {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--aifs-model-card-row-gap);
    margin: 0;
    font-size: var(--aifs-model-card-name-font-size);
    font-weight: var(--aifs-model-card-name-font-weight);
    line-height: 1.25;
    color: var(--aifs-model-card-value);
  }

  .model-card__rows {
    display: flex;
    flex-direction: column;
    gap: var(--aifs-model-card-row-gap);
    margin: 0;
  }

  /* If a card is still too narrow, the value wraps under its label and stays
     at the end edge. */
  .model-card__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--aifs-model-card-row-gap);
    margin: 0;
  }

  .model-card__row dt {
    flex: none;
    color: var(--aifs-model-card-label);
    font-weight: normal;
    white-space: nowrap;
  }

  /* Overview cards (pricing): the per-1M prices at the foot of the card, so
     they line up across a row of cards. */
  .model-card__prices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--aifs-model-card-row-gap) var(--aifs-model-card-gap);
    margin: auto 0 0;
  }

  .model-card__prices > div {
    display: grid;
    margin: 0;
  }

  .model-card__prices dt {
    margin: 0;
    font-size: var(--aifs-text-small-font-size);
    color: var(--aifs-model-card-label);
    white-space: nowrap;
  }

  .model-card__prices dd,
  .model-card__free {
    margin: 0;
    font-weight: var(--aifs-model-card-name-font-weight);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .model-card__free {
    margin-top: auto;
  }

  .model-card__row dd {
    margin: 0 0 0 auto;
  }

  .model-card__place {
    display: flex;
    align-items: center;
    gap: var(--aifs-model-card-row-gap);
    font-weight: var(--aifs-model-card-value-font-weight);
  }

  .model-card__place :global(.flag) {
    width: var(--aifs-model-card-flag-size);
    height: var(--aifs-model-card-flag-size);
  }

  /* The Button component draws this one (ghost, small, icon only); it sits at
     the end of the header row. :global because the button element belongs to
     Button.astro, not to this component's scope. */
  .model-card :global(.model-card__copy) {
    flex: none;
  }

  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Drawn by the Button component (secondary); centred under the grid here,
     with the gap a button keeps below a grid. */
  :global(.models-toggle) {
    display: flex;
    margin: var(--aifs-layout-grid-action-gap) auto 0;
  }
</style>

<script>
  function setup() {
    const toggle = document.getElementById('models-toggle') as HTMLButtonElement | null;
    if (toggle) setupToggle(toggle);
    setupCopy();
  }

  function setupToggle(toggle: HTMLButtonElement) {
    const total = Number(toggle.dataset.total);
    const initial = Number(toggle.dataset.initial);
    const showMoreTemplate = toggle.dataset.showMoreTemplate ?? 'Show more ({count} more)';
    const showLess = toggle.dataset.showLess ?? 'Show less';
    let expanded = false;

    toggle.addEventListener('click', () => {
      expanded = !expanded;
      const cards = document.querySelectorAll<HTMLElement>('.model-card');
      cards.forEach((card) => {
        const idx = Number(card.dataset.index);
        if (idx >= initial) {
          card.classList.toggle('model-card--hidden', !expanded);
        }
      });
      toggle.textContent = expanded ? showLess : showMoreTemplate.replace('{count}', String(total - initial));
      toggle.setAttribute('aria-expanded', String(expanded));
    });
  }

  function setupCopy() {
    // Copy model ID to clipboard with visual + accessible feedback.
    // The button's `data-copied-label` carries the localized "Copied: <id>"
    // string so the live-region announcement matches the page locale.
    document.querySelectorAll<HTMLButtonElement>('.model-card__copy').forEach((btn) => {
      // One live region per card block, so several blocks on a page each announce.
      const copyStatus = btn.closest('.available-models')?.querySelector('.copy-status');
      btn.addEventListener('click', async () => {
        const modelId = btn.dataset.modelId;
        if (!modelId) return;
        try {
          await navigator.clipboard.writeText(modelId);
          // Button's success state swaps in the tick for 1500ms.
          btn.dataset.state = 'success';
          const originalLabel = btn.getAttribute('aria-label') ?? '';
          const copiedLabel = btn.dataset.copiedLabel ?? `Copied ${modelId}`;
          btn.setAttribute('aria-label', copiedLabel);
          if (copyStatus) copyStatus.textContent = copiedLabel;
          setTimeout(() => {
            delete btn.dataset.state;
            btn.setAttribute('aria-label', originalLabel);
            if (copyStatus) copyStatus.textContent = '';
          }, 1500);
        } catch {
          // Fallback: do nothing silently
        }
      });
    });
  }

  // Run on initial load and on Astro page transitions
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
