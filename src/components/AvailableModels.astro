---
import Flag from './Flag.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import pricingData from './PlansPageFeatures/PlansData/PlansModelData/v1.20.2/all-pricing--2026-04-24.json';
import { compareCatalogName } from '../shared/lib/modelCatalogOrder';
import { creatorLogoFor, creatorNameFor } from '../shared/lib/logos';
import { isHiddenModel } from '../shared/lib/hiddenModels';
import { isRetiringModel } from '../shared/lib/choosingModels';
import { hostingUnconfirmed } from '../shared/lib/launchModels';

// Locale detection (mirrors PlansPage.astro pattern)
interface Props {
  showHeading?: boolean;
}
const { showHeading = true } = Astro.props;
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const t = {
  cloud: isDE ? 'Cloud' : 'Cloud',
  serverLocation: isDE ? 'Serverstandort' : 'Server Location',
  dataProcessing: isDE ? 'Datenverarbeitung' : 'Data Processing',
  showMoreTemplate: isDE ? '{count} weitere anzeigen' : 'Show More ({count} more)',
  showLess: isDE ? 'Weniger anzeigen' : 'Show Less',
  sectionHeading: isDE ? 'Verfügbare Modelle' : 'Available Models',
  preview: isDE ? 'Vorschau' : 'Preview',
  // A11y / tooltips — localized copy-button strings so screen readers in DE
  // announce in German.
  copyTitleTemplate: isDE ? 'Modell-ID kopieren: {id}' : 'Copy model ID: {id}',
  copyAriaTemplate: isDE ? 'Modell-ID {id} kopieren' : 'Copy model ID {id}',
  copiedAriaTemplate: isDE ? 'Kopiert: {id}' : 'Copied {id}',
  modelsCountAriaTemplate: isDE ? '{count} Modelle insgesamt' : '{count} models total',
};

// Models not present in the pricing JSON but that should still appear on the
// featured grid. Keep this list current: entries for retired models (see
// /models/retired) render dead cards. Empty is fine.
const EXTRA_MODELS: Array<{
  modelId: string;
  name: string;
  provider: string;
  hosted: string;
  countryCode: string;
  dataProcessing: string;
  dataProcessingCode: string;
}> = [];

// Per-model cloud label overrides, keyed by exactModelName. Use when a model's
// cloud should read differently from what parseRegion() derives from its region
// prefix (e.g. otc → "T-Cloud"), without changing the mapping for every otc model.
// Empty is fine — every model in the catalog currently reads correctly from its
// deployment region.
const CLOUD_OVERRIDES: Record<string, string> = {};

// Map country names to ISO 3166-1 alpha-2 codes for flag icons
const COUNTRY_TO_CODE: Record<string, string> = {
  germany: 'de',
  sweden: 'se',
  france: 'fr',
  europe: 'eu',
  us: 'us',
  // Not a flag — `.fi-globe` is defined in src/styles/custom.css.
  worldwide: 'globe',
};

function getCountryCode(countryName: string): string {
  return COUNTRY_TO_CODE[countryName.toLowerCase()] ?? '';
}

function parseRegion(region: string): {
  provider: string;
  hosted: string;
  countryCode: string;
  dataProcessing: string;
  dataProcessingCode: string;
} {
  if (!region) {
    return { provider: '', hosted: '', countryCode: '', dataProcessing: '', dataProcessingCode: '' };
  }
  const parts = region.split('-');
  const raw = parts[0].toLowerCase();
  const PROVIDER_MAP: Record<string, string> = { otc: 'T-Cloud', azure: 'Azure', gcp: 'GCP' };
  const provider = PROVIDER_MAP[raw] ?? raw.charAt(0).toUpperCase() + raw.slice(1);

  let country = parts[1] ?? '';
  const isWorldwide = country.toLowerCase() === 'worldwide';
  country = country.charAt(0).toUpperCase() + country.slice(1).toLowerCase();
  const regionDe: Record<string, string> = {
    Germany: 'Deutschland',
    Sweden: 'Schweden',
    France: 'Frankreich',
    Europe: 'Europa',
    Worldwide: 'Weltweit',
    Us: 'USA',
  };
  if (isDE && regionDe[country]) country = regionDe[country];
  // A worldwide region resolves to the globe glyph rather than a country flag.
  const countryCode = getCountryCode(country);

  // A `worldwide` region means the third-party provider may run the model —
  // and process the data — outside the EU/EEA. See /reference/enterprise-trust.
  const dataProcessing = raw === 'otc'
    ? (isDE ? 'Deutschland' : 'Germany')
    : isWorldwide
      ? (isDE ? 'Weltweit' : 'Worldwide')
      : 'EU';
  // Only worldwide processing carries a glyph; Germany and EU stay text-only.
  const dataProcessingCode = isWorldwide ? 'globe' : '';
  return { provider, hosted: country, countryCode, dataProcessing, dataProcessingCode };
}

// Pull from the Agentic and Test plans so preview-only models (e.g. Gemma 4) are included.
// Tag Test-plan models so they can be marked as preview downstream.
const exposedPlans = [pricingData[pricingData.length - 2], pricingData[pricingData.length - 1]];
const configs = exposedPlans.flatMap((p) =>
  p.modelQuotaConfigs.map((c) => ({ ...c, isPreview: p.packageName === 'Test' })),
);

interface ModelCard {
  modelId: string;
  name: string;
  creator: string;
  logo: string;
  provider: string;
  hosted: string;
  countryCode: string;
  dataProcessing: string;
  dataProcessingCode: string;
  preview?: boolean;
  showHosting?: boolean;
}

// Build model cards from pricing data (filtering out offline models)
const pricingModels: ModelCard[] = configs
  .filter((c: { exactModelName: string }) => !isHiddenModel(c.exactModelName) && !isRetiringModel(c.exactModelName))
  .map((c: { exactModelName: string; displayModelName: string; deploymentRegion: string; isPreview: boolean }) => {
    const { provider, hosted, countryCode, dataProcessing, dataProcessingCode } = parseRegion(
      c.deploymentRegion,
    );
    const creator = creatorNameFor(c.exactModelName, c.displayModelName);
    return {
      modelId: c.exactModelName,
      name: c.displayModelName,
      creator,
      logo: creatorLogoFor(c.exactModelName, c.displayModelName),
      provider: CLOUD_OVERRIDES[c.exactModelName] ?? provider,
      hosted,
      countryCode,
      dataProcessing,
      dataProcessingCode,
      preview: c.isPreview,
      showHosting: !hostingUnconfirmed(c.exactModelName) && Boolean(c.deploymentRegion),
    };
  });

// Combine with extra models
const allModels: ModelCard[] = [...pricingModels, ...EXTRA_MODELS];

// Deduplicate by name (extras override pricing if same name)
const modelMap = new Map<string, ModelCard>();
for (const m of allModels) {
  modelMap.set(m.name, m);
}

// Same order as the plans table default. See modelCatalogOrder.ts.
const sortedModels = [...modelMap.values()].sort((a, b) => compareCatalogName(a.name, b.name));

const INITIAL_COUNT = 6;
---

<div class="available-models">
  {showHeading && (
    <h2 class="models-heading">
      {t.sectionHeading}{' '}
      <span class="models-count" aria-label={t.modelsCountAriaTemplate.replace('{count}', String(sortedModels.length))}>
        ({sortedModels.length})
      </span>
    </h2>
  )}
  <span id="copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
  <div class="models-grid" id="models-grid">
    {
      sortedModels.map((model, index) => (
        <div class:list={['model-card', { 'model-card--hidden': index >= INITIAL_COUNT }]} data-index={index}>
          <Button
            variant="ghost"
            size="small"
            iconOnly
            class="model-card__copy"
            data-model-id={model.modelId}
            data-copied-label={t.copiedAriaTemplate.replace('{id}', model.modelId)}
            title={t.copyTitleTemplate.replace('{id}', model.modelId)}
            ariaLabel={t.copyAriaTemplate.replace('{id}', model.modelId)}>
            <Icon name="action-copy-paste" size={16} class="icon-copy" />
            <Icon name="action-checkmark" size={16} class="icon-check" />
          </Button>
          <h3 class="model-card__name">
            <span class:list={['model-card__mark', { 'model-card__mark--zoom': model.creator.startsWith('Google') }]}>
              <img
                class="model-card__logo"
                src={model.logo}
                alt={model.creator === 'Other' ? '' : model.creator}
                title={model.creator === 'Other' ? undefined : model.creator}
                width="20"
                height="20"
              />
            </span>
            <span class="model-card__title">
              {model.name}
              {model.preview && <span class="status-badge status-badge--preview">{t.preview}</span>}
            </span>
          </h3>
          {model.showHosting !== false && model.provider && (
          <p class="model-card__where">
            <span>{model.provider}</span>
            <span aria-hidden="true">·</span>
            {model.countryCode && <Flag code={model.countryCode} size={16} decorative />}
            <span>{model.hosted}</span>
          </p>
          )}
          {model.showHosting !== false && model.hosted.trim().toLowerCase() !== model.dataProcessing.trim().toLowerCase() && (
            <p class="model-card__where model-card__where--extra">
              <span class="model-card__k">{t.dataProcessing}</span>
              {model.dataProcessingCode && <Flag code={model.dataProcessingCode} size={16} decorative />}
              <span>{model.dataProcessing}</span>
            </p>
          )}
        </div>
      ))
    }
  </div>
  {
    sortedModels.length > INITIAL_COUNT && (
      <Button
        variant="secondary"
        class="models-toggle"
        id="models-toggle"
        aria-controls="models-grid"
        aria-expanded="false"
        data-total={sortedModels.length}
        data-initial={INITIAL_COUNT}
        data-show-more-template={t.showMoreTemplate}
        data-show-less={t.showLess}>
        {t.showMoreTemplate.replace('{count}', String(sortedModels.length - INITIAL_COUNT))}
      </Button>
    )
  }
</div>

<style>
  .available-models {
    margin-top: var(--aifs-rhythm-heading-2);
    margin-bottom: 8px;
  }

  .models-heading {
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .models-count {
    font-size: 0.75em;
    font-weight: 400;
    color: var(--sl-color-gray-3);
    vertical-align: middle;
  }

  .models-grid > .model-card {
    margin: 0;
  }

  .models-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .models-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .models-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .model-card {
    position: relative;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--aifs-table-radius, 8px);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: start;
    line-height: 1.2;
  }

  :global(:root[data-theme='dark']) .model-card {
    background: var(--aifs-color-surface-chrome);
    border-color: var(--aifs-color-border-subtle);
  }

  .model-card:hover {
    border-color: var(--aifs-color-action-background);
  }

  .model-card--hidden {
    display: none;
  }

  .model-card__name {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--sl-color-white);
    padding-right: 1.75rem;
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 6px;
  }

  /* 20px tile on the title line. Google's mark is mostly margin, so it is scaled up. */
  .model-card__mark {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
    padding: 2px;
    border: 1px solid var(--aifs-color-border-subtle);
    border-radius: 4px;
    background: var(--aifs-color-logo-background);
  }

  .model-card__mark--zoom {
    padding: 2px;
    overflow: visible;
  }

  .model-card__logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .model-card__mark--zoom .model-card__logo {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .model-card__title {
    min-width: 0;
  }

  .model-card__where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: 0 0 0 26px;
    padding: 0 2.5rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .model-card__where--extra {
    color: var(--aifs-color-text-muted);
  }

  .model-card__k {
    color: var(--aifs-color-text-muted);
  }

  .model-card__preview-tag {
    font-weight: 500;
    color: var(--sl-color-text-accent);
  }

  /* The Button component draws this one (ghost, small, icon only); here it is
     only placed in the card's corner. :global because the button element
     belongs to Button.astro, not to this component's scope. */
  .model-card :global(.model-card__copy) {
    position: absolute;
    top: 4px;
    right: 4px;
  }

  .model-card :global(.model-card__copy .icon-check) {
    display: none;
    color: var(--aifs-color-success);
  }

  .model-card :global(.model-card__copy[data-copied] .icon-copy) {
    display: none;
  }

  .model-card :global(.model-card__copy[data-copied] .icon-check) {
    display: inline;
  }

  .model-card :global(.model-card__copy[data-copied]) {
    color: var(--aifs-color-success);
  }

  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .model-card__details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2, var(--sl-color-white));
  }

  .model-card__provider {
    font-weight: 500;
  }

  /* Drawn by the Button component (secondary); centred under the grid here. */
  :global(.models-toggle) {
    display: flex;
    margin: 8px auto 0;
  }
</style>

<script>
  function setup() {
    const toggle = document.getElementById('models-toggle') as HTMLButtonElement | null;
    if (!toggle) return;

    const total = Number(toggle.dataset.total);
    const initial = Number(toggle.dataset.initial);
    const showMoreTemplate = toggle.dataset.showMoreTemplate ?? 'Show More ({count} more)';
    const showLess = toggle.dataset.showLess ?? 'Show Less';
    let expanded = false;

    toggle.addEventListener('click', () => {
      expanded = !expanded;
      const cards = document.querySelectorAll<HTMLElement>('.model-card');
      cards.forEach((card) => {
        const idx = Number(card.dataset.index);
        if (idx >= initial) {
          card.classList.toggle('model-card--hidden', !expanded);
        }
      });
      toggle.textContent = expanded ? showLess : showMoreTemplate.replace('{count}', String(total - initial));
      toggle.setAttribute('aria-expanded', String(expanded));
    });

    // Copy model ID to clipboard with visual + accessible feedback.
    // The button's `data-copied-label` carries the localized "Copied: <id>"
    // string so the live-region announcement matches the page locale.
    const copyStatus = document.getElementById('copy-status');
    document.querySelectorAll<HTMLButtonElement>('.model-card__copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const modelId = btn.dataset.modelId;
        if (!modelId) return;
        try {
          await navigator.clipboard.writeText(modelId);
          // Visual feedback: swap icon for 1500ms
          btn.setAttribute('data-copied', '');
          const originalLabel = btn.getAttribute('aria-label') ?? '';
          const copiedLabel = btn.dataset.copiedLabel ?? `Copied ${modelId}`;
          btn.setAttribute('aria-label', copiedLabel);
          if (copyStatus) copyStatus.textContent = copiedLabel;
          setTimeout(() => {
            btn.removeAttribute('data-copied');
            btn.setAttribute('aria-label', originalLabel);
            if (copyStatus) copyStatus.textContent = '';
          }, 1500);
        } catch {
          // Fallback: do nothing silently
        }
      });
    });
  }

  // Run on initial load and on Astro page transitions
  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
