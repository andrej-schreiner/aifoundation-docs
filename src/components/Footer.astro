---
import Default from '@astrojs/starlight/components/Footer.astro';
import PreviewModelsBanner from './PreviewModelsBanner.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const links = isDE
  ? [
      { label: 'Impressum', href: 'https://www.t-systems.com/de/de/impressum' },
      { label: 'Datenschutz', href: 'https://www.t-systems.com/de/de/datenschutz' },
      { label: 'Jugendschutz', href: 'https://www.telekom.com/de/konzern/compliance/details/jugendschutz-702466' },
    ]
  : [
      { label: 'Imprint', href: 'https://www.t-systems.com/de/en/imprint' },
      { label: 'Data privacy', href: 'https://www.t-systems.com/de/en/data-privacy' },
      { label: 'Youth protection', href: 'https://www.telekom.com/en/corporate-responsibility/governance/protection-of-minors' },
    ];
---

<Default {...Astro.props}><slot /></Default>

<PreviewModelsBanner />

<footer class="site-footer" aria-label={isDE ? 'Website' : 'Site'}>
  <div class="site-footer-inner">
    <span class="site-footer-notice">&copy; T-Systems International</span>
    <nav class="site-footer-nav" aria-label={isDE ? 'Rechtliche Hinweise' : 'Legal'}>
      <ul>
        {links.map(({ label, href }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    box-sizing: border-box;
    background: #ffffff;
    color: #262626;
    border-top: 1px solid #d8d8d8;
    padding: 1.25rem 1.25rem 1.5rem;
    font-size: 0.9rem;
  }

  :global(:root[data-theme='dark']) .site-footer {
    background: var(--aifs-d-surface);
    color: var(--aifs-d-text);
    border-top-color: var(--aifs-d-border);
  }

  .site-footer-inner {
    max-width: var(--sl-content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .site-footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .site-footer-nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer-nav a:hover,
  .site-footer-nav a:focus-visible {
    color: #e20074;
    text-decoration: underline;
  }

  :global(:root[data-theme='dark']) .site-footer-nav a:hover,
  :global(:root[data-theme='dark']) .site-footer-nav a:focus-visible {
    color: #ffffff;
  }

  .site-footer-nav a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
