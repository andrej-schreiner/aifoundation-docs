---
// Site part, not for reuse. Starlight's Footer slot (astro.config.mjs): previous /
// next links, then the site footer, which the script moves out of the sheet and
// (from 72rem) fixes behind it, so the sheet scrolls up off it (layout.css).
import Default from '@astrojs/starlight/components/Footer.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const links = isDE
  ? [
      { label: 'Impressum', href: 'https://www.t-systems.com/de/de/impressum' },
      { label: 'Datenschutz', href: 'https://www.t-systems.com/de/de/datenschutz' },
    ]
  : [
      { label: 'Imprint', href: 'https://www.t-systems.com/de/en/imprint' },
      { label: 'Data privacy', href: 'https://www.t-systems.com/de/en/data-privacy' },
    ];
---

<Default {...Astro.props}><slot /></Default>

<footer class="site-footer" aria-label={isDE ? 'Website' : 'Site'}>
  <div class="site-footer-inner">
    <span class="site-footer-notice">&copy; <span class="nowrap">T-Systems</span> International</span>
    <nav class="site-footer-nav" aria-label={isDE ? 'Rechtliche Hinweise' : 'Legal'}>
      <ul>
        {links.map(({ label, href }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<script>
  // The footer leaves the sheet: it goes to just after it, on the page's
  // backdrop. From 72rem it is fixed behind the sheet; the sheet's bottom
  // margin (--aifs-footer-height) is the room that reveals it, and its left
  // edge and width follow the sheet.
  const siteFooter = document.querySelector<HTMLElement>('.site-footer');
  const sheet = document.querySelector<HTMLElement>('.main-pane')?.parentElement;
  if (siteFooter && sheet && siteFooter.previousElementSibling !== sheet) {
    sheet.after(siteFooter);
    const root = document.documentElement;
    const fit = () => {
      const box = sheet.getBoundingClientRect();
      root.style.setProperty('--aifs-footer-left', `${box.left}px`);
      root.style.setProperty('--aifs-footer-width', `${box.width}px`);
      root.style.setProperty('--aifs-footer-height', `${siteFooter.offsetHeight}px`);
    };
    fit();
    new ResizeObserver(fit).observe(sheet);
    new ResizeObserver(fit).observe(siteFooter);
  }

  const pageTitle = document.querySelector('main h1');
  if (pageTitle) {
    document.querySelectorAll('.sl-markdown-content h1').forEach((heading) => {
      if (heading !== pageTitle && heading.textContent?.trim() === pageTitle.textContent?.trim()) {
        heading.setAttribute('hidden', '');
      }
    });
  }
  const onPlugins = /\/plugins\//.test(location.pathname);
  if (onPlugins) {
    document.querySelectorAll<HTMLImageElement>('.sl-markdown-content img').forEach((img) => {
      if (img.closest('a')) return;
      const href = img.currentSrc || img.src;
      if (!href) return;
      const link = document.createElement('a');
      link.href = href;
      link.className = 'plugin-shot';
      link.setAttribute('aria-label', img.alt || 'Screenshot');
      img.replaceWith(link);
      link.appendChild(img);
    });
  }

  document.querySelectorAll<HTMLAnchorElement>('a.plugin-shot').forEach((link) => {
    if (link.dataset.lightbox === '1') return;
    link.dataset.lightbox = '1';
    link.addEventListener('click', (event) => {
      event.preventDefault();
      let dialog = document.getElementById('plugin-lightbox') as HTMLDialogElement | null;
      if (!dialog) {
        dialog = document.createElement('dialog');
        dialog.id = 'plugin-lightbox';
        const closeLabel = document.documentElement.lang === 'de' ? 'Schließen' : 'Close';
        dialog.innerHTML = `<button type="button" class="plugin-lightbox__close" aria-label="${closeLabel}">×</button><img alt="">`;
        document.body.appendChild(dialog);
        dialog.addEventListener('click', (click) => {
          const target = click.target;
          if (target === dialog || (target instanceof Element && target.closest('button'))) dialog?.close();
        });
      }
      const shot = dialog.querySelector('img');
      if (shot) {
        shot.src = link.href;
        shot.alt = link.querySelector('img')?.alt || '';
      }
      dialog.showModal();
    });
  });
</script>

<style>
  /* Outside the sheet, on the page's backdrop: the script below moves it out
     of the content to just after the sheet. From 72rem it sits fixed at the
     bottom of the window, as wide as the sheet and behind it, and the sheet
     scrolls up off it at the end of the page (layout.css gives the sheet a
     bottom margin of the footer's height). */
  .site-footer {
    box-sizing: border-box;
    margin: 0;
    padding: var(--aifs-layout-sheet-padding) var(--sl-content-pad-x, 1rem);
    color: var(--aifs-color-text-muted);
    font-size: var(--aifs-text-small-font-size);
    /* Below 72rem the page has no tint, so the footer brings its own. */
    background-color: var(--aifs-layout-tint);
  }

  @media (min-width: 72rem) {
    :global([data-has-sidebar]) .site-footer {
      position: fixed;
      bottom: 0;
      left: var(--aifs-footer-left, 0px);
      width: var(--aifs-footer-width, 100%);
      z-index: 0;
    }
  }

  .site-footer-inner {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .site-footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .site-footer-nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer-nav a:hover,
  .site-footer-nav a:focus-visible {
    color: var(--aifs-color-link-standard);
    text-decoration: underline;
  }

  :global(:root[data-theme='dark']) .site-footer-nav a:hover,
  :global(:root[data-theme='dark']) .site-footer-nav a:focus-visible {
    color: var(--aifs-color-link-standard);
  }

  .site-footer-nav a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  :global(#plugin-lightbox) {
    max-width: min(96vw, 1200px);
    max-height: 92vh;
    padding: 12px;
    border: 0;
    border-radius: 8px;
    background: var(--aifs-color-surface-page);
  }

  :global(#plugin-lightbox::backdrop) {
    /* TODO(token-gap): no overlay/scrim token yet (GAPS.md row 15). */
    background: rgb(0 0 0 / 0.72);
  }

  :global(#plugin-lightbox img) {
    display: block;
    max-width: 100%;
    max-height: calc(92vh - 48px);
    margin: 0 auto;
  }

  :global(.plugin-lightbox__close) {
    display: block;
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--aifs-color-text-body);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
