---
import Default from '@astrojs/starlight/components/Footer.astro';
import PreviewModelsBanner from './PreviewModelsBanner.astro';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const links = isDE
  ? [
      { label: 'Impressum', href: 'https://www.t-systems.com/de/de/impressum' },
      { label: 'Datenschutz', href: 'https://www.t-systems.com/de/de/datenschutz' },
      { label: 'Jugendschutz', href: 'https://www.telekom.com/de/konzern/compliance/details/jugendschutz-702466' },
    ]
  : [
      { label: 'Imprint', href: 'https://www.t-systems.com/de/en/imprint' },
      { label: 'Data privacy', href: 'https://www.t-systems.com/de/en/data-privacy' },
      { label: 'Youth protection', href: 'https://www.telekom.com/en/corporate-responsibility/governance/protection-of-minors' },
    ];
---

<Default {...Astro.props}><slot /></Default>

<PreviewModelsBanner />

<footer class="site-footer" aria-label={isDE ? 'Website' : 'Site'}>
  <div class="site-footer-inner">
    <span class="site-footer-notice">&copy; T-Systems International</span>
    <nav class="site-footer-nav" aria-label={isDE ? 'Rechtliche Hinweise' : 'Legal'}>
      <ul>
        {links.map(({ label, href }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<script>
  const pageTitle = document.querySelector('main h1');
  if (pageTitle) {
    document.querySelectorAll('.sl-markdown-content h1').forEach((heading) => {
      if (heading !== pageTitle && heading.textContent?.trim() === pageTitle.textContent?.trim()) {
        heading.setAttribute('hidden', '');
      }
    });
  }
  const onPlugins = /\/plugins\//.test(location.pathname);
  if (onPlugins) {
    document.querySelectorAll<HTMLImageElement>('.sl-markdown-content img').forEach((img) => {
      if (img.closest('a')) return;
      const href = img.currentSrc || img.src;
      if (!href) return;
      const link = document.createElement('a');
      link.href = href;
      link.className = 'plugin-shot';
      link.setAttribute('aria-label', img.alt || 'Screenshot');
      img.replaceWith(link);
      link.appendChild(img);
    });
  }

  document.querySelectorAll<HTMLAnchorElement>('a.plugin-shot').forEach((link) => {
    if (link.dataset.lightbox === '1') return;
    link.dataset.lightbox = '1';
    link.addEventListener('click', (event) => {
      event.preventDefault();
      let dialog = document.getElementById('plugin-lightbox') as HTMLDialogElement | null;
      if (!dialog) {
        dialog = document.createElement('dialog');
        dialog.id = 'plugin-lightbox';
        dialog.innerHTML = '<button type="button" class="plugin-lightbox__close" aria-label="Close">×</button><img alt="">';
        document.body.appendChild(dialog);
        dialog.addEventListener('click', (click) => {
          const target = click.target;
          if (target === dialog || (target instanceof Element && target.closest('button'))) dialog?.close();
        });
      }
      const shot = dialog.querySelector('img');
      if (shot) {
        shot.src = link.href;
        shot.alt = link.querySelector('img')?.alt || '';
      }
      dialog.showModal();
    });
  });
</script>

<style>
  /* Sits in the content column, under the content, like the pagination
     above it. A full-width band would have to break out of the column, and
     the column no longer sits in the middle of the window. */
  /* The line above runs the full width of the content sheet: the footer
     reaches past the content padding on both sides and pads back in. */
  .site-footer {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
    margin-inline: calc(-1 * var(--sl-content-pad-x));
    padding-inline: var(--sl-content-pad-x);
    color: var(--aifs-color-text-body);
    border-top: var(--aifs-border-width-standard) solid var(--aifs-color-border-subtle);
    /* No padding below: the content panel's padding ends the sheet. */
    padding-block: 1.25rem 0;
    font-size: 0.9rem;
  }

  .site-footer-inner {
    max-width: var(--sl-content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .site-footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .site-footer-nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer-nav a:hover,
  .site-footer-nav a:focus-visible {
    color: var(--aifs-color-link-standard);
    text-decoration: underline;
  }

  :global(:root[data-theme='dark']) .site-footer-nav a:hover,
  :global(:root[data-theme='dark']) .site-footer-nav a:focus-visible {
    color: var(--aifs-color-link-standard);
  }

  .site-footer-nav a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  :global(#plugin-lightbox) {
    max-width: min(96vw, 1200px);
    max-height: 92vh;
    padding: 12px;
    border: 0;
    border-radius: 8px;
    background: var(--aifs-color-surface-page);
  }

  :global(#plugin-lightbox::backdrop) {
    background: rgb(0 0 0 / 0.72);
  }

  :global(#plugin-lightbox img) {
    display: block;
    max-width: 100%;
    max-height: calc(92vh - 48px);
    margin: 0 auto;
  }

  :global(.plugin-lightbox__close) {
    display: block;
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--aifs-color-text-body);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
