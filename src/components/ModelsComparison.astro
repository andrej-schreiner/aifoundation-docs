---
import pricingData from './PlansPageFeatures/PlansData/PlansModelData/v1.20.2/all-pricing--2026-04-24.json';
import { getLogo } from '../shared/lib/logos';
import { getProviderTooltips } from '../shared/lib/providerTooltips';
import { cloudFullNameFor, cloudLabelFor } from '../shared/lib/cloudLabelOverrides';
import {
  CACHED_INPUT_PRICE_PERCENT,
  cachedInputPrice,
  hasCachedTokenPricing,
} from '../shared/lib/cachedTokenPricing';
import { formatEuro } from '../shared/lib/displayFormat';
import Tooltip from './Tooltip.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
// Per-model reasoning_effort values from the platform datasheet; refreshed by
// scripts/fetch-model-parameters.mjs before each build, kept as last known good.
import reasoningEffortData from '../data/reasoning-effort.json';
// Where each model reports its reasoning token count in `usage` (engine-dependent).
import reasoningTokensUsageData from '../data/reasoning-tokens-usage.json';

type CategoryProp = 'llms' | 'coding' | 'vision' | 'embeddings' | 'audio' | 'image-generation';
// Capability-derived filter for pages where "show me every model that can do
// X" beats curating a category list. Vision is the motivating case: an LLM
// like Gemini 3 Flash accepts image input but isn't *primary-purpose* vision,
// so a category-only model would hide it from /models/vision.
type CapabilityFilter = 'accepts-image' | 'accepts-audio' | 'emits-audio' | 'emits-image';
interface Props {
  category?: CategoryProp;
  capabilityFilter?: CapabilityFilter;
}
const { category: categoryFilter, capabilityFilter } = Astro.props as Props;

// Locale detection (mirrors AvailableModels.astro / PlansPage.astro pattern)
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const localePrefix = isDE ? '/de' : '';

// Models that are no longer offered through the regular plans (mirrors AvailableModels.astro)
const OFFLINE_MODELS = new Set([
  'gpt-4.1-nano',
  'gpt-4o-mini',
  'GPT-5-Codex',
  'gpt-5-nano',
  'Mistral-Large-2411',
  'Mistral-Medium-3',
  'o1',
]);

type Category = 'llms' | 'coding' | 'vision' | 'embeddings' | 'audio' | 'image-generation';

// PRIMARY_CATEGORY = each model's *home* category. Sparse on purpose: only
// models whose primary purpose is NOT general-purpose LLM appear here.
// Everything else defaults to 'llms'.
//
// Additional category membership is *derived* from modalities — see
// deriveCategories() below. So Qwen 3.6 35B (Text+Image in) is primary 'llms'
// and gains 'vision' via derivation, surfacing on both /models/llms and
// /models/vision. Gemini-class multimodal LLMs gain 'vision' AND 'audio'
// the same way.
//
// Why some models need explicit non-llms primaries:
//   - 'coding': no modality signals coding-specialisation; must be tagged.
//   - 'audio': Whisper accepts Audio AND outputs Text — without an explicit
//     primary it would be added to /models/llms (text-out default). Same
//     logic for embeddings (text-in) and image-generation (image-out).
const PRIMARY_CATEGORY: Record<string, Category> = {
  // Coding-specialised (per OpenAI/Alibaba positioning).
  'Qwen3-Coder-30B-A3B-Instruct': 'coding',
  'gpt-5-codex': 'coding',
  // Audio: speech-to-text. Primary 'audio' so they don't pollute /models/llms.
  'whisper-large-v3': 'audio',
  'whisper-large-v3-turbo': 'audio',
  // Embeddings: Text → Vector. Primary 'embeddings' keeps them off /models/llms.
  'jina-embeddings-v2-base-de': 'embeddings',
  'qwen3-embedding-8b': 'embeddings',
  // OCR (document parsing): Image -> Text. Primary 'vision' keeps them off /models/llms.
  'LightOnOCR-3-4B-Preview': 'vision',
  'PaddleOCR-VL-1.6-Preview': 'vision',
  'text-embedding-ada-002': 'embeddings',
  'text-embedding-bge-m3': 'embeddings',
  // Image generation: outputs Image. Primary 'image-generation' keeps them off
  // /models/llms. They still surface on /models/vision via image-input derivation.
  'gemini-3-pro-image': 'image-generation',
  'gpt-image-2': 'image-generation',
};

function resolvePrimaryCategory(exactModelName: string): Category {
  return PRIMARY_CATEGORY[exactModelName] ?? 'llms';
}

// Multi-category derivation. A model's `categories` array is its primary
// plus any modality-driven additions: image input → 'vision', any audio
// → 'audio', image output → 'image-generation', vector output → 'embeddings'.
// Returned in stable display order so the Category column renders consistently.
// Extra category memberships that cannot be inferred from modalities.
// 'coding' has no modality signal (see the PRIMARY_CATEGORY note), so a
// general-purpose LLM that is also strong at code must be tagged explicitly to
// appear on /models/coding in addition to its primary category (/models/llms).
const EXTRA_CATEGORIES: Record<string, Category[]> = {
  'GLM-5.2': ['coding'],
  // GLM-5.3-Flash is positioned by Z.ai as a coding/agentic model —
  // its model card reports it approaching Claude Opus 4.8 on coding and
  // agentic benchmarks — but stays primary 'llms' as a general-purpose model.
  'GLM-5.3-Flash': ['coding'],
  // Qwen 3.8 27B is coding-strong per Qwen's model card — it leads
  // Qwen3.6-27B on SWE-bench Pro and Terminal Bench — but stays primary 'llms'
  // as a general-purpose model.
  'Qwen3.8-27B-FP8': ['coding'],
};

function deriveCategories(primary: Category, caps: Capabilities, extra: Category[] = []): Category[] {
  const cats = new Set<Category>([primary, ...extra]);
  if (caps.inputModalities.includes('Image')) cats.add('vision');
  if (caps.inputModalities.includes('Audio') || caps.outputModalities.includes('Audio')) cats.add('audio');
  if (caps.outputModalities.includes('Image')) cats.add('image-generation');
  if (caps.outputModalities.includes('Vector')) cats.add('embeddings');
  const ORDER: Category[] = ['llms', 'coding', 'vision', 'image-generation', 'audio', 'embeddings'];
  return ORDER.filter((c) => cats.has(c));
}

// ---------------- Capabilities ----------------

type Creator =
  | 'Meta'
  | 'OpenAI'
  | 'Anthropic'
  | 'Google'
  | 'Google Gemma'
  | 'Mistral'
  | 'Alibaba Cloud'
  | 'Zhipu AI'
  | 'T-Systems'
  | 'Other';
type InputModality = 'Text' | 'Image' | 'Audio';
type OutputModality = 'Text' | 'Image' | 'Audio' | 'Vector';

interface Capabilities {
  creator: Creator;
  inputModalities: InputModality[];
  outputModalities: OutputModality[];
  streaming: boolean;
  toolCalling: boolean;
}

function inferCreator(exactModelName: string): Creator {
  const n = exactModelName;
  if (/^Llama-/i.test(n)) return 'Meta';
  if (/^Mistral-/i.test(n) || /^mistral-/i.test(n)) return 'Mistral';
  if (/^Qwen/i.test(n)) return 'Alibaba Cloud';
  if (/^GLM-/i.test(n)) return 'Zhipu AI';
  if (/^claude-/i.test(n)) return 'Anthropic';
  if (/^(diffusion)?gemma-/i.test(n)) return 'Google Gemma';
  if (/^gemini-/i.test(n)) return 'Google';
  if (/^(gpt-|o1-|o3-|o4-|gpt-image)/i.test(n)) return 'OpenAI';
  return 'Other';
}

// Default capability shape per category (creator filled in per-model below).
//
// Categories describe a model's *primary purpose* (one per model). They drive
// the category page filters (/models/llms, /models/coding, /models/embeddings,
// /models/audio, /models/image-generation) and the category column.
//
// "Cross-cutting" pages — currently /models/vision — instead use the
// `capabilityFilter` prop so any model whose modalities qualify shows up,
// regardless of category. That keeps Gemini-class LLMs (Text+Image input,
// Text output) visible on the Vision page without forcing every multimodal
// model into a single Category slot.
const CATEGORY_DEFAULTS: Record<Category, Omit<Capabilities, 'creator'>> = {
  llms:               { inputModalities: ['Text'],          outputModalities: ['Text'],   streaming: true,  toolCalling: true  },
  coding:             { inputModalities: ['Text'],          outputModalities: ['Text'],   streaming: true,  toolCalling: true  },
  vision:             { inputModalities: ['Text', 'Image'], outputModalities: ['Text'],   streaming: true,  toolCalling: true  },
  embeddings:         { inputModalities: ['Text'],          outputModalities: ['Vector'], streaming: false, toolCalling: false },
  audio:              { inputModalities: ['Audio'],         outputModalities: ['Text'],   streaming: false, toolCalling: false },
  'image-generation': { inputModalities: ['Text'],          outputModalities: ['Image'],  streaming: false, toolCalling: false },
};

// Per-model overrides for cases where the category default + inferCreator
// would produce the wrong answer. Sparse on purpose — everything not listed
// here resolves from category default + creator inferred from the model name.
//
// Audited against vendor model cards. Be specific to the named model when
// adding entries: "this vendor is multimodal" is not enough — mini/nano/oss
// variants often differ from their flagship.
const MODEL_CAPABILITY_OVERRIDES: Record<string, Partial<Capabilities>> = {
  // Creator overrides (inferCreator has no pattern for these prefixes):
  'text-embedding-ada-002': { creator: 'OpenAI' },
  'whisper-large-v3':       { creator: 'OpenAI' },
  'whisper-large-v3-turbo': { creator: 'OpenAI' },

  // Image-capable LLMs — Category stays 'llms', but inputModalities includes
  // 'Image' so they pass capabilityFilter='accepts-image' on /models/vision.
  // Gemini also accepts Audio input per Google's Gemini API docs.
  'gemini-2.5-flash':              { inputModalities: ['Text', 'Image', 'Audio'] },
  'gemini-2.5-pro':                { inputModalities: ['Text', 'Image', 'Audio'] },
  'gemini-2.5-pro-long-context':   { inputModalities: ['Text', 'Image', 'Audio'] },
  'gemini-3-flash':                { inputModalities: ['Text', 'Image', 'Audio'] },
  'gemini-3-pro':                  { inputModalities: ['Text', 'Image', 'Audio'] },
  'gemini-3-pro-long-context':     { inputModalities: ['Text', 'Image', 'Audio'] },
  'gemini-3.8-flash':              { inputModalities: ['Text', 'Image', 'Audio'] },
  'gemma-4-31B-it-FP8':            { inputModalities: ['Text', 'Image'] },
  // Mistral Small 4 is multimodal (Text+Image in). Keys match the GA ids in the
  // pricing catalog (the earlier `-Preview`/`-preview` suffixes are retired).
  'Mistral-Small-4-119B-2603':     { inputModalities: ['Text', 'Image'] },
  // Qwen 3.6 35B (Qwen3.6-35B-A3B) is a natively multimodal vision-language
  // model — Text+Image in — replacing the retired Qwen3-VL as the T-Cloud
  // vision option. primary='llms' (default) so it surfaces on both
  // /models/llms and /models/vision via multi-category derivation.
  'Qwen-3.6-35B-FP8': { inputModalities: ['Text', 'Image'] },
  // Qwen 3.8 27B is a native vision-language model (image + video
  // understanding per the model card). Video has no InputModality member, so
  // only Text+Image are declared here.
  'Qwen3.8-27B-FP8': { inputModalities: ['Text', 'Image'] },
  // GLM-5.3-Flash is the first natively multimodal model in the
  // GLM-5 series — Text+Image in, Text out per the model card.
  'GLM-5.3-Flash': { inputModalities: ['Text', 'Image'] },
  // DiffusionGemma 26B A4B (preview) takes Text+Image on chat completions and
  // on /decisions.
  'diffusiongemma-26B-A4B-it-Preview': { inputModalities: ['Text', 'Image'] },
  // d3 (preview) is a decision model: /decisions only, Text+Image in. It
  // generates no text, so no streaming and no tool calling.
  'd3-preview': { inputModalities: ['Text', 'Image'], streaming: false, toolCalling: false },
  // OCR models (preview): page or element image in, Markdown / text out. Image
  // only: the text part of a request is a fixed mode keyword (LightOnOCR:
  // none or "grounding"; PaddleOCR-VL: a task prompt such as "OCR:"), not
  // free text, so you cannot send text or ask questions about the image.
  // Streaming works; no tool calling.
  'LightOnOCR-3-4B-Preview':  { inputModalities: ['Image'], streaming: true, toolCalling: false },
  'PaddleOCR-VL-1.6-Preview': { inputModalities: ['Image'], streaming: true, toolCalling: false },
  'gpt-4o-2024-11-20':             { inputModalities: ['Text', 'Image'] },
  'gpt-4o-mini-2024-07-18':        { inputModalities: ['Text', 'Image'] },
  'gpt-4.1-2025-04-14':            { inputModalities: ['Text', 'Image'] },
  'gpt-4.1-mini-2025-04-14':       { inputModalities: ['Text', 'Image'] },
  'gpt-4.1-nano-2025-04-14':       { inputModalities: ['Text', 'Image'] },
  'gpt-5':                         { inputModalities: ['Text', 'Image'] },
  'gpt-5-mini':                    { inputModalities: ['Text', 'Image'] },
  'gpt-5-nano':                    { inputModalities: ['Text', 'Image'] },
  'gpt-5.2':                       { inputModalities: ['Text', 'Image'] },
  'mistral-medium-3':              { inputModalities: ['Text', 'Image'] },
  'claude-3-7-sonnet':             { inputModalities: ['Text', 'Image'] },
  'claude-haiku-4.5':              { inputModalities: ['Text', 'Image'] },
  'claude-opus-4.5':               { inputModalities: ['Text', 'Image'] },
  'claude-opus-4.6':               { inputModalities: ['Text', 'Image'] },
  'claude-sonnet-4':               { inputModalities: ['Text', 'Image'] },
  'claude-sonnet-4.5':             { inputModalities: ['Text', 'Image'] },
  'claude-sonnet-4.5-long-context':{ inputModalities: ['Text', 'Image'] },
  'claude-sonnet-4.6':             { inputModalities: ['Text', 'Image'] },
  'claude-opus-5.5':               { inputModalities: ['Text', 'Image'] },
  'claude-sonnet-5.5':             { inputModalities: ['Text', 'Image'] },
  'o3-2025-04-16':                 { inputModalities: ['Text', 'Image'] },
  'o4-mini-2025-04-16':            { inputModalities: ['Text', 'Image'] },

  // OpenAI o-series reasoning models — quirks vs the llms default
  // (streaming: true, toolCalling: true). Audited against OpenAI docs (2026-05):
  //  - o1: vision + tools, but streaming returns 400 on this snapshot.
  //  - o1-mini: text-only at launch — no vision, no tools, no streaming.
  //  - o3 / o4-mini: vision + tools + streaming.
  //  - o3-mini: text-only reasoning model with tools + streaming (matches default).
  'o1-2024-12-17':                 { inputModalities: ['Text', 'Image'], streaming: false },
  'o1-mini-2024-09-12':            { streaming: false, toolCalling: false },

  // Coding-specialised — gpt-5-codex inherits GPT-5's image input via the
  // Responses API per OpenAI's Codex models docs.
  'gpt-5-codex':                   { inputModalities: ['Text', 'Image'] },

  // Image generation overrides (category default is text→image, no streaming,
  // no tools). GPT Image 2 accepts text+image input (text→image and image→image)
  // and streams partial images. Gemini 3 Pro Image accepts text+image and emits
  // both an image and accompanying text; per Google's docs it does NOT stream.
  'gpt-image-2':                   { inputModalities: ['Text', 'Image'], streaming: true },
  'gemini-3-pro-image':            {
    inputModalities: ['Text', 'Image'],
    outputModalities: ['Image', 'Text'],
    streaming: false,
  },
};

function resolveCapabilities(exactModelName: string, category: Category): Capabilities {
  return {
    creator: inferCreator(exactModelName),
    ...CATEGORY_DEFAULTS[category],
    ...MODEL_CAPABILITY_OVERRIDES[exactModelName],
  };
}

// ---------------- Cloud (replaces Sovereignty) ----------------

type CloudKey = 'Telekom' | 'Azure' | 'GCP' | 'Other';

function resolveCloud(deploymentRegion: string): CloudKey {
  const region = (deploymentRegion ?? '').toLowerCase();
  // Mirror normalization from ModelsTable.astro: Open Telekom Cloud / OTC → Telekom
  if (region.startsWith('otc') || region === 'open telekom cloud' || region === 'otc') return 'Telekom';
  if (region.startsWith('azure')) return 'Azure';
  if (region.startsWith('gcp') || region.startsWith('google')) return 'GCP';
  return 'Other';
}

function cloudFullName(cloud: CloudKey): string {
  switch (cloud) {
    case 'Telekom':
      return 'T-Cloud Public';
    case 'Azure':
      return 'Microsoft Azure';
    case 'GCP':
      return 'Google Cloud Platform';
    default:
      return 'Other';
  }
}

function cloudTagClass(cloud: CloudKey): string {
  return cloud === 'Telekom' ? 'tag-tcloud' : 'tag-cloud';
}

// ---------------- Compile model list ----------------

interface CompiledModel {
  exactModelName: string;
  displayModelName: string;
  category: Category;        // primary purpose — drives sort + leads the badge list
  categories: Category[];    // primary + modality-derived (see deriveCategories)
  cloud: CloudKey;
  contextWindow: string;
  reasoningEffort: string[];  // accepted reasoning_effort values; empty when none is published
  reasoningTokensUsage: ReasoningTokensUsage | null;  // where usage reports reasoning tokens; null = not documented
  inputPricePerMillionTokens: number | null;
  outputPricePerMillionTokens: number | null;
  cachedInputPricePerMillionTokens: number | null;
  cachedPricingPublished: boolean;
  plans: string[];
  capabilities: Capabilities;
}

// Datasheet model names are matched to exactModelName case-insensitively: the
// datasheet keeps the Bifrost spelling (e.g. `GPT-5-Codex`), the pricing export
// the LLM Hub one.
// 'completion_tokens_details' = the OpenAI field completion_tokens_details.reasoning_tokens
// (vLLM-served models); 'usage' = top-level usage.reasoning_tokens (SGLang-served models);
// 'none' = the model reports no reasoning token count.
type ReasoningTokensUsage = 'completion_tokens_details' | 'usage' | 'none';
const reasoningTokensUsageByName = new Map<string, ReasoningTokensUsage>(
  Object.entries(reasoningTokensUsageData.models as Record<string, ReasoningTokensUsage>).map(([name, v]) => [
    name.toLowerCase(),
    v,
  ]),
);

const reasoningEffortByName = new Map<string, string[]>(
  Object.entries(reasoningEffortData.models as Record<string, { values: string[] }>).map(([name, v]) => [
    name.toLowerCase(),
    v.values,
  ]),
);

// exactModelName -> CompiledModel; plans accumulate across packages.
const byName = new Map<string, CompiledModel>();

for (const pkg of pricingData as Array<{
  packageName: string;
  modelQuotaConfigs: Array<Record<string, unknown>>;
}>) {
  for (const entry of pkg.modelQuotaConfigs ?? []) {
    const exactModelName = entry.exactModelName as string;
    if (OFFLINE_MODELS.has(exactModelName)) continue;
    const existing = byName.get(exactModelName);
    if (existing) {
      if (!existing.plans.includes(pkg.packageName)) existing.plans.push(pkg.packageName);
      continue;
    }
    const deploymentRegion = entry.deploymentRegion as string;
    const category = resolvePrimaryCategory(exactModelName);
    const capabilities = resolveCapabilities(exactModelName, category);
    byName.set(exactModelName, {
      exactModelName,
      displayModelName: entry.displayModelName as string,
      category,
      categories: deriveCategories(category, capabilities, EXTRA_CATEGORIES[exactModelName] ?? []),
      cloud: resolveCloud(deploymentRegion),
      contextWindow: (entry.contextWindow as string) ?? '—',
      reasoningEffort: reasoningEffortByName.get(exactModelName.toLowerCase()) ?? [],
      reasoningTokensUsage: reasoningTokensUsageByName.get(exactModelName.toLowerCase()) ?? null,
      inputPricePerMillionTokens: (entry.inputPricePerMillionTokens as number) ?? null,
      outputPricePerMillionTokens: (entry.outputPricePerMillionTokens as number) ?? null,
      cachedInputPricePerMillionTokens: cachedInputPrice(
        entry.inputPricePerMillionTokens as number | null,
        deploymentRegion,
      ),
      cachedPricingPublished: hasCachedTokenPricing(deploymentRegion),
      plans: [pkg.packageName],
      capabilities,
    });
  }
}

// Stable plan order
const planOrder: Record<string, number> = { Essential: 0, Professional: 1, Agentic: 2, Test: 3 };
for (const m of byName.values()) {
  m.plans.sort((a, b) => (planOrder[a] ?? 99) - (planOrder[b] ?? 99));
}

// Default order: Telekom-first by cloud priority, then alphabetical by
// display name. Client-side sort (column-header clicks) can override.
const CLOUD_RANK: Record<CloudKey, number> = { Telekom: 0, Azure: 1, GCP: 2, Other: 3 };

function matchesCapability(m: CompiledModel, cap: CapabilityFilter | undefined): boolean {
  if (!cap) return true;
  const inputs = m.capabilities.inputModalities;
  const outputs = m.capabilities.outputModalities;
  switch (cap) {
    case 'accepts-image': return inputs.includes('Image');
    case 'accepts-audio': return inputs.includes('Audio');
    case 'emits-audio':   return outputs.includes('Audio');
    case 'emits-image':   return outputs.includes('Image');
  }
}

const allModels = [...byName.values()]
  .filter((m) => (categoryFilter ? m.categories.includes(categoryFilter) : true))
  .filter((m) => matchesCapability(m, capabilityFilter))
  .sort((a, b) => {
    const rankDiff = CLOUD_RANK[a.cloud] - CLOUD_RANK[b.cloud];
    if (rankDiff !== 0) return rankDiff;
    return a.displayModelName.localeCompare(b.displayModelName);
  });

// ---------------- Translations & formatters ----------------

const t = {
  heading: isDE ? 'Modelle im Vergleich' : 'Models Comparison',
  colModel: isDE ? 'Modell' : 'Model',
  colCategory: isDE ? 'Kategorie' : 'Category',
  colProvider: isDE ? 'Anbieter' : 'Provider',
  colCloud: isDE ? 'Cloud' : 'Cloud',
  colInput: isDE ? 'Eingabe' : 'Input',
  colOutput: isDE ? 'Ausgabe' : 'Output',
  colStreaming: isDE ? 'Streaming-Ausgabe' : 'Streaming output',
  colTools: isDE ? 'Tool Calling' : 'Tool calling',
  colContext: isDE ? 'Kontext' : 'Context',
  colReasoningEffort: 'Reasoning Effort',
  colInputPrice: isDE ? 'Eingabe €/M' : 'In €/M',
  colOutputPrice: isDE ? 'Ausgabe €/M' : 'Out €/M',
  colCachedPrice: isDE ? 'Cached €/M' : 'Cached €/M',
  colPlans: isDE ? 'Tarife' : 'Plans',
  reset: isDE ? 'Filter zurücksetzen' : 'Reset filters',
  showing: isDE ? 'Zeige' : 'Showing',
  of: isDE ? 'von' : 'of',
  models: isDE ? 'Modellen' : 'models',
  selected: isDE ? 'ausgewählt' : 'selected',
  noResults: isDE ? 'Keine Modelle entsprechen den Filtern.' : 'No models match the current filters.',
  tooltipStreaming: isDE
    ? 'Token-für-Token-Ausgabe via Server-Sent Events. Geeignet für niedrige Latenz und Echtzeit-UI.'
    : 'Token-by-token output via Server-Sent Events. Suitable for low-latency, real-time UI.',
  tooltipTools: isDE
    ? 'Funktions-/Tool-Aufrufe (OpenAI-kompatibel). Das Modell kann strukturierte Tool-Aufrufe zurückgeben.'
    : 'Function / tool calling (OpenAI-compatible). The model can return structured tool invocations.',
  tooltipCachedPrice: isDE
    ? `Preis pro Million Prompt-Tokens, die aus dem Prefix-Cache bedient werden: ${CACHED_INPUT_PRICE_PERCENT} % des normalen Eingabepreises. Gilt nur für T-Cloud-gehostete Modelle — für externe Anbieter wird die Cache-Preisgestaltung später ergänzt.`
    : `Price per million prompt tokens served from the prefix cache: ${CACHED_INPUT_PRICE_PERCENT}% of the normal input price. T-Cloud-hosted models only — cached pricing for external providers will be added later.`,
  cachedPriceUnavailable: isDE ? 'n. v.' : 'n/a',
  tooltipReasoningEffort: isDE
    ? 'Zulässige Werte des Parameters reasoning_effort laut Modell-Datenblatt der Plattform. „-“: für dieses Modell sind keine Werte veröffentlicht. Siehe den Reasoning-Guide.'
    : 'Accepted values of the reasoning_effort parameter, from the platform model datasheet. "-": no values are published for this model. See the Reasoning Control guide.',
  reasoningEffortNone: '—',
  colReasoningTokensUsage: isDE ? 'Reasoning-Tokens in usage' : 'Reasoning tokens in usage',
  tooltipReasoningTokensUsage: isDE
    ? 'Wo die Antwort die Anzahl der Reasoning-Tokens im usage-Objekt meldet: completion_tokens_details.reasoning_tokens, usage.reasoning_tokens oder not reported (das Modell denkt, die Antwort enthält aber keine Zahl). „-“: das Modell hat kein Reasoning.'
    : 'Where the response reports the number of reasoning tokens in the usage object: completion_tokens_details.reasoning_tokens, usage.reasoning_tokens, or not reported (the model reasons, but the response carries no count). "-": the model has no reasoning.',
  reasoningTokensNotReported: 'not reported',
  reasoningTokensUnknown: '—',
};

const PROVIDER_TOOLTIPS = getProviderTooltips(isDE);

const CLOUD_TOOLTIPS: Record<CloudKey, string> = isDE
  ? {
      Telekom: 'Gehostet auf T-Cloud Public — der souveränen Infrastruktur der Telekom in Deutschland.',
      Azure:   'Gehostet auf Microsoft Azure (EU-Regionen).',
      GCP:     'Gehostet auf Google Cloud Platform (EU-Regionen).',
      Other:   'Bei einem Drittanbieter gehostet.',
    }
  : {
      Telekom: "Hosted on T-Cloud Public — Telekom's sovereign infrastructure in Germany.",
      Azure:   'Hosted on Microsoft Azure (EU regions).',
      GCP:     'Hosted on Google Cloud Platform (EU regions).',
      Other:   'Hosted by a third-party provider.',
    };

const CATEGORY_LABELS: Record<Category, string> = {
  llms: 'LLM',
  coding: 'Coding',
  vision: 'Vision',
  embeddings: 'Embedding',
  audio: 'Audio',
  'image-generation': isDE ? 'Bildgenerierung' : 'Image Generation',
};

const MODALITY_LABELS: Record<InputModality | OutputModality, string> = {
  Text: 'Text',
  Image: isDE ? 'Bild' : 'Image',
  Audio: 'Audio',
  Vector: isDE ? 'Vektor' : 'Vector',
};

// `null` means the price has not been published yet (placeholder rows for
// newly announced models); `0` means the model is genuinely free of charge.
function formatPrice(n: number | null | undefined): string {
  return formatEuro(n, 2);
}

function formatCachedPrice(m: CompiledModel): string {
  if (!m.cachedPricingPublished) return t.cachedPriceUnavailable;
  const value = m.cachedInputPricePerMillionTokens;
  if (value == null) return 'xx';
  // A cached price is 15% of the input price, so two decimals would round most
  // of them to a misleading value (0.225 → 0.22, 0.0075 → 0.01). Keep up to
  // four decimals and drop trailing zeros.
  return formatEuro(value, 4);
}

function planHref(plan: string): string {
  return `${localePrefix}/plans/${plan.toLowerCase()}/`;
}

function planTagClass(plan: string): string {
  return `tag-plan-${plan.toLowerCase()}`;
}

// ---------------- Filter values (unique sets) ----------------

// Unique-value sets per filter, pruned to only what's actually in the current row set.
// Flatten across the multi-category set so the filter chip lists every
// category any visible row belongs to, not just primary categories.
const uniqueCategories = [...new Set(allModels.flatMap((m) => m.categories))];
const uniqueProviders = [...new Set(allModels.map((m) => m.capabilities.creator))].sort();
const uniqueClouds = (['Telekom', 'Azure', 'GCP', 'Other'] as CloudKey[]).filter((c) =>
  allModels.some((m) => m.cloud === c),
);
const uniqueInputs = (['Text', 'Image', 'Audio'] as InputModality[]).filter((mod) =>
  allModels.some((m) => m.capabilities.inputModalities.includes(mod)),
);
const uniqueOutputs = (['Text', 'Image', 'Audio', 'Vector'] as OutputModality[]).filter((mod) =>
  allModels.some((m) => m.capabilities.outputModalities.includes(mod)),
);
const uniquePlans = ['Essential', 'Professional', 'Agentic', 'Test'].filter((p) =>
  allModels.some((m) => m.plans.includes(p)),
);

// Filter chips, declared once. Adding a filter = one entry here + one entry in
// the runtime filterDefs (in the <script> below). The SSR template loops over
// this array rather than copy-pasting eight near-identical <details> blocks.
interface FilterChip {
  id: string;
  label: string;
  values: readonly string[];
  optionLabel: (v: string) => string;
  defaultChecked?: (v: string) => boolean;
}
const boolToTick = (v: string) => (v === 'true' ? '✓' : '✗');
const filterChips: FilterChip[] = [
  ...(categoryFilter
    ? []
    : [{
        id: 'category',
        label: t.colCategory,
        values: uniqueCategories,
        optionLabel: (v: string) => CATEGORY_LABELS[v as Category],
      }]),
  { id: 'provider', label: t.colProvider, values: uniqueProviders, optionLabel: (v) => v },
  { id: 'cloud', label: t.colCloud, values: uniqueClouds, optionLabel: (v) => v },
  { id: 'input', label: t.colInput, values: uniqueInputs, optionLabel: (v) => MODALITY_LABELS[v as InputModality] },
  { id: 'output', label: t.colOutput, values: uniqueOutputs, optionLabel: (v) => MODALITY_LABELS[v as OutputModality] },
  { id: 'streaming', label: t.colStreaming, values: ['true', 'false'], optionLabel: boolToTick },
  { id: 'tools', label: t.colTools, values: ['true', 'false'], optionLabel: boolToTick },
  { id: 'plans', label: t.colPlans, values: uniquePlans, optionLabel: (v) => v },
];

// Build the row-data payload consumed by the client script. We render the
// table SSR (so non-JS users see all rows); the script only toggles row
// visibility based on filter state and re-orders rows for sort, so we don't
// ship full HTML twice.
function parseContextWindow(raw: string): number {
  const match = (raw ?? '').match(/^([\d.,]+)\s*([KMkm])?/);
  if (!match) return Number.NaN;
  const num = parseFloat(match[1].replace(/,/g, ''));
  if (!Number.isFinite(num)) return Number.NaN;
  const suffix = (match[2] ?? '').toLowerCase();
  if (suffix === 'k') return num * 1_000;
  if (suffix === 'm') return num * 1_000_000;
  return num;
}

const rowDataPayload = allModels.map((m) => ({
  key: m.exactModelName,
  displayModelName: m.displayModelName,
  category: m.category,           // primary — used as the sort key
  categories: m.categories,       // multi — used by the chip filter
  provider: m.capabilities.creator,
  cloud: m.cloud,
  inputs: m.capabilities.inputModalities,
  outputs: m.capabilities.outputModalities,
  streaming: m.capabilities.streaming,
  toolCalling: m.capabilities.toolCalling,
  contextWindowRaw: m.contextWindow,
  contextWindowNum: parseContextWindow(m.contextWindow),
  reasoningEffort: m.reasoningEffort,
  reasoningTokensUsage: m.reasoningTokensUsage,
  inputPrice: m.inputPricePerMillionTokens,
  outputPrice: m.outputPricePerMillionTokens,
  cachedInputPrice: m.cachedInputPricePerMillionTokens,
  plans: m.plans,
}));
---

<div
  class="models-comparison"
  data-rows={JSON.stringify(rowDataPayload)}>
  <div class="models-comparison__filterbar not-content" role="group" aria-label={t.heading}>
    {filterChips.map((chip) => (
      <details class="mc-filter" data-filter={chip.id}>
        <summary>
          <span class="mc-filter__label">{chip.label}</span>
          <span class="mc-filter__count" data-count></span>
        </summary>
        <div class="mc-filter__menu">
          {chip.values.map((v) => (
            <label class="mc-filter__option">
              <input
                type="checkbox"
                value={v}
                checked={chip.defaultChecked ? chip.defaultChecked(v) : true}
              />
              <span>{chip.optionLabel(v)}</span>
            </label>
          ))}
        </div>
      </details>
    ))}

    <Button variant="secondary" size="small" class="mc-reset" data-reset>{t.reset}</Button>
  </div>

  <div class="models-comparison__status" aria-live="polite">
    <span data-status-text>
      {t.showing} <span data-visible-count>{allModels.length}</span> {t.of} <span data-total-count>{allModels.length}</span> {t.models}
    </span>
  </div>

  <div class="models-comparison__scroll">
    <table class="models-comparison-table">
      <thead>
        <tr>
          {[
            { key: 'model', label: t.colModel, cls: '', tooltip: undefined as string | undefined },
            ...(!categoryFilter ? [{ key: 'category', label: t.colCategory, cls: '', tooltip: undefined as string | undefined }] : []),
            { key: 'provider', label: t.colProvider, cls: '', tooltip: undefined as string | undefined },
            { key: 'cloud', label: t.colCloud, cls: '', tooltip: undefined as string | undefined },
            { key: 'input', label: t.colInput, cls: '', tooltip: undefined as string | undefined },
            { key: 'output', label: t.colOutput, cls: '', tooltip: undefined as string | undefined },
            { key: 'streaming', label: t.colStreaming, cls: 'center', tooltip: t.tooltipStreaming },
            { key: 'tools', label: t.colTools, cls: 'center', tooltip: t.tooltipTools },
            { key: 'context', label: t.colContext, cls: '', tooltip: undefined as string | undefined },
            { key: 'reasoningEffort', label: t.colReasoningEffort, cls: '', tooltip: t.tooltipReasoningEffort },
            { key: 'reasoningTokensUsage', label: t.colReasoningTokensUsage, cls: '', tooltip: t.tooltipReasoningTokensUsage },
            { key: 'inputPrice', label: t.colInputPrice, cls: 'num', tooltip: undefined as string | undefined },
            { key: 'outputPrice', label: t.colOutputPrice, cls: 'num', tooltip: undefined as string | undefined },
            { key: 'cachedInputPrice', label: t.colCachedPrice, cls: 'num', tooltip: t.tooltipCachedPrice },
            { key: 'plans', label: t.colPlans, cls: '', tooltip: undefined as string | undefined },
          ].map((h) => (
            <th data-sort={h.key} class={h.cls}>
              {h.tooltip ? (
                <Tooltip text={h.tooltip} maxWidth="22rem">
                  <button type="button" class="mc-sort-header" aria-label={`Sort by ${h.label}`}>
                    <Icon name="content-sort-indicator-down" size={16} class="mc-sort-icon" />
                    <span>{h.label}</span>
                  </button>
                </Tooltip>
              ) : (
                <button type="button" class="mc-sort-header" aria-label={`Sort by ${h.label}`}>
                  <Icon name="content-sort-indicator-down" size={16} class="mc-sort-icon" />
                  <span>{h.label}</span>
                </button>
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {allModels.map((m) => {
          const creatorLogo = getLogo(m.capabilities.creator);
          const fullCloud = cloudFullName(m.cloud);
          return (
            <tr data-key={m.exactModelName}>
              <td><strong>{m.displayModelName}</strong></td>
              {!categoryFilter && (
                <td>{m.categories.map((cat) => CATEGORY_LABELS[cat]).join(', ')}</td>
              )}
              <td>
                <Tooltip text={PROVIDER_TOOLTIPS[m.capabilities.creator] ?? m.capabilities.creator} maxWidth="24rem">
                  <span class="creator-brand" aria-label={m.capabilities.creator}>
                    {creatorLogo
                      ? <img class="creator-brand__icon" src={creatorLogo} alt={m.capabilities.creator} width="18" height="18" />
                      : <span class="creator-brand__fallback">{m.capabilities.creator}</span>}
                  </span>
                </Tooltip>
              </td>
              <td>
                <Tooltip text={cloudFullNameFor(m.exactModelName, CLOUD_TOOLTIPS[m.cloud])} maxWidth="22rem">
                  <button
                    type="button"
                    class={`plans-tag ${cloudTagClass(m.cloud)} mc-cloud-filter-btn`}
                    data-cloud={m.cloud}
                    aria-label={`Toggle ${m.cloud} cloud in the filter — ${fullCloud}`}
                  >
                    {cloudLabelFor(m.exactModelName, m.cloud)}
                  </button>
                </Tooltip>
              </td>
              <td>{m.capabilities.inputModalities.map((mod) => MODALITY_LABELS[mod]).join(', ')}</td>
              <td>{m.capabilities.outputModalities.map((mod) => MODALITY_LABELS[mod]).join(', ')}</td>
              <td class="center">
                {m.capabilities.streaming
                  ? <span class="mc-cap mc-cap--yes" aria-label="Supported">✓</span>
                  : <span class="mc-cap mc-cap--no"  aria-label="Not supported">✗</span>}
              </td>
              <td class="center">
                {m.capabilities.toolCalling
                  ? <span class="mc-cap mc-cap--yes" aria-label="Supported">✓</span>
                  : <span class="mc-cap mc-cap--no"  aria-label="Not supported">✗</span>}
              </td>
              <td>{m.contextWindow}</td>
              <td class="mc-reasoning-effort">
                {m.reasoningEffort.length > 0
                  ? <span class="mc-effort-values">{m.reasoningEffort.map((v) => <code>{v}</code>)}</span>
                  : <span aria-label="No reasoning_effort values published">{t.reasoningEffortNone}</span>}
              </td>
              <td class="mc-usage-field">
                {m.reasoningTokensUsage === 'completion_tokens_details' && (
                  <code>completion_tokens_details<wbr />.reasoning_tokens</code>
                )}
                {m.reasoningTokensUsage === 'usage' && <code>usage<wbr />.reasoning_tokens</code>}
                {m.reasoningTokensUsage === 'none' && (
                  <span class="mc-usage-field__none">{t.reasoningTokensNotReported}</span>
                )}
                {m.reasoningTokensUsage === null && (
                  <span aria-label="Not documented">{t.reasoningTokensUnknown}</span>
                )}
              </td>
              <td class="num">{formatPrice(m.inputPricePerMillionTokens)}</td>
              <td class="num">{formatPrice(m.outputPricePerMillionTokens)}</td>
              <td class="num">{formatCachedPrice(m)}</td>
              <td>
                <span class="mc-plans">
                  {m.plans.map((p) => (
                    <a class={`plans-tag ${planTagClass(p)}`} href={planHref(p)}>{p}</a>
                  ))}
                </span>
              </td>
            </tr>
          );
        })}
        <tr class="mc-no-results" hidden>
          <td colspan="15" class="mc-no-results__cell">{t.noResults}</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  type RowData = {
    key: string;
    displayModelName: string;
    category: string;        // primary, for sort
    categories: string[];    // multi, for filter chip
    provider: string;
    cloud: string;
    inputs: string[];
    outputs: string[];
    streaming: boolean;
    toolCalling: boolean;
    contextWindowRaw: string;
    contextWindowNum: number;
    reasoningEffort: string[];
    reasoningTokensUsage: 'completion_tokens_details' | 'usage' | 'none' | null;
    inputPrice: number | null;
    outputPrice: number | null;
    cachedInputPrice: number | null;
    plans: string[];
  };

  // Rows whose price is not published yet (null) sort after every priced row,
  // in both directions, instead of being string-compared as "null".
  function priceSortValue(v: number | null): number {
    return v == null ? Number.POSITIVE_INFINITY : v;
  }

  function initModelsComparison(root: HTMLElement) {
    if (root.dataset.mcInit === '1') return;
    root.dataset.mcInit = '1';

    const rows: RowData[] = JSON.parse(root.dataset.rows || '[]');
    const tableRowsByKey = new Map<string, HTMLTableRowElement>();
    const tbody = root.querySelector<HTMLTableSectionElement>('tbody');
    root.querySelectorAll<HTMLTableRowElement>('tbody tr[data-key]').forEach((tr) => {
      const key = tr.dataset.key;
      if (key) tableRowsByKey.set(key, tr);
    });

    const noResultsRow = root.querySelector<HTMLTableRowElement>('.mc-no-results');
    const visibleCountEl = root.querySelector<HTMLElement>('[data-visible-count]');
    const totalCountEl = root.querySelector<HTMLElement>('[data-total-count]');
    if (totalCountEl) totalCountEl.textContent = String(rows.length);

    // Sort state. Default: cloud (Telekom-first via custom rank). SSR-render
    // is already in this order so the first paint matches; subsequent sorts
    // reorder the rows in-place.
    let sortKey = 'cloud';
    let sortAsc = true;
    const CLOUD_RANK: Record<string, number> = { Telekom: 0, Azure: 1, GCP: 2, Other: 3 };

    const filterDefs: Array<{ id: string; type: 'single' | 'multi' | 'bool'; field: keyof RowData }> = [
      { id: 'category', type: 'multi', field: 'categories' },
      { id: 'provider', type: 'single', field: 'provider' },
      { id: 'cloud', type: 'single', field: 'cloud' },
      { id: 'input', type: 'multi', field: 'inputs' },
      { id: 'output', type: 'multi', field: 'outputs' },
      { id: 'streaming', type: 'bool', field: 'streaming' },
      { id: 'tools', type: 'bool', field: 'toolCalling' },
      { id: 'plans', type: 'multi', field: 'plans' },
    ];

    type FilterState = Map<string, Set<string>>;

    function readState(): FilterState {
      const state: FilterState = new Map();
      for (const def of filterDefs) {
        const details = root.querySelector<HTMLElement>(`.mc-filter[data-filter="${def.id}"]`);
        if (!details) continue;
        const checked = new Set<string>();
        details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => {
          if (input.checked) checked.add(input.value);
        });
        state.set(def.id, checked);
      }
      return state;
    }

    function valueToString(value: unknown): string {
      if (typeof value === 'boolean') return value ? 'true' : 'false';
      return String(value);
    }

    function rowPasses(row: RowData, state: FilterState): boolean {
      for (const def of filterDefs) {
        const checked = state.get(def.id);
        if (!checked) continue;
        if (checked.size === 0) return false;
        if (def.type === 'multi') {
          const values = row[def.field] as string[];
          // Row passes this filter if ANY of its values is checked.
          if (!values.some((v) => checked.has(v))) return false;
        } else {
          const v = valueToString(row[def.field]);
          if (!checked.has(v)) return false;
        }
      }
      return true;
    }

    // Locale read from <html lang> (set by Starlight per page) so the
    // aria-label uses the same language as the visible chip label.
    const isDE = document.documentElement.lang === 'de';

    function updateCounts() {
      for (const def of filterDefs) {
        const details = root.querySelector<HTMLElement>(`.mc-filter[data-filter="${def.id}"]`);
        if (!details) continue;
        const all = details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
        const checked = details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked');
        const countEl = details.querySelector<HTMLElement>('[data-count]');
        const isAll = checked.length === all.length;
        if (countEl) {
          countEl.textContent = isAll ? '' : `(${checked.length}/${all.length})`;
        }
        details.classList.toggle('mc-filter--active', !isAll);

        // Mirror the visible (N/M) into a screen-reader-friendly aria-label
        // on the <summary> so AT users hear "Cloud filter, 1 of 3 selected"
        // (or the German equivalent) instead of "Cloud, 1, 3".
        const summary = details.querySelector<HTMLElement>('summary');
        const labelEl = details.querySelector<HTMLElement>('.mc-filter__label');
        if (summary && labelEl) {
          const label = (labelEl.textContent || '').trim();
          if (isAll) {
            // All options selected = no active filter. Let visible label
            // speak for itself; removing aria-label avoids redundant readout.
            summary.removeAttribute('aria-label');
          } else {
            summary.setAttribute(
              'aria-label',
              isDE
                ? `Filter ${label}, ${checked.length} von ${all.length} ausgewählt`
                : `${label} filter, ${checked.length} of ${all.length} selected`,
            );
          }
        }
      }
    }

    function compareRows(a: RowData, b: RowData): number {
      let av: number | string;
      let bv: number | string;
      switch (sortKey) {
        case 'model':
          av = a.displayModelName.toLowerCase();
          bv = b.displayModelName.toLowerCase();
          break;
        case 'category':
          av = a.category.toLowerCase();
          bv = b.category.toLowerCase();
          break;
        case 'provider':
          av = a.provider.toLowerCase();
          bv = b.provider.toLowerCase();
          break;
        case 'cloud': {
          const ar = CLOUD_RANK[a.cloud] ?? 99;
          const br = CLOUD_RANK[b.cloud] ?? 99;
          if (ar !== br) return sortAsc ? ar - br : br - ar;
          av = a.displayModelName.toLowerCase();
          bv = b.displayModelName.toLowerCase();
          break;
        }
        case 'input':
          av = a.inputs.join(',').toLowerCase();
          bv = b.inputs.join(',').toLowerCase();
          break;
        case 'output':
          av = a.outputs.join(',').toLowerCase();
          bv = b.outputs.join(',').toLowerCase();
          break;
        case 'streaming':
          // true sorts before false in asc — flip boolean to numeric so the
          // generic numeric comparator below does the right thing.
          av = a.streaming ? 0 : 1;
          bv = b.streaming ? 0 : 1;
          break;
        case 'tools':
          av = a.toolCalling ? 0 : 1;
          bv = b.toolCalling ? 0 : 1;
          break;
        case 'context': {
          const an = a.contextWindowNum;
          const bn = b.contextWindowNum;
          const aValid = Number.isFinite(an);
          const bValid = Number.isFinite(bn);
          if (aValid && bValid) {
            av = an;
            bv = bn;
          } else if (aValid) {
            return -1;
          } else if (bValid) {
            return 1;
          } else {
            av = a.contextWindowRaw.toLowerCase();
            bv = b.contextWindowRaw.toLowerCase();
          }
          break;
        }
        case 'inputPrice':
          av = priceSortValue(a.inputPrice);
          bv = priceSortValue(b.inputPrice);
          break;
        case 'outputPrice':
          av = priceSortValue(a.outputPrice);
          bv = priceSortValue(b.outputPrice);
          break;
        case 'cachedInputPrice':
          av = priceSortValue(a.cachedInputPrice);
          bv = priceSortValue(b.cachedInputPrice);
          break;
        case 'reasoningEffort':
          // Models with published values first (more values first), "-" rows last.
          av = a.reasoningEffort.length > 0 ? -a.reasoningEffort.length : Number.POSITIVE_INFINITY;
          bv = b.reasoningEffort.length > 0 ? -b.reasoningEffort.length : Number.POSITIVE_INFINITY;
          break;
        case 'reasoningTokensUsage': {
          // Standard field first, then top-level, then "not reported", then "-".
          const rank = { completion_tokens_details: 0, usage: 1, none: 2 } as const;
          av = a.reasoningTokensUsage ? rank[a.reasoningTokensUsage] : 3;
          bv = b.reasoningTokensUsage ? rank[b.reasoningTokensUsage] : 3;
          break;
        }
        case 'plans':
          av = a.plans.length;
          bv = b.plans.length;
          break;
        default:
          av = a.displayModelName.toLowerCase();
          bv = b.displayModelName.toLowerCase();
      }
      if (typeof av === 'number' && typeof bv === 'number') {
        return sortAsc ? av - bv : bv - av;
      }
      const as = String(av);
      const bs = String(bv);
      if (as < bs) return sortAsc ? -1 : 1;
      if (as > bs) return sortAsc ? 1 : -1;
      return 0;
    }

    function updateSortIndicators() {
      root.querySelectorAll<HTMLElement>('th[data-sort]').forEach((th) => {
        const icon = th.querySelector<SVGElement>('.mc-sort-icon');
        const isActive = th.dataset.sort === sortKey;
        th.classList.toggle('mc-sort-active', isActive);
        if (icon) {
          icon.classList.toggle('mc-sort-icon--active', isActive);
          icon.classList.toggle('mc-sort-icon--asc', isActive && sortAsc);
          icon.classList.toggle('mc-sort-icon--desc', isActive && !sortAsc);
        }
      });
    }

    function apply() {
      const state = readState();
      // Sort the row list, then re-append matching <tr>s to <tbody> in the
      // new order. Skips the no-results row, which stays at the end.
      const ordered = [...rows].sort(compareRows);
      if (tbody) {
        for (const row of ordered) {
          const tr = tableRowsByKey.get(row.key);
          if (tr) tbody.appendChild(tr);
        }
        if (noResultsRow) tbody.appendChild(noResultsRow);
      }
      let visible = 0;
      for (const row of ordered) {
        const tr = tableRowsByKey.get(row.key);
        if (!tr) continue;
        const passes = rowPasses(row, state);
        tr.hidden = !passes;
        if (passes) visible += 1;
      }
      if (visibleCountEl) visibleCountEl.textContent = String(visible);
      if (noResultsRow) noResultsRow.hidden = visible > 0;
      updateCounts();
      updateSortIndicators();
    }

    // "Reset filters" means "remove all filters" — every option in every
    // column gets checked, so no constraint is applied and the table shows
    // the full set. The initial page load also has every option checked
    // (Telekom-first ordering is achieved via sort, not filter).
    function reset() {
      for (const def of filterDefs) {
        const details = root.querySelector<HTMLElement>(`.mc-filter[data-filter="${def.id}"]`);
        if (!details) continue;
        details.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => {
          input.checked = true;
        });
      }
      apply();
    }

    root.addEventListener('change', (evt) => {
      const target = evt.target as HTMLElement | null;
      if (target && target instanceof HTMLInputElement && target.type === 'checkbox') {
        // If the user just unchecked the last option in a filter, auto-revert
        // that filter to "All" (every option checked). Prevents the table
        // collapsing to zero rows from an accidentally-empty selection.
        const filterDetails = target.closest('.mc-filter') as HTMLElement | null;
        if (filterDetails) {
          const all = filterDetails.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
          const anyChecked = Array.from(all).some((input) => input.checked);
          if (!anyChecked) {
            all.forEach((input) => {
              input.checked = true;
            });
          }
        }
        apply();
      }
    });

    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => reset());
    }

    if (!root.hasAttribute('data-popover-bound')) {
      root.setAttribute('data-popover-bound', '');
      const closeFilters = (except: HTMLDetailsElement | null) => {
        root.querySelectorAll<HTMLDetailsElement>('details.mc-filter[open]').forEach((details) => {
          if (details !== except) details.open = false;
        });
      };
      root.addEventListener('toggle', (evt) => {
        const details = evt.target;
        if (details instanceof HTMLDetailsElement && details.classList.contains('mc-filter') && details.open) {
          closeFilters(details);
        }
      }, true);
      document.addEventListener('keydown', (evt) => {
        if (evt.key !== 'Escape') return;
        const open = root.querySelector<HTMLDetailsElement>('details.mc-filter[open]');
        if (!open) return;
        open.open = false;
        open.querySelector<HTMLElement>('summary')?.focus();
      });
      document.addEventListener('click', (evt) => {
        const target = evt.target;
        if (!(target instanceof Node)) return;
        if (target instanceof Element && target.closest('.mc-filter')) return;
        closeFilters(null);
      });
    }

    // Column-header click-to-sort. Delegated on <thead> so we don't bind
    // one handler per <th>. Clicking the active key flips direction; a new
    // key starts ascending.
    const thead = root.querySelector<HTMLElement>('thead');
    if (thead) {
      thead.addEventListener('click', (evt) => {
        const target = evt.target as HTMLElement | null;
        const th = target?.closest('th[data-sort]') as HTMLElement | null;
        if (!th) return;
        const key = th.dataset.sort;
        if (!key) return;
        if (sortKey === key) sortAsc = !sortAsc;
        else {
          sortKey = key;
          sortAsc = true;
        }
        apply();
      });
    }

    // Cloud tag in a row toggles its value in the Cloud filter. Click an
    // already-selected cloud to remove it; click an unselected cloud to add
    // it. Delegated so it survives any future row re-render. We dispatch a
    // synthetic 'change' event so the existing change listener handles both
    // the apply() call AND the zero-selection auto-revert (uncheck the last
    // remaining cloud → all three snap back to checked).
    root.addEventListener('click', (evt) => {
      const target = evt.target as HTMLElement | null;
      const btn = target?.closest('.mc-cloud-filter-btn') as HTMLElement | null;
      if (!btn) return;
      const cloud = btn.dataset.cloud;
      if (!cloud) return;
      const checkbox = root.querySelector<HTMLInputElement>(
        `.mc-filter[data-filter="cloud"] input[type="checkbox"][value="${cloud}"]`,
      );
      if (!checkbox) return;
      checkbox.checked = !checkbox.checked;
      checkbox.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // Close open filters when clicking outside
    document.addEventListener('click', (evt) => {
      const target = evt.target as Node | null;
      root.querySelectorAll<HTMLDetailsElement>('details.mc-filter[open]').forEach((d) => {
        if (target && !d.contains(target)) d.open = false;
      });
    });

    apply();
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>('.models-comparison')
      .forEach((root) => initModelsComparison(root));
  }

  document.addEventListener('astro:page-load', initAll);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

