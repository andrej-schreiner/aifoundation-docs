    border-top: var(--aifs-border-width-standard) solid var(--aifs-filter-panel-border);
  }

  /* The filter fields: .aifs-filter (select.css). */

  /* The count at the start, the sort field at the end; on a narrow
     column the sort field goes under the count. */
  .models-comparison__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
