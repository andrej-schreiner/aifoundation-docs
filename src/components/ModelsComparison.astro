  /* Each filter is a card: its name, then its options. */
  .mc-panel__group {
    display: grid;
    gap: var(--aifs-filter-panel-option-gap);
    min-width: 0;
    margin: 0;
    padding: var(--aifs-filter-panel-card-padding);
    border: var(--aifs-card-border-width) solid var(--aifs-card-border);
    border-radius: var(--aifs-radius-card);
