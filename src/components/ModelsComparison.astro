function resolveCapabilities(exactModelName: string, category: Category): Capabilities {
  return {
    creator: inferCreator(exactModelName),
    ...CATEGORY_DEFAULTS[category],
    ...MODEL_CAPABILITY_OVERRIDES[exactModelName],
  };
}

// ---------------- Cloud (replaces Sovereignty) ----------------

type CloudKey = 'T-Cloud' | 'Azure' | 'GCP' | 'Other';

function resolveCloud(deploymentRegion: string): CloudKey {
  const region = (deploymentRegion ?? '').toLowerCase();
  // Open Telekom Cloud / OTC → T-Cloud
  if (region.startsWith('otc') || region === 'open telekom cloud' || region === 'otc') return 'T-Cloud';
  if (region.startsWith('azure')) return 'Azure';
  if (region.startsWith('gcp') || region.startsWith('google')) return 'GCP';
  return 'Other';
}

function cloudFullName(cloud: CloudKey): string {
  switch (cloud) {
    case 'T-Cloud':
      return 'T-Cloud Public';
    case 'Azure':
      return 'Microsoft Azure';
    case 'GCP':
      return 'Google Cloud Platform';
    default:
      return 'Other';
  }
}

function cloudTagClass(cloud: CloudKey): string {
  return cloud === 'T-Cloud' ? 'tag-tcloud' : 'tag-cloud';
}

// ---------------- Compile model list ----------------

interface CompiledModel {
  exactModelName: string;
  displayModelName: string;
  category: Category;        // primary purpose — drives sort + leads the badge list
  categories: Category[];    // primary + modality-derived (see deriveCategories)
  cloud: CloudKey;
  contextWindow: string;
  reasoningEffort: string[];  // accepted reasoning_effort values; empty when none is published
  reasoningTokensUsage: ReasoningTokensUsage | null;  // where usage reports reasoning tokens; null = not documented
  inputPricePerMillionTokens: number | null;
  outputPricePerMillionTokens: number | null;
  cachedInputPricePerMillionTokens: number | null;
  cachedPricingPublished: boolean;
  plans: string[];
  /** Lowercase catalog tier. Only `premium` is shown; Standard is omitted. */
  modelTier: string;
  capabilities: Capabilities;
  /** Endpoints beyond the category default, where the docs state them (modelEndpoints). */
  endpoints: ModelEndpoint[];
  /** Where it runs: a place name and its flag code; blank while hosting is unconfirmed. */
  location: string;
  locationCode: string;
  termsOfUseUrl: string;
  dataProtectionUrl: string;
}

// Datasheet model names are matched to exactModelName case-insensitively: the
// datasheet keeps the Bifrost spelling (e.g. `GPT-5-Codex`), the pricing export
// the LLM Hub one.
// 'completion_tokens_details' = the OpenAI field completion_tokens_details.reasoning_tokens
// (vLLM-served models); 'usage' = top-level usage.reasoning_tokens (SGLang-served models);
// 'none' = the model reports no reasoning token count.
type ReasoningTokensUsage = 'completion_tokens_details' | 'usage' | 'none';
const reasoningTokensUsageByName = new Map<string, ReasoningTokensUsage>(
  Object.entries(reasoningTokensUsageData.models as Record<string, ReasoningTokensUsage>).map(([name, v]) => [
    name.toLowerCase(),
    v,
  ]),
);

const reasoningEffortByName = new Map<string, string[]>(
  Object.entries(reasoningEffortData.models as Record<string, { values: string[] }>).map(([name, v]) => [
    name.toLowerCase(),
    v.values,
  ]),
);

// exactModelName -> CompiledModel; plans accumulate across packages.
const byName = new Map<string, CompiledModel>();

for (const pkg of pricingData as Array<{
  packageName: string;
  modelQuotaConfigs: Array<Record<string, unknown>>;
}>) {
  for (const entry of pkg.modelQuotaConfigs ?? []) {
    const exactModelName = entry.exactModelName as string;
    if (isHiddenModel(exactModelName) || isRetiredModel(exactModelName)) continue;
    const existing = byName.get(exactModelName);
    if (existing) {
      if (!existing.plans.includes(pkg.packageName)) existing.plans.push(pkg.packageName);
      if (String(entry.modelTier || '').toLowerCase() === 'premium') existing.modelTier = 'premium';
      continue;
    }
    const deploymentRegion = entry.deploymentRegion as string;
    const category = resolvePrimaryCategory(exactModelName);
    const capabilities = resolveCapabilities(exactModelName, category);
    byName.set(exactModelName, {
      exactModelName,
      displayModelName: entry.displayModelName as string,
      category,
      categories: deriveCategories(category, capabilities, EXTRA_CATEGORIES[exactModelName] ?? []),
      cloud: resolveCloud(deploymentRegion),
      contextWindow: (entry.contextWindow as string) ?? '—',
      reasoningEffort: reasoningEffortByName.get(exactModelName.toLowerCase()) ?? [],
      reasoningTokensUsage: reasoningTokensUsageByName.get(exactModelName.toLowerCase()) ?? null,
      inputPricePerMillionTokens: (entry.inputPricePerMillionTokens as number) ?? null,
      outputPricePerMillionTokens: (entry.outputPricePerMillionTokens as number) ?? null,
      // Archived pages keep their original output, so they skip the category check.
      cachedInputPricePerMillionTokens: cachedInputPrice(
        entry.inputPricePerMillionTokens as number | null,
        deploymentRegion,
        isArchive ? null : category,
      ),
      cachedPricingPublished: hasCachedTokenPricing(deploymentRegion, isArchive ? null : category),
      plans: [pkg.packageName],
      modelTier: String(entry.modelTier || 'standard').toLowerCase(),
      capabilities,
      endpoints: endpointsFor(exactModelName),
      ...(() => {
        const where = hostingUnconfirmed(exactModelName) || !deploymentRegion
          ? { name: '', code: '' }
          : parseLocation(deploymentRegion, isDE);
        return { location: where.name, locationCode: where.code };
      })(),
      termsOfUseUrl: (entry.termsOfUseUrl as string) ?? '',
      dataProtectionUrl: (entry.dataProtectionUrl as string) ?? '',
    });
  }
}

// Stable plan order
const planOrder: Record<string, number> = { Essential: 0, Professional: 1, Agentic: 2, Test: 3 };
for (const m of byName.values()) {
  m.plans.sort((a, b) => (planOrder[a] ?? 99) - (planOrder[b] ?? 99));
}

// Default order: Telekom-first by cloud priority, then alphabetical by
// display name. Client-side sort (column-header clicks) can override.
const CLOUD_RANK: Record<CloudKey, number> = { 'T-Cloud': 0, Azure: 1, GCP: 2, Other: 3 };

function matchesCapability(m: CompiledModel, cap: CapabilityFilter | undefined): boolean {
  if (!cap) return true;
  const inputs = m.capabilities.inputModalities;
  const outputs = m.capabilities.outputModalities;
  switch (cap) {
    case 'accepts-image': return inputs.includes('Image');
    case 'accepts-only-image': return inputs.length === 1 && inputs[0] === 'Image';
    case 'accepts-audio': return inputs.includes('Audio');
    case 'emits-audio':   return outputs.includes('Audio');
    case 'emits-image':   return outputs.includes('Image');
    case 'serves-decisions': return m.endpoints.includes('decisions');
  }
}

const allModels = [...byName.values()]
  .filter((m) => (categoryFilter ? m.categories.includes(categoryFilter) : true))
  .filter((m) => matchesCapability(m, capabilityFilter))
  .sort((a, b) => {
    const rankDiff = CLOUD_RANK[a.cloud] - CLOUD_RANK[b.cloud];
    if (rankDiff !== 0) return rankDiff;
    return compareCatalogName(a.displayModelName, b.displayModelName);
  });

// ---------------- Rows ----------------

// A row is a model; in the plan preset, a model in one plan, since each plan
// has its own prices and limits per minute. The rows of every plan are
// rendered; the plan field shows one plan's rows at a time.
interface TableRow extends CompiledModel {
  key: string;
  plan: string | null;
  rpm: number | string | null;
  tpm: number | string | null;
}

function compareRowOrder(a: CompiledModel, b: CompiledModel): number {
  const rankDiff = CLOUD_RANK[a.cloud] - CLOUD_RANK[b.cloud];
  if (rankDiff !== 0) return rankDiff;
  return compareCatalogName(a.displayModelName, b.displayModelName);
}

function planRow(planName: string, pm: PlanModel): TableRow {
  const base = byName.get(pm.exactModelName) ?? (() => {
    const category = resolvePrimaryCategory(pm.exactModelName);
    const capabilities = resolveCapabilities(pm.exactModelName, category);
    return {
      exactModelName: pm.exactModelName,
      displayModelName: pm.displayName,
      category,
      categories: deriveCategories(category, capabilities),
      cloud: 'Other' as CloudKey,
      contextWindow: '—',
      reasoningEffort: [],
      reasoningTokensUsage: null,
      inputPricePerMillionTokens: null,
      outputPricePerMillionTokens: null,
      cachedInputPricePerMillionTokens: null,
      cachedPricingPublished: false,
      plans: [],
      modelTier: 'standard',
      capabilities,
      endpoints: endpointsFor(pm.exactModelName),
      location: '',
      locationCode: '',
      termsOfUseUrl: '',
      dataProtectionUrl: '',
    };
  })();
  return {
    ...base,
    key: `${planName}|${pm.exactModelName}`,
    plan: planName,
    displayModelName: pm.displayName || base.displayModelName,
    contextWindow: pm.contextWindow == null ? base.contextWindow : String(pm.contextWindow),
    inputPricePerMillionTokens: pm.inputPrice ?? null,
    outputPricePerMillionTokens: pm.outputPrice ?? null,
    cachedInputPricePerMillionTokens: pm.cachedInputPrice ?? null,
    cachedPricingPublished: pm.cachedPricingPublished,
    modelTier: String(pm.modelTier || base.modelTier).toLowerCase(),
    location: pm.serverLocation ?? base.location,
    locationCode: pm.locationCode ?? base.locationCode,
    termsOfUseUrl: pm.termsOfUseUrl || base.termsOfUseUrl,
    dataProtectionUrl: pm.dataProtectionUrl || base.dataProtectionUrl,
    rpm: pm.rpm ?? null,
    tpm: pm.tpm ?? null,
  };
}

const rows: TableRow[] = isPlanPreset
  ? planData.flatMap((p) => p.models.map((pm) => planRow(p.packageName, pm)).sort(compareRowOrder))
  : allModels.map((m) => ({ ...m, key: m.exactModelName, plan: null, rpm: null, tpm: null }));

// The plan shown first; the others' rows start hidden.
const activePlan = isPlanPreset
  ? (planData.find((p) => p.packageName === initialPlan) ?? planData[0])?.packageName ?? ''
  : '';
const activeRowCount = isPlanPreset ? rows.filter((r) => r.plan === activePlan).length : rows.length;
const selectablePlans = planData.filter((p) => p.isFilterAvailable !== false);
const showPlanField = isPlanPreset && !planLocked && selectablePlans.length > 1;
// A plan with no models in the current catalog (an archived plan): say so
