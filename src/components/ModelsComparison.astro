    container-type: inline-size;
    /* "datatable": the shared table behaviour (data-table.css). */
    container-name: comparison datatable;
    min-width: 0;
  }

  /* Sticky under the site header: .aifs-data-filterbar (data-table.css). */
  .models-comparison__filterbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .models-comparison__chips {
    display: contents;
  }

  .mc-open-panel__short {
    display: none;
  }

  /* Applied filters: removable chips in a row under the filter bar, then
     Clear all. */
  /* Small buttons reach 6px past their edges to a 44px hit area
     (button.css); wrapped rows sit that far apart twice, so no two
     chips' hit areas overlap. */
  .mc-applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: calc(var(--aifs-button-min-height) - var(--aifs-button-min-height-small));
    column-gap: var(--aifs-filter-panel-option-gap);
    margin-bottom: var(--aifs-filter-panel-option-gap);
  }

  .mc-applied[hidden] {
    display: none;
  }

  .mc-applied__list {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mc-applied__list :global(li) {
    margin: 0;
  }

  /* The filter panel: a modal dialog on the window's end edge, the page
     dimmed behind it. */
  .mc-panel {
    box-sizing: border-box;
    position: fixed;
    inset: 0 0 0 auto;
    width: min(var(--aifs-filter-panel-width), 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-inline-start: var(--aifs-border-width-standard) solid var(--aifs-filter-panel-border);
    /* The subtle backdrop, so the filter cards stand out (layout.css). */
    background: var(--aifs-layout-tint);
    color: var(--aifs-color-text-body);
  }

  .mc-panel[open] {
    display: flex;
    flex-direction: column;
  }

  .mc-panel::backdrop {
    background: var(--aifs-color-backdrop);
  }

  .mc-panel__head,
  .mc-panel__foot {
    background: var(--aifs-filter-panel-background);
