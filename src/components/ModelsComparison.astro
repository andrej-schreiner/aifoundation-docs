  cloud: m.cloud,
  location: m.location,
  inputs: m.capabilities.inputModalities,
  outputs: m.capabilities.outputModalities,
  streaming: m.capabilities.streaming,
  toolCalling: m.capabilities.toolCalling,
  contextWindowRaw: m.contextWindow,
  contextWindowNum: parseContextWindow(m.contextWindow),
  reasoningEffort: m.reasoningEffort,
  reasoningTokensUsage: m.reasoningTokensUsage,
  inputPrice: m.inputPricePerMillionTokens,
  outputPrice: m.outputPricePerMillionTokens,
  cachedInputPrice: m.cachedInputPricePerMillionTokens,
  inputPriceBucket: priceBucket(m.inputPricePerMillionTokens),
  outputPriceBucket: priceBucket(m.outputPricePerMillionTokens),
  rpm: limitNumber(m.rpm),
  tpm: limitNumber(m.tpm),
  plans: m.plans,
  catalogRank: catalogRank(m.displayModelName),
}));
---

{planEmpty ? (
  <p class="mc-empty">
    {t.emptyPlan}{' '}
    <a href={`${localePrefix}/plans/`}>{t.emptyPlanLink}</a>
  </p>
) : (
<div
  class:list={['models-comparison', `models-comparison--${preset}`]}
  data-plan={activePlan || undefined}
  data-rows={JSON.stringify(rowDataPayload)}
  data-t={JSON.stringify(scriptText)}>
  <div
    class:list={['models-comparison__filterbar aifs-data-filterbar not-content', { 'models-comparison__filterbar--plan': showPlanField }]}
    role="group"
    aria-label={t.heading}>
    {showPlanField && (
      <Selector id={`mc-plan-${preset}`} label={t.ratePlan}>
        {selectablePlans.map((p) => (
          <option value={p.packageName} selected={p.packageName === activePlan}>{p.label}</option>
        ))}
      </Selector>
    )}
    <div class="models-comparison__chips">
      {rowChips.map((chip) => (
        <details class="mc-filter aifs-filter" data-filter={chip.id}>
          <summary>
            <span class="mc-filter__label aifs-filter__label">{chip.label}</span>
            <span class="mc-filter__count aifs-filter__value" data-count>{isDE ? 'Alle' : 'All'}</span>
            <span class="aifs-filter__icon" aria-hidden="true"><Icon name="navigation-collapse-down" size={20} /></span>
          </summary>
          <div class="mc-filter__menu aifs-filter__menu">
            {chip.values.map((v) => (
              <label class="mc-filter__option aifs-filter__option">
                <input type="checkbox" value={v} checked />
                <span>{chip.optionLabel(v)}</span>
              </label>
            ))}
          </div>
        </details>
      ))}
    </div>

    <Button variant="secondary" class="mc-open-panel" data-open-panel aria-haspopup="dialog" aria-controls={panelId}>
      <Icon name="action-filter" size={20} />
      <span class="mc-open-panel__full">{t.allFilters}</span>
      <span class="mc-open-panel__short">{t.filters}</span>
      <span data-filter-count></span>
    </Button>
  </div>

  <!-- Applied filters: one chip per narrowed filter, removable, then Clear all. -->
  <div class="mc-applied" data-applied hidden>
    <ul class="mc-applied__list" aria-label={t.appliedFilters} data-applied-list></ul>
    <Button variant="ghost" size="small" class="mc-applied__clear" data-clear-all>{t.clearAll}</Button>
  </div>
  <template data-chip-template>
    <li>
      <Button variant="secondary" size="small" class="mc-applied__chip">
        <span data-chip-text></span>
        <Icon name="action-close" size={16} />
      </Button>
    </li>
  </template>

  <!-- Every filter, in a modal panel at the window's end edge. The row's
       fields and these checkboxes stay in step (script below). -->
  <dialog class="mc-panel not-content" id={panelId} aria-labelledby={`${panelId}-title`}>
    <div class="mc-panel__head">
      <span class="mc-panel__title" id={`${panelId}-title`}>{t.allFilters}</span>
      <Button variant="ghost" iconOnly ariaLabel={t.closeFilters} data-close-panel>
        <Icon name="action-close" size={24} />
      </Button>
    </div>
    <div class="mc-panel__body">
      {filterChips.map((chip) => (
        <fieldset class="mc-panel__group" data-filter={chip.id}>
          <legend class="mc-panel__legend">{chip.label}</legend>
          {chip.values.map((v) => (
            <label class="mc-panel__option">
              <input type="checkbox" value={v} checked />
              <span>{chip.optionLabel(v)}</span>
            </label>
          ))}
        </fieldset>
      ))}
    </div>
    <div class="mc-panel__foot">
      <Button variant="secondary" data-clear-all>{t.clearAll}</Button>
      <Button variant="primary" data-close-panel data-show-results>{t.showResults.replace('{n}', String(activeRowCount))}</Button>
    </div>
  </dialog>

  <!-- The count, then the sort field: the headers sort too, but the
       details and the cards have no header to click. -->
  <div class="models-comparison__status not-content">
    {/* Explicit spaces: Astro's compressHTML drops the plain whitespace
        between an expression and an element ("Showing39of39models"). */}
    <span class="models-comparison__count" aria-live="polite" data-status-text>
      {t.showing && `${t.showing} `}<span data-visible-count>{activeRowCount}</span>{' '}{t.of}{' '}<span data-total-count>{activeRowCount}</span>{' '}{t.models}
    </span>
    <span class="mc-sort">
      <Selector id={`mc-sort-${categoryFilter || capabilityFilter || preset}`} label={t.sortLabel}>
        <option value="" selected>{t.sortDefault}</option>
        {sortOptions.map((c) => (
          <option value={c.key}>{c.label}</option>
        ))}
      </Selector>
      <Button variant="secondary" iconOnly class="mc-sort-dir" ariaLabel={t.sortDescending} data-sort-dir aria-pressed="false" disabled>
        <Icon name="content-sort-indicator-up" size={20} class="mc-sort-dir__up" />
        <Icon name="content-sort-indicator-down" size={20} class="mc-sort-dir__down" />
      </Button>
    </span>
  </div>

  <!-- A copy of the header row, filled and shown by the script once the
       real one scrolls under the filters. Screen readers use the real
       header. -->
  <div class="aifs-head-float" aria-hidden="true"></div>

  <!-- One table. From 36rem of width: the main columns, and per row a
       details row with the others. Narrower: each row is a card, its cells
       label–value rows, the details below a Details button. -->
  <div class="models-comparison__scroll">
    <table class="models-comparison-table aifs-data-table">
      <thead>
        <tr>
          {tableColumns.map((h) => {
            // Label, then the arrow on its first line; the unit, if any, below.
            if (h.sortable === false) {
              return (
                <th class={h.cls}>
                  <span class="mc-sort-label">
                    <span class="mc-sort-name">{h.label}</span>
                  </span>
                </th>
              );
            }
            const button = (
              <button type="button" class="mc-sort-header" aria-label={t.sortBy.replace('{label}', h.unit ? `${h.label} (${h.unit})` : h.label)}>
                <span class="mc-sort-label">
                  <span class="mc-sort-name">
                    {h.label}
                    {h.mark && <span aria-hidden="true">{` ${h.mark}`}</span>}
                    <Icon name="content-sort-indicator-down" size={16} class="mc-sort-icon" />
                  </span>
                  {h.unit && <span class="mc-sort-unit">{h.unit}</span>}
                </span>
              </button>
            );
            return (
              <th data-sort={h.key} class={h.cls}>
                {h.tooltip ? (
                  <Tooltip text={h.tooltip} maxWidth="22rem" position="bottom" focusable={false}>
                    {button}
                  </Tooltip>
                ) : (
                  button
                )}
              </th>
            );
          })}
          <th class="mc-more"><span class="sr-only">{t.details}</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((m) => {
          const fullCloud = cloudFullName(m.cloud);
          const cloudLabel = cloudLabelFor(m.exactModelName, m.cloud);
          const detailsId = detailsIdFor(m.key);
          const hasLinks = Boolean(m.termsOfUseUrl || m.dataProtectionUrl);
          const capCell = (value: boolean | null) =>
            value == null
              ? <span class="mc-cap" aria-label={isDE ? 'Nicht angegeben' : 'Not published'}>—</span>
              : value
              ? <span class="mc-cap mc-cap--yes" aria-label={t.supported}>✓</span>
              : <span class="mc-cap mc-cap--no" aria-label={t.notSupported}>✗</span>;
          // A column's value, the same in a table cell and in the details.
          const value = (key: string) => {
            switch (key) {
              case 'category':
                return m.categories.map((cat) => CATEGORY_LABELS[cat]).join(', ');
              case 'provider':
                return m.capabilities.creator;
              case 'cloud':
                return hostingUnconfirmed(m.exactModelName) ? <span class="mc-muted">—</span> : (
                  <Tooltip text={cloudFullNameFor(m.exactModelName, CLOUD_TOOLTIPS[m.cloud])} maxWidth="22rem" focusable={false}>
                    <button
                      type="button"
                      class={`plans-tag ${cloudTagClass(m.cloud)} mc-cloud-filter-btn`}
                      data-cloud={m.cloud}
                      aria-label={t.toggleCloud.replace('{label}', cloudLabel).replace('{full}', fullCloud)}
                    >
                      {cloudLabel}
                    </button>
                  </Tooltip>
                );
              case 'location':
                return m.location
                  ? <span class="mc-location__value">{m.locationCode && <Flag code={m.locationCode} size={16} decorative />}{m.location}</span>
                  : <span class="mc-muted">—</span>;
              case 'input':
              case 'output': {
                const mods = key === 'input' ? m.capabilities.inputModalities : m.capabilities.outputModalities;
                return mods.length === 0 ? <span class="mc-muted">—</span> : mods.map((mod, index) => (
                  <>
                    {index > 0 ? ' ' : ''}
                    <span class="mc-mod">{MODALITY_LABELS[mod]}{index < mods.length - 1 ? ',' : ''}</span>
                  </>
                ));
              }
              case 'streaming':
                return capCell(m.capabilities.streaming);
              case 'tools':
                return capCell(m.capabilities.toolCalling);
              case 'context':
                return formatContextLabel(m.contextWindow);
              case 'reasoningEffort':
                return m.reasoningEffort.length > 0
                  ? <span class="mc-effort-values">{m.reasoningEffort.map((v) => <code>{v}</code>)}</span>
                  : <span aria-label={t.noEffortValues}>{t.reasoningEffortNone}</span>;
              case 'reasoningTokensUsage':
                return (
                  <span class="mc-usage-field">
                    {m.reasoningTokensUsage === 'completion_tokens_details' && <code set:html={withWrapPoints('completion_tokens_details.reasoning_tokens')} />}
                    {m.reasoningTokensUsage === 'usage' && <code set:html={withWrapPoints('usage.reasoning_tokens')} />}
                    {m.reasoningTokensUsage === 'none' && <span class="mc-usage-field__none">{t.reasoningTokensNotReported}</span>}
                    {m.reasoningTokensUsage === null && <span aria-label={t.notDocumented}>{t.reasoningTokensUnknown}</span>}
                  </span>
                );
              case 'inputPrice':
                return m.inputPricePerMillionTokens == null ? <span title={t.priceTba.replaceAll('\n', ' ')}>—</span> : formatPrice(m.inputPricePerMillionTokens);
              case 'outputPrice':
                return m.outputPricePerMillionTokens == null ? <span title={t.priceTba.replaceAll('\n', ' ')}>—</span> : formatPrice(m.outputPricePerMillionTokens);
              case 'cachedInputPrice':
                return formatCachedPrice(m);
              case 'rpm':
                return formatLimit(m.rpm);
              case 'tpm':
                return formatLimit(m.tpm);
              case 'plans':
                return (
                  <span class="mc-plans">
                    {shownPlans(m).map((p) => (
                      <PlanTag plan={p} size="small" href={planHref(p)} />
                    ))}
                    {shownPlans(m).length === 0 && previewCatalog(m) && <a class="mc-plans__preview" href={planHref('Test')}>{t.previewPlans}</a>}
                    {shownPlans(m).length === 0 && !previewCatalog(m) && <span class="mc-muted">—</span>}
                  </span>
                );
              case 'links':
                return hasLinks ? (
                  <span class="mc-links">
                    {m.termsOfUseUrl && (
                      <a class="mc-link" href={m.termsOfUseUrl} target="_blank" rel="noreferrer noopener">
                        {t.linkTermsOfUse}<span class="sr-only"> {t.opensInNewTab}</span>
                        <Icon name="navigation-external-link" size={16} />
                      </a>
                    )}
                    {m.dataProtectionUrl && (
                      <a class="mc-link" href={m.dataProtectionUrl} target="_blank" rel="noreferrer noopener">
                        {t.linkDataProtection}<span class="sr-only"> {t.opensInNewTab}</span>
                        <Icon name="navigation-external-link" size={16} />
                      </a>
                    )}
                  </span>
                ) : <span class="mc-muted">—</span>;
              default:
                return null;
            }
          };
          return (
            <>
              <tr data-key={m.key} data-plan={m.plan ?? undefined} hidden={isPlanPreset && m.plan !== activePlan}>
                {tableColumns.map((c) => c.key === 'model' ? (
                  <td class="mc-model" data-label={t.colModel}>
                    <span class="mc-model__inner">
                      <Tooltip text={getProviderTooltip(m.capabilities.creator, isDE)} maxWidth="24rem">
                        <Logo name={m.capabilities.creator} />
                      </Tooltip>
                      <span class="mc-model__text">
                        <strong class="mc-model__name">{m.displayModelName}</strong>
                        {(isNewModel(m.exactModelName) || previewCatalog(m) || m.modelTier === 'premium') && (
                          <span class="mc-model__tags">
                            {isNewModel(m.exactModelName) && <Tag color="magenta" size="small">{t.newTag}</Tag>}
                            {previewCatalog(m) && <Tag size="small">{t.planPreview}</Tag>}
                            {m.modelTier === 'premium' && <Tag size="small">Premium</Tag>}
                          </span>
                        )}
                      </span>
                    </span>
                  </td>
                ) : (
                  <td class={c.cls} data-label={cardLabel(c)}>{value(c.key)}</td>
                ))}
                <td class="mc-more">
                  <Button
                    variant="ghost"
                    size="small"
                    class="mc-more__btn"
                    aria-expanded="false"
                    aria-controls={detailsId}
                  >
                    <span class="mc-more__label">{t.showDetails}<span class="sr-only">: {m.displayModelName}</span></span>
                    <Icon name="navigation-collapse-down" size={16} class="mc-more__chevron" />
                  </Button>
                </td>
              </tr>
              <tr class="mc-detail" id={detailsId} data-detail-for={m.key} hidden>
                <td colspan={tableColumns.length + 1}>
                  <dl class="mc-dl">
                    {detailColumns.map((c) => (
                      <div class:list={['mc-dl__item', `mc-dl__item--${c.key}`, extraStep(c.key) && `mc-x${extraStep(c.key)}`]}>
                        <dt>{c.label}{c.unit && <span class="mc-dl__unit"> ({c.unit})</span>}{c.mark && <span aria-hidden="true">{` ${c.mark}`}</span>}</dt>
                        <dd class={c.cls}>{value(c.key)}</dd>
                      </div>
                    ))}
                  </dl>
                </td>
              </tr>
            </>
          );
        })}
        <tr class="mc-no-results" hidden>
          <td colspan={tableColumns.length + 1} class="mc-no-results__cell">{t.noResults}</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
)}

<script>
  import { setupFloatingHead } from '../scripts/floatingTableHead';
  import { showFilterValue } from '../scripts/filterField';
  type RowData = {
    key: string;
    /** Plan preset: the plan this row belongs to; null elsewhere. */
    plan: string | null;
    displayModelName: string;
    catalogRank?: number;
    category: string;        // primary, for sort
    categories: string[];    // multi, for filter chip
    provider: string;
    cloud: string;
    location: string;
    inputs: string[];
    outputs: string[];
    streaming: boolean | null;
    toolCalling: boolean | null;
    contextWindowRaw: string;
    contextWindowNum: number;
    reasoningEffort: string[];
    reasoningTokensUsage: 'completion_tokens_details' | 'usage' | 'none' | null;
    inputPrice: number | null;
    outputPrice: number | null;
    cachedInputPrice: number | null;
    inputPriceBucket: string | null;
    outputPriceBucket: string | null;
    rpm: number | null;
    tpm: number | null;
    plans: string[];
  };

  // Rows whose price is not published yet (null) sort after every priced row,
  // in both directions, instead of being string-compared as "null".
  function priceSortValue(v: number | null): number {
    return v == null ? Number.POSITIVE_INFINITY : v;
  }

  function initModelsComparison(root: HTMLElement) {
    if (root.dataset.mcInit === '1') return;
    root.dataset.mcInit = '1';

    const rows: RowData[] = JSON.parse(root.dataset.rows || '[]');
    const tableRowsByKey = new Map<string, HTMLTableRowElement>();
    const tbody = root.querySelector<HTMLTableSectionElement>('tbody');
    root.querySelectorAll<HTMLTableRowElement>('tbody tr[data-key]').forEach((tr) => {
      const key = tr.dataset.key;
      if (key) tableRowsByKey.set(key, tr);
    });
    // Each row's details row comes right after it, wherever sorting puts it.
    const detailRowsByKey = new Map<string, HTMLTableRowElement>();
    root.querySelectorAll<HTMLTableRowElement>('tbody tr[data-detail-for]').forEach((tr) => {
      const key = tr.dataset.detailFor;
      if (key) detailRowsByKey.set(key, tr);
    });
    const isOpen = (tr: HTMLTableRowElement) =>
      tr.querySelector('.mc-more__btn')?.getAttribute('aria-expanded') === 'true';

    const noResultsRow = root.querySelector<HTMLTableRowElement>('.mc-no-results');
    const visibleCountEl = root.querySelector<HTMLElement>('[data-visible-count]');
    const totalCountEl = root.querySelector<HTMLElement>('[data-total-count]');

    // Plan preset: the rows of one plan at a time (the plan field switches).
    let currentPlan = root.dataset.plan || '';
    const inPlan = (row: RowData) => !currentPlan || row.plan === currentPlan;

    // Sort state. Default: cloud (Telekom-first via custom rank). SSR-render
    // is already in this order so the first paint matches; subsequent sorts
    // reorder the rows in-place.
    let sortKey = '';
    let sortAsc = true;
    const CLOUD_RANK: Record<string, number> = { 'T-Cloud': 0, Azure: 1, GCP: 2, Other: 3 };

    const filterDefs: Array<{ id: string; type: 'single' | 'multi' | 'bool'; field: keyof RowData }> = [
      { id: 'category', type: 'multi', field: 'categories' },
      { id: 'provider', type: 'single', field: 'provider' },
      { id: 'cloud', type: 'single', field: 'cloud' },
      { id: 'location', type: 'single', field: 'location' },
      { id: 'input', type: 'multi', field: 'inputs' },
      { id: 'output', type: 'multi', field: 'outputs' },
      { id: 'streaming', type: 'bool', field: 'streaming' },
      { id: 'tools', type: 'bool', field: 'toolCalling' },
      { id: 'inputPrice', type: 'single', field: 'inputPriceBucket' },
      { id: 'outputPrice', type: 'single', field: 'outputPriceBucket' },
      { id: 'plans', type: 'multi', field: 'plans' },
    ];

    type FilterState = Map<string, Set<string>>;

    // Every filter is a fieldset in the panel; the row repeats some of them
    // as fields. The panel's checkboxes are the state; the row's follow them.
    const panelGroup = (id: string) => root.querySelector<HTMLElement>(`fieldset[data-filter="${id}"]`);
    const filterBoxes = (id: string) =>
      root.querySelectorAll<HTMLInputElement>(`[data-filter="${id}"] input[type="checkbox"]`);
    const shownBoxes = (group: HTMLElement) =>
      [...group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')].filter((i) => !i.closest('label')?.hidden);

    function readState(): FilterState {
      const state: FilterState = new Map();
      for (const def of filterDefs) {
        const group = panelGroup(def.id);
        if (!group) continue;
        const checked = new Set<string>();
        group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => {
          if (input.checked) checked.add(input.value);
        });
        state.set(def.id, checked);
      }
      return state;
    }

    /** Set one option of a filter, in the panel and the row alike. */
    function setOption(id: string, value: string, on: boolean) {
      filterBoxes(id).forEach((input) => {
        if (input.value === value) input.checked = on;
      });
    }

    /** A filter is narrowed when one of the options offered is unchecked. */
    function narrowedFilters() {
      const out: { id: string; label: string; chosen: string[] }[] = [];
      for (const def of filterDefs) {
        const group = panelGroup(def.id);
        if (!group) continue;
        const shown = shownBoxes(group);
        const chosen = shown.filter((i) => i.checked);
        if (chosen.length === shown.length) continue;
        out.push({
          id: def.id,
          label: group.querySelector('legend')?.textContent?.trim() || def.id,
          chosen: chosen.map((i) => (i.closest('label')?.textContent || i.value).trim()),
        });
      }
      return out;
    }

    function valueToString(value: unknown): string {
      if (typeof value === 'boolean') return value ? 'true' : 'false';
      return String(value);
    }

    function rowPasses(row: RowData, state: FilterState): boolean {
      if (!inPlan(row)) return false;
      for (const def of filterDefs) {
        const checked = state.get(def.id);
        if (!checked) continue;
        if (checked.size === 0) return false;
        if (def.type === 'multi') {
          const values = row[def.field] as string[];
          // Row passes this filter if ANY of its values is checked.
          if (!values.some((v) => checked.has(v))) return false;
        } else {
          const raw = row[def.field];
          if (raw == null || raw === '') continue;
          const v = valueToString(raw);
          if (!checked.has(v)) return false;
        }
      }
      return true;
    }

    // Locale read from <html lang> (set by Starlight per page) so the
    // aria-label uses the same language as the visible chip label.
    const isDE = document.documentElement.lang === 'de';

    const text = JSON.parse(root.dataset.t || '{}') as Record<string, string>;
    const openPanelBtn = root.querySelector<HTMLButtonElement>('[data-open-panel]');
    const panel = root.querySelector<HTMLDialogElement>('dialog.mc-panel');
    const applied = root.querySelector<HTMLElement>('[data-applied]');
    const appliedList = root.querySelector<HTMLElement>('[data-applied-list]');
    const chipTemplate = root.querySelector<HTMLTemplateElement>('template[data-chip-template]');

    function updateCounts() {
      // The row's fields show what is chosen (src/scripts/filterField.ts).
      root.querySelectorAll<HTMLElement>('details.mc-filter').forEach((details) => {
        showFilterValue(details, isDE);
        details.classList.toggle('mc-filter--active', details.classList.contains('aifs-filter--active'));
      });

      // The panel button counts the narrowed filters; the chips name them.
      const narrowed = narrowedFilters();
      const count = root.querySelector<HTMLElement>('[data-filter-count]');
      // Part of the button's visible text, so its name says it too.
      if (count) count.textContent = narrowed.length ? `(${narrowed.length})` : '';
      if (applied && appliedList && chipTemplate) {
        appliedList.replaceChildren();
        for (const f of narrowed) {
          const item = chipTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const btn = item.querySelector<HTMLButtonElement>('button')!;
          const values = f.chosen.length <= 2
            ? f.chosen.join(', ')
            : (text.nSelected || '{n}').replace('{n}', String(f.chosen.length));
          const label = `${f.label}: ${values}`;
          item.querySelector('[data-chip-text]')!.textContent = label;
          btn.dataset.removeFilter = f.id;
          btn.setAttribute('aria-label', (text.removeFilter || '{label}').replace('{label}', label));
          appliedList.appendChild(item);
        }
        applied.hidden = narrowed.length === 0;
      }
    }

    function compareRows(a: RowData, b: RowData): number {
      let av: number | string;
      let bv: number | string;
      switch (sortKey) {
        case 'model':
          av = a.displayModelName.toLowerCase();
          bv = b.displayModelName.toLowerCase();
          break;
        case 'category':
          av = a.category.toLowerCase();
          bv = b.category.toLowerCase();
          break;
        case 'provider':
          av = a.provider.toLowerCase();
          bv = b.provider.toLowerCase();
          break;
        case 'cloud': {
          const ar = CLOUD_RANK[a.cloud] ?? 99;
          const br = CLOUD_RANK[b.cloud] ?? 99;
          if (ar !== br) return sortAsc ? ar - br : br - ar;
          const rankDiff = (a.catalogRank ?? 10000) - (b.catalogRank ?? 10000);
          if (rankDiff !== 0) return rankDiff;
          av = a.displayModelName.toLowerCase();
          bv = b.displayModelName.toLowerCase();
          break;
        }
        case 'location':
          // Rows without a location sort last.
          av = a.location ? a.location.toLowerCase() : '\uffff';
          bv = b.location ? b.location.toLowerCase() : '\uffff';
          break;
        case 'rpm':
        case 'tpm':
          // "dynamic" (no number) sorts after every number.
          av = priceSortValue(a[sortKey as 'rpm' | 'tpm']);
          bv = priceSortValue(b[sortKey as 'rpm' | 'tpm']);
          break;
        case 'input':
          av = a.inputs.join(',').toLowerCase();
          bv = b.inputs.join(',').toLowerCase();
          break;
        case 'output':
          av = a.outputs.join(',').toLowerCase();
          bv = b.outputs.join(',').toLowerCase();
          break;
        case 'streaming':
          av = a.streaming == null ? 2 : a.streaming ? 0 : 1;
          bv = b.streaming == null ? 2 : b.streaming ? 0 : 1;
          break;
        case 'tools':
          av = a.toolCalling == null ? 2 : a.toolCalling ? 0 : 1;
          bv = b.toolCalling == null ? 2 : b.toolCalling ? 0 : 1;
          break;
        case 'context': {
          const an = a.contextWindowNum;
          const bn = b.contextWindowNum;
          const aValid = Number.isFinite(an);
          const bValid = Number.isFinite(bn);
          if (aValid && bValid) {
            av = an;
            bv = bn;
          } else if (aValid) {
            return -1;
          } else if (bValid) {
            return 1;
          } else {
            av = a.contextWindowRaw.toLowerCase();
            bv = b.contextWindowRaw.toLowerCase();
          }
          break;
        }
        case 'inputPrice':
          av = priceSortValue(a.inputPrice);
          bv = priceSortValue(b.inputPrice);
          break;
        case 'outputPrice':
          av = priceSortValue(a.outputPrice);
          bv = priceSortValue(b.outputPrice);
          break;
        case 'cachedInputPrice':
          av = priceSortValue(a.cachedInputPrice);
          bv = priceSortValue(b.cachedInputPrice);
          break;
        case 'reasoningEffort':
          // Models with published values first (more values first), "-" rows last.
          av = a.reasoningEffort.length > 0 ? -a.reasoningEffort.length : Number.POSITIVE_INFINITY;
          bv = b.reasoningEffort.length > 0 ? -b.reasoningEffort.length : Number.POSITIVE_INFINITY;
          break;
        case 'reasoningTokensUsage': {
          // Standard field first, then top-level, then "not reported", then "-".
          const rank = { completion_tokens_details: 0, usage: 1, none: 2 } as const;
          av = a.reasoningTokensUsage ? rank[a.reasoningTokensUsage] : 3;
          bv = b.reasoningTokensUsage ? rank[b.reasoningTokensUsage] : 3;
          break;
        }
        case 'plans':
          av = a.plans.length;
          bv = b.plans.length;
          break;
        default:
          av = a.displayModelName.toLowerCase();
          bv = b.displayModelName.toLowerCase();
      }
      if (typeof av === 'number' && typeof bv === 'number') {
        // Infinity marks "no value" (unpublished price, dynamic limit): last
        // in both directions.
        if (av === Number.POSITIVE_INFINITY || bv === Number.POSITIVE_INFINITY) {
          return av === bv ? 0 : av === Number.POSITIVE_INFINITY ? 1 : -1;
        }
        return sortAsc ? av - bv : bv - av;
      }
      const as = String(av);
      const bs = String(bv);
      if (as < bs) return sortAsc ? -1 : 1;
      if (as > bs) return sortAsc ? 1 : -1;
      return 0;
    }

    const sortField = root.querySelector<HTMLSelectElement>('.mc-sort select');
    const sortDir = root.querySelector<HTMLButtonElement>('[data-sort-dir]');

    function updateSortIndicators() {
      if (sortField) sortField.value = sortKey;
      if (sortDir) {
        sortDir.disabled = !sortKey;
        sortDir.setAttribute('aria-pressed', sortKey && !sortAsc ? 'true' : 'false');
        sortDir.classList.toggle('mc-sort-dir--desc', Boolean(sortKey) && !sortAsc);
      }
      root.querySelectorAll<HTMLElement>('th[data-sort]').forEach((th) => {
        const icon = th.querySelector<SVGElement>('.mc-sort-icon');
        const isActive = th.dataset.sort === sortKey;
        th.classList.toggle('mc-sort-active', isActive);
        // Screen readers hear the sorted column and its direction.
        if (isActive) th.setAttribute('aria-sort', sortAsc ? 'ascending' : 'descending');
        else th.removeAttribute('aria-sort');
        if (icon) {
          icon.classList.toggle('mc-sort-icon--active', isActive);
          icon.classList.toggle('mc-sort-icon--asc', isActive && sortAsc);
          icon.classList.toggle('mc-sort-icon--desc', isActive && !sortAsc);
        }
      });
    }

    function apply() {
      const state = readState();
      // Sort the row list, then re-append matching <tr>s to <tbody> in the
      // new order. Skips the no-results row, which stays at the end.
      const ordered = sortKey ? [...rows].sort(compareRows) : [...rows];
      if (tbody) {
        for (const row of ordered) {
          const tr = tableRowsByKey.get(row.key);
          if (tr) tbody.appendChild(tr);
          const detail = detailRowsByKey.get(row.key);
          if (detail) tbody.appendChild(detail);
        }
        if (noResultsRow) tbody.appendChild(noResultsRow);
      }
      let visible = 0;
      let lastVisible: HTMLElement | null = null;
      for (const row of ordered) {
        const tr = tableRowsByKey.get(row.key);
        if (!tr) continue;
        const passes = rowPasses(row, state);
        tr.hidden = !passes;
        tr.classList.remove('mc-last-visible');
        const detail = detailRowsByKey.get(row.key);
        if (detail) {
          detail.hidden = !passes || !isOpen(tr);
          detail.classList.remove('mc-last-visible');
        }
        if (passes) {
          visible += 1;
          lastVisible = detail && !detail.hidden ? detail : tr;
        }
      }
      // The table's bottom edge and corners go on the last row shown, which
      // filters and sorting change (the CSS can't tell from :last-child,
      // since the hidden no-results row comes last).
      lastVisible?.classList.add('mc-last-visible');
      if (visibleCountEl) visibleCountEl.textContent = String(visible);
      if (totalCountEl) totalCountEl.textContent = String(rows.filter(inPlan).length);
      if (noResultsRow) noResultsRow.hidden = visible > 0;
      const showBtn = root.querySelector<HTMLElement>('[data-show-results]');
      if (showBtn) showBtn.textContent = (text.showResults || '{n}').replace('{n}', String(visible));
      updateCounts();
      updateSortIndicators();
    }

    // "Reset filters" means "remove all filters" — every option in every
    // column gets checked, so no constraint is applied and the table shows
    // the full set. The initial page load also has every option checked
    // (Telekom-first ordering is achieved via sort, not filter).
    function reset() {
      root.querySelectorAll<HTMLInputElement>('[data-filter] input[type="checkbox"]').forEach((input) => {
        input.checked = true;
      });
      apply();
    }

    root.addEventListener('change', (evt) => {
      const target = evt.target as HTMLElement | null;
      if (!(target instanceof HTMLInputElement) || target.type !== 'checkbox') return;
      const container = target.closest<HTMLElement>('[data-filter]');
      const id = container?.dataset.filter;
      if (!id) return;
      setOption(id, target.value, target.checked);
      // Unchecking the last option of a filter turns it back to "All", so
      // the table never empties by accident.
      const group = panelGroup(id);
      if (group && !shownBoxes(group).some((i) => i.checked)) {
        filterBoxes(id).forEach((input) => {
          input.checked = true;
        });
      }
      apply();
    });

    // A filter lists only the values the shown plan has. Options of other
    // plans are hidden and stay checked, so they never narrow the rows.
    function syncOptionsToPlan() {
      if (!currentPlan) return;
      const planRows = rows.filter(inPlan);
      for (const def of filterDefs) {
        const present = new Set<string>();
        for (const row of planRows) {
          const raw = row[def.field];
          if (Array.isArray(raw)) raw.forEach((v) => present.add(String(v)));
          else if (raw != null && raw !== '') present.add(valueToString(raw));
        }
        filterBoxes(def.id).forEach((input) => {
          const label = input.closest('label');
          const has = present.has(input.value);
          if (label) label.hidden = !has;
          if (!has) input.checked = true;
        });
      }
    }

    const planSelect = root.querySelector<HTMLSelectElement>('select[id^="mc-plan-"]');
    planSelect?.addEventListener('change', () => {
      currentPlan = planSelect.value;
      root.dataset.plan = currentPlan;
      syncOptionsToPlan();
      apply();
    });

    // Clear all: in the applied-filters row and in the panel.
    root.querySelectorAll<HTMLButtonElement>('[data-clear-all]').forEach((btn) => {
      btn.addEventListener('click', () => {
        reset();
        // The applied row is gone now; keep focus on the filters.
        if (!panel?.open) openPanelBtn?.focus();
      });
    });

    // A chip removes its filter: every option back on. Focus moves to the
    // next chip, or to the panel button when none is left.
    appliedList?.addEventListener('click', (evt) => {
      const btn = (evt.target as HTMLElement | null)?.closest<HTMLButtonElement>('button[data-remove-filter]');
      const id = btn?.dataset.removeFilter;
      if (!btn || !id) return;
      const index = [...appliedList.querySelectorAll('button')].indexOf(btn);
      filterBoxes(id).forEach((input) => {
        input.checked = true;
      });
      apply();
      const chips = appliedList.querySelectorAll<HTMLButtonElement>('button');
      (chips[Math.min(index, chips.length - 1)] ?? openPanelBtn)?.focus();
    });

    // The panel is a modal dialog: focus moves in, Escape closes it, the
    // page behind is inert, and focus returns to the button.
    openPanelBtn?.addEventListener('click', () => {
      root.querySelectorAll<HTMLDetailsElement>('details.mc-filter[open]').forEach((d) => {
        d.open = false;
      });
      panel?.showModal();
    });
    panel?.querySelectorAll<HTMLButtonElement>('[data-close-panel]').forEach((btn) => {
      btn.addEventListener('click', () => panel.close());
    });
    // A click on the backdrop (outside the panel's box) closes it too.
    panel?.addEventListener('click', (evt) => {
      if (evt.target === panel) panel.close();
    });
    panel?.addEventListener('close', () => openPanelBtn?.focus());

    if (!root.hasAttribute('data-popover-bound')) {
      root.setAttribute('data-popover-bound', '');
      const closeFilters = (except: HTMLDetailsElement | null) => {
        root.querySelectorAll<HTMLDetailsElement>('details.mc-filter[open]').forEach((details) => {
          if (details !== except) details.open = false;
        });
      };
      root.addEventListener('toggle', (evt) => {
        const details = evt.target;
        if (details instanceof HTMLDetailsElement && details.classList.contains('mc-filter') && details.open) {
          closeFilters(details);
        }
      }, true);
      document.addEventListener('keydown', (evt) => {
        if (evt.key !== 'Escape') return;
        const open = root.querySelector<HTMLDetailsElement>('details.mc-filter[open]');
        if (!open) return;
        open.open = false;
        open.querySelector<HTMLElement>('summary')?.focus();
      });
      document.addEventListener('click', (evt) => {
        const target = evt.target;
        if (!(target instanceof Node)) return;
        if (target instanceof Element && target.closest('.mc-filter')) return;
        closeFilters(null);
      });
    }

    // Column-header click-to-sort. Delegated on <thead> so we don't bind
    // one handler per <th>. Clicking the active key flips direction; a new
    // key starts ascending.
    const thead = root.querySelector<HTMLElement>('thead');
    if (thead) {
      thead.addEventListener('click', (evt) => {
        const target = evt.target as HTMLElement | null;
        const th = target?.closest('th[data-sort]') as HTMLElement | null;
        if (!th) return;
        const key = th.dataset.sort;
        if (!key) return;
        if (sortKey === key) sortAsc = !sortAsc;
        else {
          sortKey = key;
          sortAsc = true;
        }
        apply();
      });
    }

    // The sort field: a column, or the recommended order (no key). The
    // button beside it flips the direction.
    sortField?.addEventListener('change', () => {
      sortKey = sortField.value;
      sortAsc = true;
      apply();
    });
    sortDir?.addEventListener('click', () => {
      if (!sortKey) return;
      sortAsc = !sortAsc;
      apply();
    });

    // The header row follows the page (src/scripts/floatingTableHead.ts).
    const floatHead = root.querySelector<HTMLElement>('.aifs-head-float');
    const dataTable = root.querySelector<HTMLTableElement>('table.models-comparison-table');
    if (floatHead && dataTable) {
      setupFloatingHead({
        root,
        float: floatHead,
        bar: root.querySelector<HTMLElement>('.models-comparison__filterbar'),
        table: dataTable,
        sortControl: '.mc-sort-header',
      });
    }

    // Cloud tag in a row toggles its value in the Cloud filter. Click an
    // already-selected cloud to remove it; click an unselected cloud to add
    // it. Delegated so it survives any future row re-render. We dispatch a
    // synthetic 'change' event so the existing change listener handles both
    // the apply() call AND the zero-selection auto-revert (uncheck the last
    // remaining cloud → all three snap back to checked).
    // Details: the row's other columns, in the row under it.
    function setDetails(btn: HTMLButtonElement, open: boolean) {
      const tr = btn.closest<HTMLTableRowElement>('tr[data-key]');
      const detail = tr?.dataset.key ? detailRowsByKey.get(tr.dataset.key) : null;
      if (!tr || !detail) return;
      // The name stays "Show details"; aria-expanded (and the chevron) say
      // whether they are open.
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      tr.classList.toggle('mc-open', open);
      detail.hidden = !open || tr.hidden;
      // The table's bottom edge follows the last row shown.
      if (tr.classList.contains('mc-last-visible') || detail.classList.contains('mc-last-visible')) {
        tr.classList.toggle('mc-last-visible', !open);
        detail.classList.toggle('mc-last-visible', open);
      }
    }

    // A click anywhere on a row toggles its details, as its Show details
    // button does. The button stays the one control for keyboard and screen
    // readers; the row is only a larger pointer target. Clicks on the row's
    // own controls (links, buttons, tooltip triggers) and the end of a text
    // selection inside the row are left alone.
    const ROW_CONTROLS = 'a, button, input, select, textarea, label, summary, [tabindex], [contenteditable]';
    root.addEventListener('click', (evt) => {
      const target = evt.target as HTMLElement | null;
      const btn = target?.closest('button.mc-more__btn') as HTMLButtonElement | null;
      if (btn && root.contains(btn)) {
        setDetails(btn, btn.getAttribute('aria-expanded') !== 'true');
        return;
      }
      const tr = target?.closest<HTMLTableRowElement>('tr[data-key]');
      if (!tr || !root.contains(tr) || target?.closest(ROW_CONTROLS)) return;
      const selection = window.getSelection();
      if (selection && !selection.isCollapsed && selection.toString().trim() !== '' && tr.contains(selection.anchorNode)) return;
      const rowBtn = tr.querySelector<HTMLButtonElement>('button.mc-more__btn');
      if (rowBtn) setDetails(rowBtn, rowBtn.getAttribute('aria-expanded') !== 'true');
    });

    // An open filter menu stays inside the window: near the end edge it
    // moves back, and it is never wider than the window.
    function placeFilterMenu(details: HTMLDetailsElement) {
      const menu = details.querySelector<HTMLElement>('.mc-filter__menu');
      const summary = details.querySelector<HTMLElement>('summary');
      if (!menu || !summary) return;
      if (!details.open) {
        menu.style.position = '';
        menu.style.top = '';
        menu.style.left = '';
        menu.style.maxWidth = '';
        menu.style.width = '';
        return;
      }
      const rect = details.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const maxW = Math.min(240, vw - 16);
      const left = Math.max(8, Math.min(rect.left, vw - maxW - 8));
      menu.style.position = 'absolute';
      menu.style.top = '';
      menu.style.right = 'auto';
      menu.style.left = `${Math.round(left - rect.left)}px`;
      menu.style.width = `${maxW}px`;
      menu.style.maxWidth = `${maxW}px`;
      menu.style.boxSizing = 'border-box';
      menu.style.overflowX = 'hidden';
    }

    root.addEventListener('toggle', (evt) => {
      const details = evt.target;
      if (details instanceof HTMLDetailsElement && details.classList.contains('mc-filter')) {
        placeFilterMenu(details);
      }
    }, true);

    root.addEventListener('click', (evt) => {
      const target = evt.target as HTMLElement | null;
      const btn = target?.closest('.mc-cloud-filter-btn') as HTMLElement | null;
      if (!btn) return;
      const cloud = btn.dataset.cloud;
      if (!cloud) return;
      const checkbox = root.querySelector<HTMLInputElement>(
        `fieldset[data-filter="cloud"] input[type="checkbox"][value="${cloud}"]`,
      );
      if (!checkbox) return;
      checkbox.checked = !checkbox.checked;
      checkbox.dispatchEvent(new Event('change', { bubbles: true }));
    });

    // Close open filters when clicking outside
    document.addEventListener('click', (evt) => {
      const target = evt.target as Node | null;
      root.querySelectorAll<HTMLDetailsElement>('details.mc-filter[open]').forEach((d) => {
        if (target && !d.contains(target)) d.open = false;
      });
    });

    syncOptionsToPlan();
    apply();
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>('.models-comparison')
      .forEach((root) => initModelsComparison(root));
  }

  document.addEventListener('astro:page-load', initAll);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

<style>
  /* Spacing around it: the block gap from layout.css. */
