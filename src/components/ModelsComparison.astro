    padding-block: calc(var(--aifs-filter-panel-padding) / 2);
    border-bottom: var(--aifs-border-width-standard) solid var(--aifs-filter-panel-border);
  }

  .mc-panel__title {
    font-size: var(--aifs-text-h4-font-size);
