    color: var(--aifs-color-text-muted);
  }

  .mc-sort {
    display: flex;
    align-items: center;
    gap: var(--aifs-filter-panel-option-gap);
    min-width: 0;
  }

  .mc-sort :global(.aifs-select) {
    min-width: 0;
    width: var(--aifs-models-table-sort-width);
    max-width: 100%;
  }

  .mc-sort :global(.mc-sort-dir) {
    flex: 0 0 auto;
  }

  /* One arrow at a time: up while ascending, down while descending. */
  .mc-sort :global(.mc-sort-dir__down),
  .mc-sort :global(.mc-sort-dir--desc .mc-sort-dir__up) {
    display: none;
  }

  .mc-sort :global(.mc-sort-dir--desc .mc-sort-dir__down) {
    display: inline-block;
  }

  /* Counts that change with every filter click: equal-width digits, so
     the line and the button labels do not shift. */
  .models-comparison__count,
  .models-comparison :global([data-filter-count]),
  .mc-panel :global([data-show-results]) {
    font-variant-numeric: tabular-nums;
  }

  /* The table fits the column: no scroll area. Positioned, so absolutely
     placed content in the cells (the links' screen-reader text) stays
     inside. */
  .models-comparison__scroll {
    position: relative;
    max-width: 100%;
  }

  /* Shared design and behaviour: src/styles/data-table.css. Here only what
     is this table's own. Every column wraps at spaces, so the table takes
     the column's width; numbers and tags stay whole. */
  .models-comparison-table {
    width: 100%;
  }

  .models-comparison-table tbody td {
