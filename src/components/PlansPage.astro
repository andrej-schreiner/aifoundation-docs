// The models table formats prices and limits client-side; pass it the page locale.
// Only set on German pages so the English data-t payload stays unchanged.
if (numberLocale === 'de') t.numberLocale = numberLocale;
// The † (cached-token note) follows real cached prices only, not "—".
t.cachedDaggerPricedOnly = true;


const hostTooltips: Record<string, string> = {
  'T-Cloud': t.tooltipTCloud,
  External: t.tooltipExternal,
};

const creatorTooltips = getProviderTooltips(isDE);

const tierTooltips: Record<string, string> = {
  Standard: t.tooltipStandard,
  Premium: t.tooltipPremium,
};

// Plan display config
const planConfigs = [
  {
    packageName: 'Essential',
    label: 'Essential',
    basePrice: planPrice(1000),
    tokenPrice: priceText('0.20 / 0.65'),
    rpm: isDE ? 'Niedriger' : 'Lower',
    modelHost: ['T-Cloud', 'External'],
    modelTier: ['Standard'],
    isFilterAvailable: true,
  },
  {
    packageName: 'Professional',
    label: 'Professional',
    basePrice: planPrice(3000),
    tokenPrice: priceText('0.20 / 0.65'),
    rpm: isDE ? 'Mittel' : 'Medium',
    modelHost: ['T-Cloud', 'External'],
    modelTier: ['Standard', 'Premium'],
    isFilterAvailable: true,
  },
  {
    packageName: 'Agentic',
    label: 'Agentic',
    basePrice: planPrice(5000),
    tokenPrice: priceText('0.20 / 0.65'),
    rpm: isDE ? 'Höchster' : 'Highest',
    modelHost: ['T-Cloud', 'External'],
    modelTier: ['Standard', 'Premium'],
    isFilterAvailable: true,
  },
  {
    packageName: 'Tarif Standard3000 Template',
    label: 'Enterprise',
    basePrice: 'Custom',
    tokenPrice: priceText('0.20 / 0.65'),
    rpm: isDE ? 'Individuell' : 'Custom',
    modelHost: ['T-Cloud', 'External'],
    modelTier: ['Standard', 'Premium'],
    isFilterAvailable: false,
  },
];


// Helper: parse deployment region
function parseCloud(deploymentRegion: string): string {
  const lower = deploymentRegion.toLowerCase();
  const provider = lower.split('-')[0];
  if (provider === 'otc') return 'T-Cloud';
  if (provider === 'azure') return 'Azure';
  if (provider === 'gcp') return 'GCP';
  return deploymentRegion;
}

function parseModelHost(deploymentRegion: string): string {
  return deploymentRegion.toLowerCase().startsWith('otc-') ? 'T-Cloud' : 'External';
}

function parseCloudProvider(deploymentRegion: string): string {
  const lower = deploymentRegion.toLowerCase();
  const provider = lower.split('-')[0];
  if (provider === 'otc') return 'T-Cloud';
  if (provider === 'azure') return 'Azure';
  if (provider === 'gcp') return 'GCP';
  return deploymentRegion;
}

function localizeSubName(label: string): string {
  if (!isDE) return label;
  return label
    .replaceAll('Azure Sweden', 'Azure Schweden')
    .replaceAll('Azure France', 'Azure Frankreich')
    .replaceAll('Azure Worldwide', 'Azure Weltweit');
}

function parseModelCreator(exactModelName: string | undefined, displayModelName: string): string {
  return creatorNameFor(exactModelName, displayModelName);
}

function parseLocation(deploymentRegion: string): { name: string; code: string } {
  return parseRegionLocation(deploymentRegion, isDE);
}

function mapModelRow(
  model: any,
  fallbackModel: any,
  modelHost: string,
  cloudProvider: string,
  serverLocation: string,
  locationCode: string,
  dataProcessing: { name: string; code: string },
  isSubRow: boolean,
) {
  const exactModelName = model.exactModelName ?? fallbackModel.exactModelName;
  const displayName = model.displayModelName || fallbackModel.displayModelName;
  const modelCategory = resolvePrimaryCategory(exactModelName);

  return {
    modelHost,
    cloudProvider,
    creator: parseModelCreator(exactModelName, displayName),
    exactModelName: model.exactModelName,
    modelTier: model.modelTier || 'Standard',
    // Display-only: some models run on two clouds, which one region cannot say.
    cloudProviderLabel: cloudLabelFor(exactModelName, parseCloudProvider(
      model.deploymentRegion ?? fallbackModel.deploymentRegion,
    )),
    cloudProviderFullName: cloudFullNameFor(exactModelName, ''),
    displayName,
    catalogRank: catalogRank(displayName),
    subName: localizeSubName(model.modelLabel || ''),
    inputPrice: model.inputPricePerMillionTokens ?? fallbackModel.inputPricePerMillionTokens,
    imageInputPrice: model.imageInputPricePerMillionTokens ?? fallbackModel.imageInputPricePerMillionTokens ?? null,
    outputPrice: model.outputPricePerMillionTokens ?? fallbackModel.outputPricePerMillionTokens,
    isNew: isNewModel(exactModelName),
    // Embedding models return vectors, not tokens: they show an input price only.
    noOutputTokens: modelCategory === 'embeddings',
    // Cached input tokens are a fixed fraction of the input price, and only
    // priced for T-Cloud-hosted language models — see shared/lib/cachedTokenPricing.
    cachedInputPrice: cachedInputPrice(
      model.inputPricePerMillionTokens ?? fallbackModel.inputPricePerMillionTokens,
      model.deploymentRegion ?? fallbackModel.deploymentRegion,
      modelCategory,
    ),
    cachedPricingPublished: hasCachedTokenPricing(
      model.deploymentRegion ?? fallbackModel.deploymentRegion,
      modelCategory,
    ),
    tpm: model.inputTokenPerMinuteLimit ?? fallbackModel.inputTokenPerMinuteLimit,
    contextWindow: model.contextWindow ?? fallbackModel.contextWindow ?? null,
    termsOfUseUrl: model.termsOfUseUrl ?? fallbackModel.termsOfUseUrl ?? '',
    dataProtectionUrl: model.dataProtectionUrl ?? fallbackModel.dataProtectionUrl ?? '',
    serverLocation,
    locationCode,
    dataProcessing: dataProcessing.name,
    dataProcessingCode: dataProcessing.code,
    inputTokenMin: model.inputTokenPerMinuteLimit ?? fallbackModel.inputTokenPerMinuteLimit,
    outputTokenMin: model.outputTokenPerMinuteLimit ?? fallbackModel.outputTokenPerMinuteLimit,
    rpm: model.requestPerMinuteLimit ?? fallbackModel.requestPerMinuteLimit,
    isSubRow,
  };
}

// Build plan data for client-side use
const plansData = allPricing
  .map((plan: any) => {
    const config = planConfigs.find((c) => c.packageName === plan.packageName);
    // On the index page, where no specific plan is selected, ignore packages that are not present
    // in planConfigs. This keeps the page scoped to filterable plans only, so the initial filter
    // state and selected plan index are derived from the same plan set.
    if (!selectedPlanId && (!config || !config.isFilterAvailable)) return null;
    if (selectedPlanId && plan.packageName !== selectedPlanId) return null;
    const models = (plan.modelQuotaConfigs || [])
      .filter((m: any) => !isRetiredModel(m.exactModelName) && !isHiddenModel(m.exactModelName))
      .map((m: any) => {
        const unconfirmed = hostingUnconfirmed(m.exactModelName) || !m.deploymentRegion;
        const modelHost = unconfirmed ? '' : parseModelHost(m.deploymentRegion);
        const cloudProvider = unconfirmed ? '' : parseCloudProvider(m.deploymentRegion);
        const { name: locName, code: locCode } = unconfirmed
          ? { name: '', code: '' }
          : parseLocation(m.deploymentRegion);
        const processing = unconfirmed
          ? { name: '', code: '' }
          : parseDataProcessing(m.exactModelName, m.deploymentRegion, isDE);
        const rows: any[] = [mapModelRow(m, m, modelHost, cloudProvider, locName, locCode, processing, false)];
        if (m.modelQuotaMetadata?.data) {
          for (const sub of m.modelQuotaMetadata.data) {
            rows.push(mapModelRow(sub, m, modelHost, cloudProvider, locName, locCode, processing, true));
          }
        }
        return rows;
      })
      .flat();
    return {
      packageName: plan.packageName,
      isFilterAvailable: config?.isFilterAvailable,
      label: config?.label || plan.packageName,
      models,
    };
  })
  .filter(Boolean);

const showRatePlans = !selectedPlanId;
const initialPlanIndex = selectedPlanId ? plansData.findIndex((p: any) => p.packageName === selectedPlanId) : 0;
---

<div class="plans-page">
  {
    showRatePlans && (
      <section class:list={['rate-plans-section', { 'rate-plans-section--compact': compact }]}>
        {!compact && <h2>{t.ratePlansTitle}</h2>}
        {!compact && <p class="par-description" set:html={t.subtitle} />}
          <ul class:list={['plan-tiles', { 'plan-tiles--compact': compact }]}>
            {(compact ? planConfigs.filter((plan) => plan.basePrice !== 'Custom') : planConfigs).map((plan) => {
              const price = plan.basePrice === 'Custom' ? t.priceCustom : plan.basePrice;
              const meter =
                plan.label === 'Essential' ? 1 : plan.label === 'Professional' ? 2 : plan.label === 'Agentic' ? 3 : 0;
              const blurb =
                plan.label === 'Essential'
                  ? t.blurbEssential
                  : plan.label === 'Professional'
                    ? t.blurbProfessional
                    : plan.label === 'Agentic'
                      ? t.blurbAgentic
                      : t.blurbEnterprise;
              const checks = [
                { key: 'tcloud', on: plan.modelHost.includes('T-Cloud'), label: t.checkTCloud },
                { key: 'hyperscaler', on: plan.modelHost.includes('External'), label: t.checkHyperscaler },
                plan.label === 'Enterprise'
                  ? { key: 'premium', on: false, dash: true, label: t.premiumCustom }
                  : { key: 'premium', on: plan.modelTier.includes('Premium'), label: t.checkPremium },
              ].filter((item) => !compact || item.key === 'premium');
              return (
                <li class="plan-tile" data-plan={planTagKey(plan.label)}>
                  {/* Header: the plan tag (the plan's colour), the price, what
                      the price means. A hairline separates it from the details. */}
                  <div class="plan-tile__head">
                    <h3 class="plan-tile__name">
                      <PlanTag plan={plan.label} size="small" />
                    </h3>
                    <p class="plan-tile__price">{price}</p>
                    <p class="plan-tile__unit">{plan.basePrice !== 'Custom' ? t.perMonth : t.byAgreement}</p>
                  </div>
                  {!compact && <p class="plan-tile__for">{blurb}</p>}
                  {/* Throughput as a bar in the plan's colour: one to four
                      segments; a custom plan fills it. The link to the rate
                      limits is in the sentence above the cards. */}
                  <div class="plan-meter">
                    <span class="plan-meter__label">
                      {t.throughputLabel}
                      <span class="sr-only">{meter === 0 ? t.priceCustom : `${meter} / 4`}</span>
                    </span>
                    <span class="plan-meter__bar" aria-hidden="true">
                      {[1, 2, 3, 4].map((step) => (
                        <span class:list={['plan-meter__seg', { 'is-on': meter === 0 || step <= meter }]} />
                      ))}
                    </span>
                  </div>
                  <ul class="plan-tile__list">
                    {checks.map((item) => (
                      <li class:list={{ 'is-off': !item.on && !item.dash }}>
                        <span class:list={['plan-tile__mark', item.dash ? 'is-custom' : item.on ? 'is-yes' : 'is-no']}>
                          {item.dash ? '—' : <Icon name={item.on ? 'action-checkmark' : 'action-close'} size={16} />}
                        </span>
                        <span>{keepWholeParts(item.label).map((part) => (part.whole ? <span class="nowrap">{part.text}</span> : part.text))}</span>
                      </li>
                    ))}
                  </ul>
                  {!compact && (
                    <div class="plan-tile__action">
                      {plan.basePrice === 'Custom' && (
                        <Button variant="secondary" size="small" href={t.contactHref} class="plan-tile__cta">
                          {t.contactCta}
                        </Button>
                      )}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        {!compact && <p class="plan-spend">{t.spendNote}</p>}
      </section>
    )
  }

  {!compact && <section class="models-section plans-models-section">
    {/* The models table of All models, with the plan preset: this plan's
        prices, limits per minute and legal links. */}
    <h2>{modelsSectionTitle || t.modelsTitle}</h2>
    {modelsSectionTitle
      ? (t.modelsSubtitleList as string[]).map((item) =>
          item.startsWith('\n') ? <p class="plans-models-intro"><strong>{item.trim()}</strong></p> : <p class="plans-models-intro">{item}</p>,
        )
      : <p class="plans-models-intro">{t.modelsSubtitle}</p>}
    <ModelsComparison
      columns="plan"
      plans={plansData}
      plan={plansData[initialPlanIndex]?.packageName}
      planLocked={Boolean(selectedPlanId)}
    />
    <div class="plans-models-notes">
      <p id="cached-token-notes">&dagger; {keepWholeParts(t.cachedPriceNote).map((part) => (part.whole ? <span class="nowrap">{part.text}</span> : part.text))}</p>
      <p id="worldwide-location-notes">
        {t.worldwideLocationNote}{' '}
        <a href={t.enterpriseTrustHref}>{t.enterpriseTrustLabel}</a>
      </p>
      <p>{t.adequacyNote}</p>
    </div>
  </section>}
</div>

<style is:global>
  .plans-page {
    width: 100%;
    --model-link-color: var(--aifs-color-link-standard);
    --model-link-icon-color: var(--aifs-color-text-body);
  }

  :root[data-theme='dark'] .plans-page {
    --model-link-color: var(--aifs-color-link-standard);
    --model-link-icon-color: var(--aifs-color-link-standard);
  }

  /* Each section (rate plans, models) is a page section: the section gap
     between them, the after-heading gap under their headings. */
  .plans-page > * + * {
    margin-top: var(--aifs-rhythm-heading-2);
  }

  .plans-page :is(.rate-plans-section, .plans-models-section) > h2 {
    margin: 0 0 var(--aifs-rhythm-after-heading);
  }

  /* Intro, table and notes: the flow gap between paragraphs, the block gap
     around the table. */
  .plans-models-intro {
    margin: 0 0 var(--aifs-rhythm-flow);
  }

  .plans-models-section > .models-comparison {
    margin-top: var(--aifs-rhythm-block);
  }

  .plans-models-notes {
    display: grid;
    gap: var(--aifs-rhythm-after-heading);
    margin-top: var(--aifs-rhythm-flow);
    color: var(--aifs-color-text-muted);
    font-size: var(--aifs-text-small-font-size);
  }

  .plans-models-notes p {
    margin: 0;
  }

  .rate-plans-section {
    container-type: inline-size;
    container-name: rateplans;
  }

  .plan-tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--aifs-layout-grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }

  /* Rate plan cards: the card frame (aifs.card.*), neutral; the plan tag
     carries the plan's colour.
     Rows line up across the cards (subgrid): header, description,
     throughput, features, action. Not a link itself; the button is. */
  .plan-tile {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    gap: var(--aifs-model-card-gap);
    min-width: 0;
    margin: 0;
    padding: 0 0 var(--aifs-model-card-padding);
    overflow: hidden;
    border: var(--aifs-card-border-width) solid var(--aifs-card-border);
    border-radius: var(--aifs-card-radius);
    background: var(--aifs-card-background);
  }

  .plan-tile > :not(.plan-tile__head) {
    margin: 0;
    padding-inline: var(--aifs-model-card-padding);
  }

  .plan-tile__head {
    display: flex;
    flex-direction: column;
    gap: var(--aifs-rhythm-after-heading);
    padding: var(--aifs-model-card-padding);
    border-bottom: var(--aifs-card-border-width) solid var(--aifs-card-border);
  }

  .sl-markdown-content .plan-tile__name {
    margin: 0;
    line-height: 0;
  }

  /* Placeholder that keeps the row line when tiles sit side by side. */
  .plan-tile__unit--empty,
  .plan-tile__action--empty {
    display: none;
  }

  .plan-tile__price {
    margin: 0;
    color: var(--aifs-color-text-body);
    font-family: var(--aifs-text-h1-font-family);
    font-size: var(--aifs-text-h1-font-size);
    font-weight: var(--aifs-text-h1-font-weight);
    line-height: var(--aifs-text-h1-line-height);
    font-variant-numeric: tabular-nums;
  }

  .sl-markdown-content .plan-tile__head > * + * {
    margin-top: 0;
  }

  .plan-tile__unit {
    margin: calc(-1 * var(--aifs-model-card-logo-padding)) 0 0;
    color: var(--aifs-color-text-muted);
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
  }

  .plan-tile__for {
    color: var(--aifs-color-text-body);
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
  }

  .plan-meter {
    display: flex;
    flex-direction: column;
    gap: var(--aifs-model-card-row-gap);
  }

  .plan-meter__label {
    color: var(--aifs-color-text-muted);
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
  }

  .plan-meter__bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--aifs-model-card-logo-padding);
    height: var(--aifs-model-card-row-gap);
  }

  .plan-meter__seg {
    border-radius: var(--aifs-radius-indicator);
    background: var(--aifs-color-scale-6);
  }

  /* Filled segments take the plan's own tag colour; magenta stays for
     actions. */
  .plan-tile[data-plan='essential'] .plan-meter__seg.is-on {
    background: var(--aifs-tag-plan-essential-text);
  }

  .plan-tile[data-plan='professional'] .plan-meter__seg.is-on {
    background: var(--aifs-tag-plan-professional-text);
  }

  .plan-tile[data-plan='agentic'] .plan-meter__seg.is-on {
    background: var(--aifs-tag-plan-agentic-text);
  }

  .plan-tile[data-plan='enterprise'] .plan-meter__seg.is-on {
    background: var(--aifs-tag-plan-enterprise-text);
  }

  .plan-tile__list {
    display: flex;
    flex-direction: column;
    gap: var(--aifs-model-card-row-gap);
    padding-block: 0;
    list-style: none;
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
  }

  .sl-markdown-content .plan-tile__list > li + li {
    margin-top: 0;
  }

  .plan-tile__list li {
    display: flex;
    align-items: center;
    gap: var(--aifs-model-card-row-gap);
    min-width: 0;
  }

  .plan-tile__list li.is-off {
    color: var(--aifs-color-text-muted);
  }

  .plan-tile__mark {
    display: inline-flex;
    flex: 0 0 auto;
  }

  .plan-tile__mark.is-yes {
    color: var(--aifs-color-success);
  }

  .plan-tile__mark.is-no {
    color: var(--aifs-color-text-muted);
  }

  .plan-tile__action {
    align-self: end;
  }

  /* Full width of the card. Colour, height, radius and states come from
     .aifs-button--secondary (button.css). */
  .plan-tile__cta {
    width: 100%;
  }

  .plan-spend {
    margin: 8px 0 0;
    color: var(--aifs-color-text-muted);
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
  }

  /* Phones stay one column. Two by two until four cards fit: 58rem of
     section, the German Premium tile's longest line (about 1600px windows
     with On this page beside the fluid column). */
  @container rateplans (min-width: 34rem) {
    .plan-tiles {
      grid-template-columns: 1fr 1fr;
    }

    .plan-tile {
      grid-template-rows: subgrid;
      grid-row: span 5;
    }
  }

  @container rateplans (min-width: 58rem) {
    .plan-tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Overview: three tiles (tag, price, unit, meter, Premium) side by side once
     each has room for "Throughput (TPM / RPM)" on one line. */
  @container rateplans (min-width: 34rem) {
    .plan-tiles--compact {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Compact tiles have three rows: header, throughput, Premium. */
    .plan-tiles--compact .plan-tile {
      grid-row: span 3;
    }
  }

  .rate-plans-section--compact {
    margin-block: var(--aifs-rhythm-after-heading) 0;
  }

  .content-panel .rate-plans-section > * + * {
    margin-top: 8px;
  }

</style>
