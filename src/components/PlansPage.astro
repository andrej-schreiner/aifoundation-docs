    font-size: 0.85rem;
  }

  .sort-icon {
    font-size: 1rem;
    margin-left: 0.25rem;
    opacity: 0.5;
  }

  .sort-icon.active {
    color: var(--aifs-color-brand-text);
    opacity: 1;
  }

  @container rateplans (max-width: 36rem) {
    .rate-plans-section .table-wrapper {
      overflow: visible;
      padding-top: 0;
      margin-top: 0;
      border: 0;
    }

    .rate-plans-section .plans-table,
    .rate-plans-section .plans-table tbody {
      display: block;
      width: 100%;
      min-width: 0;
      border: 0;
    }

    .rate-plans-section .plans-table thead {
      display: none;
    }

    /* Plan chip and commitment fill the first line. Limits, host and tier
       chips share the next line. */
    .rate-plans-section .plans-table tr {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 8px;
      width: 100%;
      box-sizing: border-box;
      border: var(--aifs-border-width-standard) solid var(--aifs-color-border-subtle);
