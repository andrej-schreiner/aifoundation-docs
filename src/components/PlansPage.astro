<div class="plans-page">
  {
    showRatePlans && (
      <section class="rate-plans-section">
        <h2>{t.ratePlansTitle}</h2>
        <p class="par-description">{t.subtitle}</p>
        <div class="table-wrapper">
          <table class="plans-table">
            <thead>
              <tr>
                <th>{t.thPlan}</th>
                <th>
                  {t.thCommitment}
                  <div class="plans-table__small-text">{t.thCommitmentUnit}</div>
                </th>
                <th>
                  {t.thTokenPrice}
                  <div class="plans-table__small-text">{t.thTokenPriceUnit}</div>
                </th>
                <th>
                  {t.thRPM} {!legacy && <sup><a href={t.rpmTpmAnchor}>*</a></sup>}
                  <div class="plans-table__small-text">{t.thRPMUnit}</div>
                </th>
                <th>{t.thModelHost}</th>
                {!legacy && <th>{t.thModelTier}</th>}
              </tr>
            </thead>
            <tbody>
              {planConfigs.map((plan) => (
                <tr>
                  <td>
                    <span class="plans-tag" style={`background:${plan.color};color:#000`}>
                      {plan.label}
                    </span>
                  </td>
                  <td>
                    <span class="plans-table__main-text">{plan.basePrice}</span>
                  </td>
                  <td>{plan.tokenPrice} †</td>
                  <td>{plan.rpm} {!legacy && <sup><a href={t.rpmTpmAnchor}>*</a></sup>}</td>
                  <td>
                    {plan.modelHost.map((cloud, i) => (
                      <>
                        {i > 0 && ' '}
                        <Tooltip text={hostTooltips[cloud] || cloud} maxWidth="26rem">
                          <span class={`plans-tag ${cloud === 'T-Cloud' ? 'tag-tcloud' : 'tag-cloud'}`}>{cloud}</span>
                        </Tooltip>
                      </>
                    ))}
                  </td>
                  {!legacy && (
                    <td>
                      {plan.modelTier.map((tier, i) => (
                        <>
                          {i > 0 && ' '}
                          <Tooltip text={tierTooltips[tier] || tier} maxWidth="24rem">
                            <span class={`plans-tag ${tier === 'Premium' ? 'tag-premium' : 'tag-tier'}`}>{tier}</span>
                          </Tooltip>
                        </>
                      ))}
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <small>{t.footnote}</small>
        <br />
        <small>
          <a href={isDE ? '/de/reference/rate-limits' : '/reference/rate-limits'}>
            {isDE ? 'Mehr zu Rate-Limits →' : 'Learn more about rate limits →'}
          </a>
        </small>

        <aside class="commitment-note" aria-label={t.commitmentNoteLead}>
          <strong class="commitment-note__lead">{t.commitmentNoteLead}</strong> {t.commitmentNoteBody}
        </aside>
      </section>
    )
  }

  <ModelsTable
    plansData={plansData}
    effectiveIndex={initialPlanIndex}
    locked={Boolean(selectedPlanId)}
    translations={t}
    modelBrandIcons={modelBrandIcons}
    hostTooltips={hostTooltips}
    tierTooltips={tierTooltips}
    creatorTooltips={creatorTooltips}
    testModelsSectionTitle={modelsSectionTitle}
    legacy={legacy}
  />
</div>

<style is:global>
  .plans-page {
    width: 100%;
    --model-link-color: #4f5cff;
    --model-link-icon-color: #000000;
  }

  :root[data-theme='dark'] .plans-page {
    --model-link-color: var(--aifs-d-link);
    --model-link-icon-color: var(--aifs-d-link);
  }

  :root[data-theme='dark'] .plans-table th {
    background: var(--aifs-d-surface);
    color: var(--aifs-d-text);
    border-bottom: 1px solid var(--aifs-d-border);
  }

  :root[data-theme='dark'] .plans-table th a {
    color: inherit;
  }

  :root[data-theme='dark'] .sort-icon.active {
    color: var(--aifs-d-link);
  }

  :root[data-theme='dark'] .tag-premium {
    background: var(--aifs-d-surface);
    color: #7fd4ea;
    box-shadow: inset 0 0 0 1px var(--aifs-d-border);
  }

  .rate-plans-section {
    margin-bottom: 2rem;
  }

  /* Scoped to the rate-plans table: ModelsTable renders its own .table-wrapper
     on the same page (vertical scroller with sticky headers) that must not
     inherit the padding/margin trick below. */
  .rate-plans-section .plans-table {
    border: 1px solid var(--sl-color-gray-5);
  }

  .rate-plans-section .table-wrapper {
    max-width: 100%;
    overflow-x: auto;
    /* Scroll-clipping makes overflow-y compute to auto too; the padding/margin
       pair keeps room inside the scrollport for the row tooltips that open
       upward, so they aren't cut off at the wrapper's top edge. */
    padding-top: 7rem;
    margin-top: -7rem;
  }

  @media (min-width: 80rem) {
    .rate-plans-section .table-wrapper {
      overflow-x: visible;
      padding-top: 0;
      margin-top: 0;
    }
  }

  /* The Model-Host / Model-Tier tooltips sit in the last two columns; centered
