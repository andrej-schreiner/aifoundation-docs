  thContextWindowUnit: 'Tokens',
  thLinks: 'Links',
  linkTermsOfUse: isDE ? 'Nutzungsbedingungen' : 'Terms of use',
  linkDataProtection: isDE ? 'Datenschutz' : 'Data protection',
  thHostingPlatform: 'Hosting platform',
  thServerLocation: isDE ? 'Serverstandort' : 'Server location',
  emptyCatalogNote: isDE
    ? 'Für diesen Tarif sind im aktuellen Katalog keine Modelle gelistet.'
    : 'This plan has no models in the current catalog.',
