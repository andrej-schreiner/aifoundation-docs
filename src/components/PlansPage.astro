              const blurb =
                plan.label === 'Essential'
                  ? t.blurbEssential
                  : plan.label === 'Professional'
                    ? t.blurbProfessional
                    : plan.label === 'Agentic'
                      ? t.blurbAgentic
                      : t.blurbEnterprise;
              const checks = [
                { on: plan.modelHost.includes('T-Cloud'), label: t.checkTCloud },
                { on: plan.modelHost.includes('External'), label: t.checkHyperscaler },
                { on: plan.modelTier.includes('Premium'), label: t.checkPremium },
              ];
              return (
                <li class="plan-tile">
                  <span class={`plans-tag tag-plan-${planTagKey(plan.label)}`}>{plan.label}</span>
                  <p class="plan-tile__price">{price}</p>
                  <p class="plan-tile__unit">{plan.basePrice !== 'Custom' ? t.perMonth : '\u00a0'}</p>
                  <p class="plan-tile__for">{blurb}</p>
                  <a class="plan-meter" href={t.rateLimitsHref}>
                    <span class="plan-meter__label">{t.throughputLabel}</span>
                    <span class="plan-meter__track">
                      <span class="plan-meter__bar" aria-hidden="true">
                        {[1, 2, 3, 4].map((step) => (
                          <span
                            class:list={[
                              'plan-meter__seg',
                              { 'is-on': meter > 0 && step <= meter, 'is-custom': meter === 0 },
                            ]}
                          />
                        ))}
                      </span>
                      {meter === 0 && <span class="plan-meter__custom">{t.priceCustom}</span>}
                    </span>
                  </a>
                  <ul class="plan-tile__list">
                    {checks.map((item) => (
                      <li>
                        <span class:list={['plan-tile__mark', item.on ? 'is-yes' : 'is-no']}>
                          <Icon name={item.on ? 'action-checkmark' : 'action-close'} size={16} />
                        </span>
                        <span>{item.label}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="plan-tile__action">
                    {plan.basePrice === 'Custom' && (
                      <Button variant="secondary" size="small" href={t.contactHref} class="plan-tile__cta">
                        {t.contactCta}
                      </Button>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
        {!showTokenPriceColumn && (
          <p class="token-price-note">
            {t.thTokenPrice}: {planConfigs[0].tokenPrice} <span class="nowrap">{t.thTokenPriceUnit}{'\u00A0'}†</span>
          </p>
        )}
        <p class="plan-spend">{t.spendNote}</p>
        <small>{t.footnote}</small>
      </section>
    )
  }

  <ModelsTable
    plansData={plansData}
    effectiveIndex={initialPlanIndex}
    locked={Boolean(selectedPlanId)}
    translations={t}
    logos={logos}
    hostTooltips={hostTooltips}
    tierTooltips={tierTooltips}
    creatorTooltips={creatorTooltips}
    testModelsSectionTitle={modelsSectionTitle}
    legacy={legacy}
  />
</div>

