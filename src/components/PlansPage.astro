  unitTokens: isDE ? 'Tokens' : 'tokens',
  sortBy: isDE ? 'Nach {label} sortieren' : 'Sort by {label}',
  dynamicLimit: isDE ? 'dynamisch' : 'dynamic',
  newTag: isDE ? 'Neu' : 'New',
  // Display label for the 'External' host key (tooltips and filters stay keyed by 'External').
  hostExternal: isDE ? 'Extern' : 'External',
  dynamicQuota: isDE ? 'Dynamisches Kontingent' : 'Dynamic Shared Quota',
  labelSortBy: isDE ? 'Sortieren nach' : 'Sort by',
  labelSortCatalog: isDE ? 'Empfohlen' : 'Recommended',
  labelExpandAll: isDE ? 'Alle Details öffnen' : 'Expand all details',
  labelCollapseAll: isDE ? 'Alle Details schließen' : 'Collapse all details',
  cachedShort: isDE ? 'Cache' : 'cached',
  thInputPrice: isDE ? 'Input-Token-Preis' : 'Input token price',
  thOutputPrice: isDE ? 'Output-Token-Preis' : 'Output token price',
  thCachedInputPrice: isDE ? 'Cached-Input-Token-Preis' : 'Cached input token price',
  cachedPriceNote: isDE
    ? `Aus dem Prefix-Cache bediente Prompt-Tokens werden mit ${CACHED_INPUT_PRICE_PERCENT} % des normalen Input-Token-Preises abgerechnet. Das gilt ausschließlich für T-Cloud-gehostete Sprachmodelle, nicht für Embedding-, Reranking- und Speech-to-Text-Modelle.`
    : `Prompt tokens served from the prefix cache are billed at ${CACHED_INPUT_PRICE_PERCENT}% of the normal input token price. This applies to T-Cloud-hosted language models only, not to embedding, reranking or speech-to-text models.`,
  cachedPriceUnavailable: '—',
  priceTba: isDE ? 'Preis folgt' : 'Pricing to be announced',
