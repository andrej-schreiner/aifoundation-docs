---
// The plans page: rate plan cards, then the plan's models in ModelsComparison
// (plan preset). `selectedPlanId` shows one plan; without it, every plan with a
// plan field.
import { parseDataProcessing, parseLocation as parseRegionLocation } from '../shared/lib/location';
import allPricing from './PlansPageFeatures/PlansData/PlansModelData/v1.20.2/all-pricing--2026-04-24.json';
import ModelsComparison from './ModelsComparison.astro';
import Tooltip from './Tooltip.astro';
import PlanTag from './PlanTag.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { creatorNameFor } from '../shared/lib/logos';
import { planTagKey } from '../shared/lib/planTags';
import { getProviderTooltips } from '../shared/lib/providerTooltips';
import { cloudFullNameFor, cloudLabelFor } from '../shared/lib/cloudLabelOverrides';
import { hostingUnconfirmed, isNewModel } from '../shared/lib/launchModels';
import { isRetiredModel } from '../shared/lib/retirements';
import { isHiddenModel } from '../shared/lib/hiddenModels';
import { catalogRank } from '../shared/lib/modelCatalogOrder';
import {
  CACHED_INPUT_PRICE_PERCENT,
  cachedInputPrice,
  hasCachedTokenPricing,
} from '../shared/lib/cachedTokenPricing';
import { resolvePrimaryCategory } from '../shared/lib/modelCategories';
import { EURO_SUFFIX_DE, formatDecimalText, formatInteger, keepWholeParts, type NumberLocale } from '../shared/lib/displayFormat';

interface Props {
  selectedPlanId?: string;
  sectionTitle?: string;
  modelsSectionTitle?: string;
  /** Overview: only the Essential, Professional and Agentic tiles, each with price, throughput and Premium access. */
  compact?: boolean;
}
const { selectedPlanId = '', sectionTitle = '', modelsSectionTitle = '', compact = false } = Astro.props;

// Detect locale from URL path
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const numberLocale: NumberLocale = isDE ? 'de' : 'en';

/** Monthly plan price: "€1,000" on English pages, "1.000 €" (no-break space) on German pages. */
function planPrice(amount: number): string {
  return numberLocale === 'de' ? `${formatInteger(amount, 'de')}${EURO_SUFFIX_DE}` : `€${formatInteger(amount, 'en')}`;
}

/** Token prices as written in English ("0.20 / 0.65"); German pages get decimal commas ("0,20 / 0,65"). */
function priceText(text: string): string {
  return formatDecimalText(text, numberLocale);
}

const t = {
  ratePlansTitle: isDE ? 'Tarife' : 'Our rate plans',
  subtitle: isDE
    ? 'Die Tarife unterscheiden sich im Durchsatz (TPM und RPM) und im Zugang zu Premium-Modellen. <a href="/de/reference/rate-limits/">Rate-Limits</a>.'
