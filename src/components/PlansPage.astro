  // Model table headers, as on All models: the label, the unit below it.
  thCloud: 'Cloud',
  thLocation: isDE ? 'Standort' : 'Location',
  thCachedInput: isDE ? 'Cache-Eingabe' : 'Cached input',
  thRequests: isDE ? 'Anfragen' : 'Requests',
  thTokensPerMinute: 'Tokens',
  unitPrice: isDE ? 'pro 1 Mio. Tokens' : 'per 1M tokens',
