interface Props {
  selectedPlanId?: string;
  sectionTitle?: string;
  modelsSectionTitle?: string;
  legacy?: boolean;
  /** Overview: only the Essential, Professional and Agentic tiles, each with price, throughput and Premium access. */
  compact?: boolean;
}
const { selectedPlanId = '', sectionTitle = '', modelsSectionTitle = '', legacy = false, compact = false } = Astro.props;

const allPricing = legacy ? legacyPricing : currentPricing;

// Detect locale from URL path
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
// Archived versions (/v1…/) keep their original number format.
const isArchive = /\/v1(-\d+-\d+)?\//.test(Astro.url.pathname);
const numberLocale: NumberLocale = isDE && !isArchive ? 'de' : 'en';

/** Monthly plan price: "€1,000" on English pages, "1.000 €" (no-break space) on German pages. Archived pages keep their original "1,000 €". */
function planPrice(amount: number): string {
  if (isArchive) return `${formatInteger(amount, 'en')} €`;
  return numberLocale === 'de' ? `${formatInteger(amount, 'de')}${EURO_SUFFIX_DE}` : `€${formatInteger(amount, 'en')}`;
}

/** Token prices as written in English ("0.20 / 0.65"); German pages get decimal commas ("0,20 / 0,65"). */
function priceText(text: string): string {
  return formatDecimalText(text, numberLocale);
}

