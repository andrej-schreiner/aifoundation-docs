---
import { getModelBrandIcon } from '../shared/lib/modelBrandIcons';

interface Props {
  name: string;
  size?: number;
  title?: string;
  /**
   * When the brand name is already announced next to the icon (the typical case),
   * pass `decorative=true` so the icon doesn't double-announce. The image is
   * exposed to AT as decorative (`alt=""`, `role="presentation"`).
   */
  decorative?: boolean;
}

const { name, size = 18, title = name, decorative = false } = Astro.props;
const src = getModelBrandIcon(name);
---

<img
  class="model-brand-icon"
  src={src}
  alt={decorative ? '' : name}
  role={decorative ? 'presentation' : undefined}
  aria-hidden={decorative ? 'true' : undefined}
  title={title}
  width={size}
  height={size}
  loading="lazy"
  decoding="async"
/>

<style>
  .model-brand-icon {
    display: inline-block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    vertical-align: middle;
  }
</style>