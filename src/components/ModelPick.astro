---
// Recommended models for one use case, built on the model card
// (AvailableModels): the same frame and header (logo, name, copy
// button with its success tooltip), plus the model ID as code under the
// name, smaller and muted, then the facts (context, hosting) under a
// divider, each a small muted label above its value. Tokens:
// aifs.model-card.*.
import { choiceById, picksFor } from '../shared/lib/choosingModels';
import { creatorNameFor } from '../shared/lib/logos';
import { withWrapPoints } from '../plugins/wrap-points.mjs';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Tag from './Tag.astro';

interface Props {
  useCase: string;
}

const { useCase } = Astro.props;
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';
const row = choiceById(useCase);
const picks = picksFor(useCase);

const GUIDE_TITLES: Record<string, { en: string; de: string }> = {
  '/guides/chat-completions': { en: 'Chat completions', de: 'Chat Completions' },
  '/guides/reasoning': { en: 'Reasoning', de: 'Reasoning' },
  '/guides/function-calling': { en: 'Function calling', de: 'Function Calling' },
  '/guides/multimodal': { en: 'Vision', de: 'Vision' },
  '/guides/ocr': { en: 'OCR', de: 'OCR' },
  '/guides/embeddings': { en: 'Embeddings', de: 'Embeddings' },
  '/guides/audio': { en: 'Audio', de: 'Audio' },
  '/guides/decisions': { en: 'Decisions', de: 'Decisions' },
  '/guides/image-generation': { en: 'Image generation', de: 'Bildgenerierung' },
};
const guideTitle = (isDE ? GUIDE_TITLES[row.guide]?.de : GUIDE_TITLES[row.guide]?.en) ?? (isDE ? 'Zur Anleitung' : 'Guide');

const t = isDE
  ? {
      heading: 'Empfohlen',
      preview: 'Vorschau',
      context: 'Kontext',
      hosting: 'Hosting',
      copyTitle: 'Modell-ID kopieren: {id}',
      copyAria: 'Modell-ID {id} kopieren',
      copied: 'Kopiert: {id}',
    }
  : {
      heading: 'Recommended',
      preview: 'Preview',
      context: 'Context',
      hosting: 'Hosting',
      copyTitle: 'Copy model ID: {id}',
      copyAria: 'Copy model ID {id}',
      copied: 'Copied: {id}',
    };

function notesHtml(text: string): string {
  return text
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('T-Cloud', '<span class="nowrap">T-Cloud</span>');
}

function place(hosting: string): string {
  if (!isDE) return hosting;
  return hosting
    .replaceAll('T-Cloud Germany', 'T-Cloud Deutschland')
    .replaceAll('Azure Sweden Central', 'Azure Schweden Mitte')
    .replaceAll('Azure France Central', 'Azure Frankreich Mitte')
    .replaceAll('Azure (worldwide)', 'Azure (Weltweit)')
    .replaceAll('GCP (worldwide)', 'GCP (Weltweit)');
}
---

<section class="model-pick not-content">
  <h2>{t.heading}</h2>
  <span class="model-pick__status" role="status" aria-live="polite" aria-atomic="true"></span>
  <ul class="model-pick__list">
    {picks.map((model) => {
      const creator = creatorNameFor(model.id, model.name);
      const copied = t.copied.replace('{id}', model.id);
      return (
        <li class="model-pick__card">
          <div class="model-pick__head">
            <Logo name={creator} size="large" />
            <div class="model-pick__title">
              <h3 class="model-pick__name">
                {model.name}
                {model.preview && <Tag size="small">{t.preview}</Tag>}
              </h3>
              <code class="model-pick__id" set:html={withWrapPoints(model.id)} />
            </div>
            <Button
              variant="ghost"
              size="small"
              iconOnly
              class="model-pick__copy"
              data-model-id={model.id}
              data-copied-label={copied}
              title={t.copyTitle.replace('{id}', model.id)}
              ariaLabel={t.copyAria.replace('{id}', model.id)}
              successTooltip={copied}
              tooltipPlacement="top-end">
              <Icon name="action-copy-paste" size={16} />
              <Icon slot="success" name="action-checkmark" size={16} />
            </Button>
          </div>
          <dl class="model-pick__facts">
            {model.context && (
              <div class="model-pick__fact">
                <dt>{t.context}</dt>
                <dd>{model.context}</dd>
              </div>
            )}
            <div class="model-pick__fact">
              <dt>{t.hosting}</dt>
              <dd>
                <Tag size="small" color={model.hosting.startsWith('T-Cloud') ? 'magenta' : 'standard'} href={`${prefix}/reference/enterprise-trust`}>
                  {place(model.hosting)}
                </Tag>
              </dd>
            </div>
          </dl>
        </li>
      );
    })}
  </ul>
  <p class="model-pick__notes" set:html={notesHtml(isDE ? row.notes.de : row.notes.en)} />
  <p class="model-pick__guide"><a href={`${prefix}${row.guide}`}>{guideTitle}</a></p>
</section>

<style>
  /* The grid follows its own width, as the model cards do: two columns from
     34rem, three from 52rem. Container queries cannot read custom
     properties, so these are rem, not tokens. */
  .model-pick {
    container-type: inline-size;
  }

  /* A section heading: the section gap above comes from layout.css. */
  .model-pick h2 {
    margin: 0 0 var(--aifs-rhythm-after-heading);
  }

  .model-pick__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .model-pick__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--aifs-model-card-grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 34rem) {
    .model-pick__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 52rem) {
    .model-pick__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* The model card's frame; it only informs, so it has no hover. A size
     container, so the copy tooltip stays inside the card. Each card spans
     two rows of the list (subgrid): the headers of a row of cards share
     one height, so their facts start on one line, and the cards are as
     tall as the tallest. */
  .model-pick__card {
    container-type: inline-size;
    --aifs-tooltip-inset: var(--aifs-model-card-padding);
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: var(--aifs-model-card-gap);
    margin: 0;
    padding: var(--aifs-model-card-padding);
    border: var(--aifs-model-card-border-width) solid var(--aifs-model-card-border);
    border-radius: var(--aifs-model-card-radius);
    background: var(--aifs-model-card-background);
    color: var(--aifs-model-card-value);
  }

  /* First the name, then the model ID under it, smaller and muted. */
  .model-pick__head {
    display: flex;
    align-items: flex-start;
    gap: var(--aifs-model-card-logo-gap);
  }

  .model-pick__title {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--aifs-model-card-stack-gap);
  }

  .model-pick__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--aifs-model-card-row-gap);
    margin: 0;
    font-size: var(--aifs-model-card-name-font-size);
    font-weight: var(--aifs-model-card-name-font-weight);
    line-height: 1.25;
    color: var(--aifs-model-card-value);
  }

  /* Wraps only at its wrap points (after - . / _), never inside a word.
     Without the inline-code frame of the Markdown content, so it stays
     secondary to the name. */
  .model-pick .model-pick__id {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
    color: var(--aifs-model-card-label);
  }

  .model-pick :global(.model-pick__copy) {
    flex: none;
  }

  /* The facts under a divider, side by side while they fit: each a small
     muted label above its value. */
  .model-pick__facts {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--aifs-model-card-row-gap) var(--aifs-model-card-gap);
    margin: 0;
    padding-top: var(--aifs-model-card-gap);
    border-top: var(--aifs-model-card-border-width) solid var(--aifs-layout-divider);
  }

  .model-pick__fact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--aifs-model-card-stack-gap);
    margin: 0;
  }

  .model-pick__fact dt {
    margin: 0;
    font-size: var(--aifs-text-small-font-size);
    line-height: var(--aifs-text-small-line-height);
    color: var(--aifs-model-card-label);
    font-weight: normal;
    white-space: nowrap;
  }

  .model-pick__fact dd {
    margin: 0;
    padding: 0;
    font-weight: var(--aifs-model-card-value-font-weight);
  }

  .model-pick__notes {
    margin: var(--aifs-model-card-gap) 0 0;
  }

  .model-pick__guide {
    margin: var(--aifs-model-card-row-gap) 0 0;
  }
</style>

<script>
  // Copy the model ID. Button's success state swaps in the tick and shows
  // the tooltip for 1500ms; the section's live region announces it.
  function setupModelPick() {
    document.querySelectorAll<HTMLButtonElement>('.model-pick__copy').forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = '1';
      const status = btn.closest('.model-pick')?.querySelector('.model-pick__status');
      btn.addEventListener('click', async () => {
        const id = btn.dataset.modelId;
        if (!id) return;
        try {
          await navigator.clipboard.writeText(id);
        } catch {
          return;
        }
        const label = btn.getAttribute('aria-label') ?? '';
        const copied = btn.dataset.copiedLabel ?? id;
        btn.dataset.state = 'success';
        btn.setAttribute('aria-label', copied);
        if (status) status.textContent = copied;
        setTimeout(() => {
          delete btn.dataset.state;
          btn.setAttribute('aria-label', label);
          if (status) status.textContent = '';
        }, 1500);
      });
    });
  }

  setupModelPick();
  document.addEventListener('astro:after-swap', setupModelPick);
</script>
