---
import { choiceById, modelFact, picksFor } from '../shared/lib/choosingModels';
import { creatorNameFor, getLogo } from '../shared/lib/logos';

interface Props {
  useCase: string;
}

const { useCase } = Astro.props;
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const prefix = isDE ? '/de' : '';
const row = choiceById(useCase);
const picks = picksFor(useCase);

const GUIDE_TITLES: Record<string, { en: string; de: string }> = {
  '/guides/chat-completions': { en: 'Chat completions', de: 'Chat Completions' },
  '/guides/reasoning': { en: 'Reasoning', de: 'Reasoning' },
  '/guides/function-calling': { en: 'Function calling', de: 'Function Calling' },
  '/guides/multimodal': { en: 'Image input', de: 'Bildeingabe' },
  '/guides/ocr': { en: 'OCR', de: 'OCR' },
  '/guides/embeddings': { en: 'Embeddings', de: 'Embeddings' },
  '/guides/audio': { en: 'Audio', de: 'Audio' },
  '/guides/decisions': { en: 'Decisions', de: 'Decisions' },
  '/guides/image-generation': { en: 'Image generation', de: 'Bildgenerierung' },
};
const guideTitle = (isDE ? GUIDE_TITLES[row.guide]?.de : GUIDE_TITLES[row.guide]?.en) ?? (isDE ? 'Zur Anleitung' : 'Guide');

const t = isDE
  ? {
      heading: 'Empfohlen',
      preview: 'Vorschau',
      unpublished: 'Kontext nicht angegeben',
    }
  : {
      heading: 'Recommended',
      preview: 'Preview',
      unpublished: 'Context not published',
    };

function notesHtml(text: string): string {
  return text
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('T-Cloud', '<span class="nowrap">T-Cloud</span>');
}

function place(hosting: string): string {
  if (!isDE) return hosting;
  return hosting
    .replaceAll('T-Cloud Germany', 'T-Cloud Deutschland')
    .replaceAll('Azure Sweden Central', 'Azure Schweden Mitte')
    .replaceAll('Azure France Central', 'Azure Frankreich Mitte')
    .replaceAll('Azure (worldwide)', 'Azure (Weltweit)')
    .replaceAll('GCP (worldwide)', 'GCP (Weltweit)');
}
---

<section class="model-pick not-content">
  <h2>{t.heading}</h2>
  <ul class="model-pick__list">
    {picks.map((model) => {
      const creator = creatorNameFor(model.id, model.name);
      const logo = getLogo(creator) || getLogo('Other');
      const zoom = creator.startsWith('Google');
      return (
        <li class="model-pick__card">
          <div class="model-pick__head">
            <span class:list={['model-pick__mark', { 'model-pick__mark--zoom': zoom }]}>
              <img src={logo} alt="" width="20" height="20" />
            </span>
            <strong>{model.name}</strong>
            {model.preview && <span class="aifs-tag aifs-tag--small">{t.preview}</span>}
          </div>
          <p class="model-pick__meta">
            <code>{model.id}</code>
            <a class="aifs-tag aifs-tag--small" href={`${prefix}/reference/enterprise-trust`}>{place(model.hosting)}</a>
            <span>{model.context || t.unpublished}</span>
          </p>
        </li>
      );
    })}
  </ul>
  <p class="model-pick__notes" set:html={notesHtml(isDE ? row.notes.de : row.notes.en)} />
  <p class="model-pick__guide"><a href={`${prefix}${row.guide}`}>{guideTitle}</a></p>
</section>

<style>
  .model-pick h2 {
    margin: 0 0 8px;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .model-pick__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .model-pick__card {
    background: var(--aifs-color-surface-chrome);
    color: var(--aifs-color-text-body);
    border: 1px solid var(--aifs-color-border-subtle);
    border-radius: var(--aifs-table-radius, 8px);
    padding: 10px 12px;
  }

  .model-pick__head {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .model-pick__head strong {
    min-width: 0;
    line-height: 1.3;
  }

  .model-pick__mark {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2px;
    border: 1px solid var(--aifs-color-border-subtle);
    border-radius: 4px;
    background: var(--aifs-color-logo-background, #fff);
  }

  .model-pick__mark--zoom {
    padding: 2px;
    overflow: visible;
  }

  .model-pick__mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .model-pick__mark--zoom img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .model-pick__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 6px 0 0;
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .model-pick__meta code {
    white-space: nowrap;
  }

  .model-pick__meta :global(a.aifs-tag) {
    text-decoration: none;
  }

  .model-pick__notes {
    margin: 8px 0 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .model-pick__guide {
    margin: 8px 0 0;
  }
</style>
