---
// Floating, dismissible site-wide announcement for the GLM 5.2 preview model.
// Rendered from Footer.astro so it appears on every page (there are no splash
// pages, so the Footer override is truly global).
//
// Dismiss semantics (intentional): this site navigates via full page loads
// (no view transitions), so the closed state is kept in sessionStorage — that
// survives navigation between docs pages, keeping the banner closed while the
// visitor browses. On a hard reload we clear it (detected via the
// PerformanceNavigationTiming "reload" type), so the banner reappears on a
// refresh. A new tab starts a fresh session and shows it again.

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

// Access-request form for prospective / non-paying customers.
const GET_ACCESS_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSdBDhCijYUIUeyJVTLzCy0rm55XgD2nG5supwtGRHXVfaX-fw/viewform';

const t = isDE
  ? {
      region: 'Produktankündigung',
      tag: 'Neu',
      title: 'GLM 5.2 ist jetzt verfügbar',
      body: 'Testen Sie GLM 5.2 im Preview-Modus — für kurze Zeit in jedem Tarif kostenlos enthalten.',
      ctaLead: 'Möchten Sie es kostenlos testen?',
      ctaLink: 'Hier Zugang anfordern',
      close: 'Ankündigung schließen',
    }
  : {
      region: 'Product announcement',
      tag: 'New',
      title: 'GLM 5.2 is now available',
      body: 'Try GLM 5.2 in preview mode — included free with every plan for a short time.',
      ctaLead: 'Want to test it for free?',
      ctaLink: 'Request access here',
      close: 'Dismiss announcement',
    };
---

<aside id="glm-banner" class="glm-banner" aria-label={t.region} hidden>
  <button type="button" class="glm-banner__close" aria-label={t.close}>
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
      <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  </button>
  <p class="glm-banner__tag">{t.tag}</p>
  <p class="glm-banner__title">{t.title}</p>
  <p class="glm-banner__body">{t.body}</p>
  <p class="glm-banner__cta">
    {t.ctaLead}{' '}
    <a
      class="glm-banner__link"
      href={GET_ACCESS_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t.ctaLink} ${isDE ? '(öffnet in neuem Tab)' : '(opens in new tab)'}`}
    >{t.ctaLink}</a>
  </p>
</aside>

<style>
  .glm-banner[hidden] {
    display: none;
  }

  .glm-banner {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 100;
    width: min(24rem, calc(100vw - 2rem));
    padding: 1.05rem 1.2rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-left: 4px solid #e20074;
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav, var(--sl-color-bg));
    color: var(--sl-color-text);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .glm-banner.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .glm-banner__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .glm-banner__close:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .glm-banner__close:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .glm-banner__tag {
    display: inline-block;
    margin: 0 0 0.45rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: #e20074;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .glm-banner__title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .glm-banner__body {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }

  .glm-banner__cta {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .glm-banner__link {
    color: var(--sl-color-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .glm-banner__link:hover,
  .glm-banner__link:focus-visible {
    text-decoration: underline;
  }

  @media (max-width: 30rem) {
    .glm-banner {
      right: 0.75rem;
      left: 0.75rem;
      bottom: 0.75rem;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glm-banner {
      transition: none;
    }
  }
</style>

<script>
  // See the component frontmatter for the dismiss-semantics rationale.
  const GLM_KEY = 'glmBannerDismissed';
  let reloadHandled = false;

  function isGlmDismissed() {
    try {
      return sessionStorage.getItem(GLM_KEY) === '1';
    } catch {
      return false;
    }
  }

  // Clear the dismissal on a hard reload so the banner returns on refresh.
  // Guarded to run once per real document load (stays correct if view
  // transitions are ever enabled and this module persists across navigations).
  function glmClearOnReload() {
    if (reloadHandled) return;
    reloadHandled = true;
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const isReload = nav ? nav.type === 'reload' : (performance as any).navigation?.type === 1;
    if (isReload) {
      try {
        sessionStorage.removeItem(GLM_KEY);
      } catch {}
    }
  }

  function dismissGlmBanner() {
    try {
      sessionStorage.setItem(GLM_KEY, '1');
    } catch {}
    const banner = document.getElementById('glm-banner');
    if (!banner) return;
    banner.classList.remove('is-visible');
    // Remove after the exit transition so it can't be tabbed to meanwhile.
    window.setTimeout(() => banner.remove(), 250);
  }

  function initGlmBanner() {
    glmClearOnReload();
    const banner = document.getElementById('glm-banner');
    if (!banner) return;

    // Dismissed earlier in this browsing session → never show it.
    if (isGlmDismissed()) {
      banner.remove();
      return;
    }

    // Reveal (start-hidden → reveal avoids a flash-then-hide during navigation).
    banner.hidden = false;
    requestAnimationFrame(() => banner.classList.add('is-visible'));

    const closeBtn = banner.querySelector<HTMLButtonElement>('.glm-banner__close');
    closeBtn?.addEventListener('click', dismissGlmBanner);

    // Bind Escape once globally (init re-runs per navigation, so guard it).
    if (!(window as any).__glmBannerEscBound) {
      (window as any).__glmBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || isGlmDismissed()) return;
        const el = document.getElementById('glm-banner');
        if (el && !el.hidden) dismissGlmBanner();
      });
    }
  }

  // Runs on load (astro:page-load also fires for view transitions if enabled).
  document.addEventListener('astro:page-load', initGlmBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlmBanner);
  } else {
    initGlmBanner();
  }
</script>
