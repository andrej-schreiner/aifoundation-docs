---
// Site-wide announcement modal for the GLM-5.2 preview model (banner_4 design).
// Rendered from Footer.astro so it appears on every page (there are no splash
// pages, so the Footer override is truly global).
//
// Dismiss semantics (intentional): this site navigates via full page loads
// (no view transitions), so the closed state is kept in sessionStorage — that
// survives navigation between docs pages, keeping the banner closed while the
// visitor browses. On a hard reload we clear it (detected via the
// PerformanceNavigationTiming "reload" type), so the banner reappears on a
// refresh. A new tab starts a fresh session and shows it again.

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

// Access-request form for prospective / non-paying customers.
const GET_ACCESS_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSdBDhCijYUIUeyJVTLzCy0rm55XgD2nG5supwtGRHXVfaX-fw/viewform';

const t = isDE
  ? {
      eyebrow: 'Jetzt verfügbar · AIFS',
      title: 'GLM‑5.2',
      sub: 'GLM‑5.2 im Preview‑Modus testen — für kurze Zeit <b>kostenlos</b> in jedem Plan enthalten.',
      prompt: 'Kostenlos testen?',
      cta: 'Zugang anfragen',
      chip: 'Souveräne <span class="k">EU‑Infrastruktur</span>',
      footer: 'OpenAI‑kompatibel &nbsp;·&nbsp; 🇩🇪 Gehostet in München',
      close: 'Ankündigung schließen',
    }
  : {
      eyebrow: 'Now serving · AIFS',
      title: 'GLM‑5.2',
      sub: 'Try GLM‑5.2 in preview mode — <b>included free</b> with every plan for a short time.',
      prompt: 'Want to test it for free?',
      cta: 'Request access here',
      chip: 'Sovereign EU <span class="k">Infrastructure</span>',
      footer: 'OpenAI‑compatible &nbsp;·&nbsp; 🇩🇪 Hosted in Munich',
      close: 'Dismiss announcement',
    };
---

<div class="glm-overlay" id="glm-overlay" role="region" aria-labelledby="glm-ttl" hidden>
  <div class="glm-banner" id="glm-banner">
    <button type="button" class="glm-close" id="glm-close" aria-label={t.close}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="glm-experts" id="glm-experts" aria-hidden="true"></div>

    <div class="glm-body">
      <span class="glm-eyebrow"><span class="glm-dot"></span>{t.eyebrow}</span>
      <h1 class="glm-title" id="glm-ttl" set:html={t.title}></h1>
      <p class="glm-sub" set:html={t.sub}></p>

      <div class="glm-chips">
        <span class="glm-chip">1M <span class="k">context</span></span>
        <span class="glm-chip">Blackwell <span class="k">B200</span></span>
        <span class="glm-chip" set:html={t.chip}></span>
      </div>

      <div class="glm-actions">
        <span class="glm-prompt">{t.prompt}</span>
        <a class="glm-cta" href={GET_ACCESS_URL} target="_blank" rel="noopener noreferrer">{t.cta}</a>
      </div>

      <div class="glm-footnote" set:html={t.footer}></div>
    </div>
  </div>
</div>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap");

  .glm-overlay {
    --surface: #17102a;
    --surface-2: #20163b;
    --magenta: #ff2d9b;
    --magenta-soft: #ff6fbe;
    --cyan: #38e8f2;
    --gtext: #f6f1ff;
    --gmuted: #a99cc4;
    --gline: rgba(255, 255, 255, 0.09);
    --gdisplay: "Space Grotesk", system-ui, sans-serif;
    --gbody: "Inter", system-ui, sans-serif;
    --gmono: "IBM Plex Mono", ui-monospace, monospace;
  }

  .glm-overlay[hidden] {
    display: none;
  }

  .glm-overlay * {
    box-sizing: border-box;
  }

  /* ---------- corner toast + card ---------- */
  .glm-overlay {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 1000;
    /* no backdrop — this is a corner toast, not a full-screen modal */
    /* scaled down slightly, anchored to the corner it sits in */
    transform: scale(0.85);
    transform-origin: bottom right;
  }
  .glm-overlay.closing {
    animation: glmFadeOut 0.22s ease forwards;
  }

  .glm-banner {
    position: relative;
    width: min(25rem, calc(100vw - 3rem));
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--gline);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.8);
    transform: scale(0.9) translateY(14px);
    opacity: 0;
    animation: glmPop 0.46s cubic-bezier(0.2, 0.9, 0.25, 1.25) 0.08s forwards;
    color: var(--gtext);
    font-family: var(--gbody);
  }
  /* the glow that pulses — the "pulse-glow" signature */
  .glm-banner::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 22px;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 45, 155, 0.35);
    animation: glmPulseGlow 3.2s ease-in-out infinite;
  }

  .glm-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 5;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--gtext);
    cursor: pointer;
    transition: 0.18s;
  }
  .glm-close:hover {
    background: rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.5);
  }
  .glm-close svg {
    width: 14px;
    height: 14px;
  }

  /* ---------- signature: sparse MoE expert grid ---------- */
  .glm-experts {
    position: relative;
    height: 30px;
    display: grid;
    gap: 5px;
    padding: 16px 20px 2px;
    grid-template-columns: repeat(16, 1fr);
    grid-template-rows: repeat(4, 1fr);
    -webkit-mask-image: radial-gradient(140% 130% at 50% 0%, #000 40%, transparent 92%);
    mask-image: radial-gradient(140% 130% at 50% 0%, #000 40%, transparent 92%);
  }
  .glm-cell {
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.045);
    transition: background 0.5s, box-shadow 0.5s;
  }
  .glm-cell.on {
    background: var(--magenta);
    box-shadow: 0 0 10px 1px rgba(255, 45, 155, 0.7);
    animation: glmTwinkle 2.6s ease-in-out infinite;
  }
  .glm-cell.on.alt {
    background: var(--cyan);
    box-shadow: 0 0 10px 1px rgba(56, 232, 242, 0.65);
  }

  /* ---------- content ---------- */
  .glm-body {
    position: relative;
    padding: 4px 22px 18px;
    text-align: left;
  }

  .glm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--gmono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--magenta-soft);
    text-transform: uppercase;
    margin-bottom: 9px;
  }
  .glm-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--magenta);
    box-shadow: 0 0 0 rgba(255, 45, 155, 0.7);
    animation: glmLive 1.8s ease-out infinite;
  }

  .glm-title {
    font-family: var(--gdisplay);
    font-weight: 700;
    font-size: 38px;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
    background: linear-gradient(100deg, #fff 20%, var(--magenta-soft) 60%, var(--cyan) 105%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .glm-sub {
    color: var(--gmuted);
    font-size: 13px;
    line-height: 1.45;
    margin: 0 0 12px;
    max-width: none;
  }
  .glm-sub b {
    color: var(--gtext);
    font-weight: 600;
  }

  .glm-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .glm-chip {
    font-family: var(--gmono);
    font-size: 11px;
    font-weight: 500;
    padding: 4px 9px;
    border-radius: 6px;
    color: var(--gtext);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--gline);
    white-space: nowrap;
  }
  .glm-chip .k {
    color: var(--cyan);
  }

  .glm-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .glm-prompt {
    font-family: var(--gbody);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--gmuted);
  }
  .glm-cta {
    position: relative;
    overflow: hidden;
    font-family: var(--gbody);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 10px;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    color: #1a0512;
    background: linear-gradient(100deg, var(--magenta), var(--magenta-soft));
    box-shadow: 0 12px 30px -10px rgba(255, 45, 155, 0.6);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .glm-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 36px -10px rgba(255, 45, 155, 0.75);
  }
  .glm-cta::before {
    /* shimmer sweep */
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-18deg);
    transition: left 0.55s ease;
  }
  .glm-cta:hover::before {
    left: 150%;
  }

  .glm-footnote {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--gline);
    font-family: var(--gmono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--gmuted);
    text-align: center;
  }

  .glm-overlay :focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
    border-radius: 6px;
  }

  @media (max-width: 30rem) {
    .glm-overlay {
      right: 0.75rem;
      left: 0.75rem;
      bottom: 0.75rem;
      transform: none;
    }
    .glm-banner {
      width: auto;
    }
    .glm-title {
      font-size: 34px;
    }
    .glm-experts {
      height: 28px;
    }
    .glm-body {
      padding: 4px 18px 16px;
    }
  }

  /* ---------- motion ---------- */
  @keyframes glmFadeIn {
    to {
      opacity: 1;
    }
  }
  @keyframes glmFadeOut {
    to {
      opacity: 0;
    }
  }
  @keyframes glmPop {
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }
  @keyframes glmPulseGlow {
    0%,
    100% {
      box-shadow: inset 0 0 0 1px rgba(255, 45, 155, 0.25), 0 0 22px -8px rgba(255, 45, 155, 0.4);
    }
    50% {
      box-shadow: inset 0 0 0 1px rgba(255, 45, 155, 0.6), 0 0 46px -6px rgba(255, 45, 155, 0.75);
    }
  }
  @keyframes glmLive {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 45, 155, 0.7);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px rgba(255, 45, 155, 0);
    }
  }
  @keyframes glmTwinkle {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glm-overlay *,
    .glm-overlay {
      animation: none !important;
      transition: none !important;
    }
    .glm-banner {
      transform: none;
      opacity: 1;
    }
    .glm-overlay {
      opacity: 1;
    }
  }
</style>

<script>
  // See the component frontmatter for the dismiss-semantics rationale.
  const GLM_KEY = 'glmBannerDismissed';
  let reloadHandled = false;

  const reduceMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function isGlmDismissed() {
    try {
      return sessionStorage.getItem(GLM_KEY) === '1';
    } catch {
      return false;
    }
  }

  // Clear the dismissal on a hard reload so the banner returns on refresh.
  // Guarded to run once per real document load (stays correct if view
  // transitions are ever enabled and this module persists across navigations).
  function glmClearOnReload() {
    if (reloadHandled) return;
    reloadHandled = true;
    const nav = performance.getEntriesByType('navigation')[0] as
      | PerformanceNavigationTiming
      | undefined;
    const isReload = nav ? nav.type === 'reload' : (performance as any).navigation?.type === 1;
    if (isReload) {
      try {
        sessionStorage.removeItem(GLM_KEY);
      } catch {}
    }
  }

  // Light a sparse subset (~16%) of the expert grid, a few in cyan.
  function buildExpertGrid(grid: HTMLElement) {
    const COLS = 16,
      ROWS = 4,
      N = COLS * ROWS;
    for (let i = 0; i < N; i++) {
      grid.appendChild(document.createElement('span')).className = 'glm-cell';
    }
    const cells = [...grid.children] as HTMLElement[];

    function route() {
      cells.forEach((c) => (c.className = 'glm-cell'));
      const active = Math.round(N * 0.16);
      const idx = new Set<number>();
      while (idx.size < active) idx.add(Math.floor(Math.random() * N));
      [...idx].forEach((k, j) => {
        cells[k].className = 'glm-cell on' + (j % 4 === 0 ? ' alt' : '');
        cells[k].style.animationDelay = (Math.random() * 2.2).toFixed(2) + 's';
      });
    }
    route();
    if (!reduceMotion()) return window.setInterval(route, 2600); // routing drifts
    return null;
  }

  function dismissGlmBanner() {
    try {
      sessionStorage.setItem(GLM_KEY, '1');
    } catch {}
    const overlay = document.getElementById('glm-overlay');
    if (!overlay) return;
    if (reduceMotion()) {
      overlay.remove();
      return;
    }
    overlay.classList.add('closing');
    overlay.addEventListener('animationend', () => overlay.remove(), { once: true });
  }

  function initGlmBanner() {
    glmClearOnReload();
    const overlay = document.getElementById('glm-overlay');
    if (!overlay) return;

    // Dismissed earlier in this browsing session → never show it.
    if (isGlmDismissed()) {
      overlay.remove();
      return;
    }

    const grid = document.getElementById('glm-experts');
    if (grid && !grid.dataset.built) {
      grid.dataset.built = '1';
      buildExpertGrid(grid);
    }

    // Reveal (start-hidden → reveal avoids a flash-then-hide during navigation).
    overlay.hidden = false;

    const closeBtn = overlay.querySelector<HTMLButtonElement>('.glm-close');
    closeBtn?.addEventListener('click', dismissGlmBanner);

    // Bind Escape once globally (init re-runs per navigation, so guard it).
    if (!(window as any).__glmBannerEscBound) {
      (window as any).__glmBannerEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || isGlmDismissed()) return;
        const el = document.getElementById('glm-overlay');
        if (el && !el.hidden) dismissGlmBanner();
      });
    }
  }

  // Runs on load (astro:page-load also fires for view transitions if enabled).
  document.addEventListener('astro:page-load', initGlmBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlmBanner);
  } else {
    initGlmBanner();
  }
</script>
